'*********************************************************************/
'Author: Youness AADISSA
'Description:
'Input : check sur les demandes en cours au cours d'un changement de titulaire en masse
'Output : Boolean
'Update:
'*********************************************************************/
Function checkChangementTituEnCours( bdssource As String) As Boolean
On  Error GoTo Error_Handling

    Dim listdemande As New list
    Dim toDB        As New SQLDB
    Dim strSQLStatement As String
    Dim whichBtn        As Integer

    listdemande.ItemType = "String"

    strSQLStatement = " SELECT objid" & _
                      " FROM table_contr_itm" & _
                      " WHERE objid = " & bdssource & _
                      " AND (EXISTS (" & _
                      "     SELECT objid" & _
                      "     FROM table_x_av_suivi_chmt_cf chmt" & _
                      "     WHERE chmt.x_av_focus_id = table_contr_itm.objid" & _
                      "       AND chmt.x_av_status = 'A traiter'" & _
                      "       AND chmt.x_av_type IN ('Changement Payeur', 'Changement Titulaire'))" & _
                      "  OR EXISTS(" & _
                      "     SELECT itm.objid" & _
                      "     FROM table_contr_itm itm," & _
                      "          table_x_av_suivi_chmt_cf chmt" & _
                      "     WHERE chmt.x_av_focus_id = itm.objid" & _
                      "       AND itm.child2contr_itm = table_contr_itm.objid" & _
                      "       AND chmt.x_av_status = 'A traiter'" & _
                      "       AND chmt.x_av_type IN ('Changement Payeur', 'Changement Titulaire'))" & _
                      "     )"

    toDB.Select strSQLStatement, listdemande

    If listdemande.Count > 0 Then
        checkChangementTituEnCours = True
    Else
        checkChangementTituEnCours = False
    End If
    Set toDB = Nothing
    Set listdemande = Nothing
    strSQLStatement = ebnullstring
Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
end function
'*********************************************************************/
'Author: Youness AADISSA
'Description:
'Input : V�rifier qu'il n'existe pas de commande Price de type CPTA , RESUS, OFSU ,COPT , REMB ou FACT
'Output : Boolean
'Update: Imane AAJAIL
'*********************************************************************/
Function checkADGEnCours(ideds As String) As Boolean
On  Error GoTo Error_Handling
    Dim listBDSADG  As New List
    Dim strSqlStatement As string
    Dim toDB            As New SQLDB
    Dim br              As New Bulkretrieve
    Dim lstTmp          As New List
    Dim strAdgNonCum    As String

    listBDSADG.ItemType = "String"

    br.Clear
    br.SimpleQuery 0, "x_av_code"
    br.AppendFilter 0, "x_av_type", Cbequal, "ADG_NON_CUMULABLE_ADMIN"
    br.RetrieveRecords
   Set lstTmp = br.GetRecordlist (0)
   strAdgNonCum = ListCodeToString (lstTmp, "x_av_code", "'")

    strSqlStatement = " SELECT cmde.x_pr_id_commande" & _
                      " FROM table_x_pr_ligne_commande ligne," & _
                      " table_x_pr_commande cmde" & _
                      " WHERE ligne.x_pr_id_ligne = '" & ideds & "'" & _
                      " AND cmde.objid=ligne.x_pr_ligne2commande"&_
                      " AND ligne.x_pr_status in ('TO','TEC','AO','AEC','TOK') " &_
                      " AND cmde.x_pr_adg in ( " & strAdgNonCum & " )" & _
                      " AND cmde.x_pr_date_effet > SYSDATE"

    toDB.Select strSQLStatement, listBDSADG


    If listBDSADG.Count > 0 Then
        checkADGEnCours = True
        TRUELOG "il existe une commande Price de type CPTA , RESUS, OFSU ,COPT , REMB ou FACT"
    Else
        checkADGEnCours = False
        TRUELOG "il n'existe pas de commande Price de type CPTA , RESUS, OFSU ,COPT , REMB ou FACT"
    End If
    Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function
'*********************************************************************/
'Author: Youness AADISSA
'Description:
'Input : ?    Si le site de facturation du lot cible a un terme diff�rent de celui de l�ancien site de facturation
'Output : Boolean
'Update:
'*********************************************************************/
Function chkTerme(IdLotSource As String,IdLotCible As String) As Boolean
On Error GoTo Error_Handling
    Dim br              As New bulkRetrieve
    Dim rec             As New Record
    Dim lst             As New List
    Dim TermeSiteSrc    As String
    Dim TermeSiteCible  As String

    br.SimpleQuery 0, "contr_schedule"
    br.AppendFilter 0, "objid", Cbequal, IdLotSource
    br.TraverseFromParent 1, "bill_to2site", 0
    br.RetrieveRecords

    Set lst = br.GetRecordList(1)
    Set rec = lst.ItemByIndex(0)
    TermeSiteSrc = rec.GetField("x_av_terme")

    br.Clear
    br.SimpleQuery 0, "contr_schedule"
    br.AppendFilter 0, "objid", Cbequal, IdLotCible
    br.TraverseFromParent 1, "bill_to2site", 0
    br.RetrieveRecords

    Set lst = br.GetRecordList(1)
    Set rec = lst.ItemByIndex(0)
    TermeSiteCible = rec.GetField("x_av_terme")

    If TermeSiteCible = TermeSiteSrc Then
        chkTerme = True
    Else
        chkTerme = False
        strmessage = "Le nouveau CF n'a pas la m�me valeur du champ � Terme � que le CF d'origine"
    End If
    Set br  = Nothing
    Set rec = Nothing
    Set lst = Nothing
Exit Function
Error_Handling:
    TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function
'*********************************************************************/
'Author: Youness AADISSA
'Date :
'Description: Convertir une liste en string s�par�es par "Separateur"
'*********************************************************************/
Function ListCodeToString1(LstTmp As List, Separateur As String) As String
On Error GoTo Error_Handling
    Dim recTmp As String
    Dim StrChaine As String
    Dim i As Integer
    For i = 0 To LstTmp.Count - 1
        recTmp = LstTmp.itembyindex(i)
        If i = 0 Then
            StrChaine = Separateur & recTmp & Separateur
        Else
            StrChaine = StrChaine & ", " & recTmp & Separateur
        End If
    Next i
    ListCodeToString1 = StrChaine
    Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function
'*********************************************************************/
'Author: Youness AADISSA
'Date :
'Description: Controles sur le site de facturation et d'installation du lot cible
'*********************************************************************/
Function chkCF(IdLotSource As String,IdLotCible As String,IdContratCible As String) As Boolean
On Error GoTo Error_Handling
    Dim br          As New BulkRetrieve
    Dim recCFCible  As New Record
    Dim recContrat  As New Record
    Dim recCUCible  As New Record
    Dim lstTmp      As New List
    Dim lstParameters   As New List
    Dim toDB            As New SQLDB

    br.Clear
    br.SimpleQuery  0, "contract"
    br.AppendFilter 0, "id", cbEqual, IdContratCible
    br.SimpleQuery  1, "contr_schedule"
    br.AppendFilter 1, "objid", cbEqual, IdLotCible
    br.TraverseFromParent 2, "bill_to2site", 1
    br.TraverseFromParent 3, "ship_to2site", 1
    br.RetrieveRecords

    Set lstTmp     = br.GetRecordList(0)
    Set recContrat = lstTmp.ItemByIndex(0)
    Set lstTmp = br.GetRecordList(2)
    If lstTmp.Count <> 1 Then
        strmessage = "Probl�me lors de la r�cup�ration du CF"
        chkCF = False
        GoTo Clrobject
    End If
    Set recCFCible = lstTmp.ItemByIndex(0)
    Set lstTmp = br.GetRecordList(3)
    If lstTmp.Count <> 1 Then
        strmessage = "Probl�me lors de la r�cup�ration du CU"
        chkCF = False
        GoTo Clrobject
    End If
    Set recCUCible = lstTmp.ItemByIndex(0)
    lstParameters.Clear
    lstParameters.ItemType = "variant"
    lstParameters.AppendItem recCFCible.GetField("objid"), recCUCible.GetField("objid"), recContrat.GetField("objid")
    toDB.ExecuteProc "SA.VERIF_CF", lstParameters, typResponse
    If typResponse.response <> "" Then
        strmessage = typResponse.response
        chkCF = False
        GoTo Clrobject
    End If

    If Not chkTerme(IdLotSource,IdLotCible) Then
        chkCF = False
        GoTo Clrobject
    End If

    chkCF = True
Clrobject :
    Set br          = Nothing
    Set recCFCible  = Nothing
    Set recContrat  = Nothing
    Set recCUCible  = Nothing
    Set lstTmp      = Nothing
    Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function
'*********************************************************************/
'Author: Youness AADISSA
'Date :
'Description:     R�cup�ration de lignes du lot source sur lesquelles un changement de titulaire sera r�alis�
'Update : Imane,AAJAIL 17/08/2011
'*********************************************************************/
Function traitementDde(ObjidLotSource As String, ObjidLotCible As String, ObjidLigne As String, SdateEffet As String) As Boolean
On Error GoTo Error_Handling
    Dim lstBDS          As New List
    Dim toDB            As New SQLDB
    Dim strSQLStatement As String
    Dim strSQLCible     As String
    Dim br              As New Bulkretrieve
    Dim lstTmp          As New List
    Dim lstTmp2         As New List
    Dim i               As Integer
    Dim strCoffreDefaut As String
    Dim strActe1        As String
    Dim strStatutAct1   As String
    Dim strStatutFact1  As String
    Dim strActe2        As String
    Dim strStatutAct2   As String
    Dim strStatutFact2  As String
    Dim IdBDSSource     As String
    Dim IdEDSSource     As String
    Dim IdEDSSourceMig  As String
    Dim IdSiteCible     As String
    Dim strCrossRef     AS String
    Dim TypeBDSSource   As String
	Dim strActe2Csim    As String
	Dim strcodEtat2Csim As String


    traitementDde = False

    br.Clear
    br.SimpleQuery 0, "x_av_code"
    br.AppendFilter 0, "x_av_type", Cbequal, "LISTE_ID_COFFRE_DEFAUT"
    br.SimpleQuery 1, "x_av_code"
    br.AppendFilter 1, "x_av_type", Cbequal, "LISTE_STATUT_BDS1_ACTE"
    br.AppendFilter 1, "x_av_code_2", Cbequal, "CTI_CPA"
    br.SimpleQuery 2, "x_av_code"
    br.AppendFilter 2, "x_av_type", Cbequal, "LISTE_STATUT_BDS1_CF_STAT_ACTE"
    br.SimpleQuery 3, "x_av_code"
    br.AppendFilter 3, "x_av_type", Cbequal, "LISTE_STATUT_BDS1_STAT_MAT"
    br.SimpleQuery 4, "x_av_code"
    br.AppendFilter 4, "x_av_type", Cbequal, "LISTE_STATUT_BDS2_ACTE"
    br.SimpleQuery 5, "x_av_code"
    br.AppendFilter 5, "x_av_type", Cbequal, "LISTE_STATUT_BDS2_CF_STAT_ACTE"
    br.SimpleQuery 6, "x_av_code"
    br.AppendFilter 6, "x_av_type", Cbequal, "LISTE_STATUT_BDS2_STAT_MAT"
    br.SimpleQuery 7, "x_av_code"
    br.AppendFilter 7, "x_av_type", Cbequal, "BDS_INTERDITES_PR_CTI_ORG_DIFF"
    br.RetrieveRecords
	br.SimpleQuery 8, "x_av_code"
    br.AppendFilter 8, "x_av_type", Cbequal, "LISTE_STATUT_BDS2_ACTE_CSIM"
    br.RetrieveRecords
	br.SimpleQuery 9, "x_av_code"
    br.AppendFilter 9, "x_av_type", Cbequal, "LISTE_STATUT_BDS2_CODE_ETAT_CSIM"
    br.RetrieveRecords
	

    Set lstTmp = br.GetRecordlist (0)
    strCoffreDefaut = ListCodeToString (lstTmp, "x_av_code", "'")
    Set lstTmp = br.GetRecordlist (1)
    strActe1 = ListCodeToString (lstTmp, "x_av_code", "'")
    Set lstTmp = br.GetRecordlist (2)
    strStatutAct1 = ListCodeToString (lstTmp, "x_av_code", "'")
    Set lstTmp = br.GetRecordlist (3)
    strStatutFact1 = ListCodeToString (lstTmp, "x_av_code", "'")
    Set lstTmp = br.GetRecordlist (4)
    strActe2 = ListCodeToString (lstTmp, "x_av_code", "'")
    Set lstTmp = br.GetRecordlist (5)
    strStatutAct2 = ListCodeToString (lstTmp, "x_av_code", "'")
    Set lstTmp = br.GetRecordlist (6)
    strStatutFact2 = ListCodeToString (lstTmp, "x_av_code", "'")
	Set lstTmp = br.GetRecordlist (8)
    strActe2Csim = ListCodeToString (lstTmp, "x_av_code", "'")
	Set lstTmp = br.GetRecordlist (9)
    strcodEtat2Csim = ListCodeToString (lstTmp, "x_av_code", "'")



    strSqlStatement = " SELECT ci.objid||'|'||ci.x_av_id_eds||'|'||pn.x_av_cross_ref||'|'||ci.x_av_type_article" & _
                      " FROM table_contr_itm ci," & _
                      "      table_mod_level ml," & _
                      "      table_part_num pn" & _
                      " WHERE ci.contr_itm2mod_level = ml.objid" & _
                      " AND ml.part_info2part_num = pn.objid" & _
                      " AND ci.contr_itm2contr_schedule = " & ObjidLotSource
	If (Len(Trim(ObjidLigne)) > 0) Then
		strSqlStatement = strSqlStatement  & _
                      " AND ci.objid = " & ObjidLigne
	End If
	strSqlStatement = strSqlStatement  & _
                      " AND ci.child2contr_itm IS NULL" & _
                      " AND NVL(ci.x_av_o_scs, 0) = 0" & _
                      " " & _
                      " AND pn.x_av_part_prov_level = 'SI'" & _
                      " AND ( ci.x_av_categorie IN ('" & strMobile & "','" & strAcces & "') OR (ci.x_av_categorie = '" & strFixe & "' AND ci.x_av_itm2acces IS NULL) )" & _
                      " AND ci.x_av_statut_act   IN ( " & strActe1 & " )" & _
                      " AND ci.x_av_etat_act     IN ( " & strStatutAct1 & " )" & _
                      " AND ci.x_av_statut_mat   IN ( " & strStatutFact1 & " )" & _
                      " AND NOT EXISTS (" & _
										"     SELECT itm2.objid FROM table_contr_itm itm2," & _
										"      			table_mod_level ml," & _
										"      			table_part_num pn" & _
										"     WHERE itm2.child2contr_itm = ci.objid " & _
										" 		AND itm2.contr_itm2mod_level = ml.objid " & _
										" 		AND ml.part_info2part_num = pn.objid " & _
										"AND ( " & _
										"itm2.x_av_statut_act NOT IN (" & strActe2 & ")" & _
										"OR itm2.x_av_etat_act NOT      IN ( " & strStatutAct2 & ")" & _
										"OR itm2.x_av_statut_mat NOT    IN ( " & strStatutFact2 & ") " & _
										")" & _
										"AND( " & _
										"pn.x_av_cross_ref         <> 'NCSIICC'" & _
										"OR( " & _
										"itm2.x_av_statut_act <> 'A Cr�er' " & _
										"or itm2.x_av_code_etat <> 'OK_SAP' " & _
										")"& _
										") )"

    lstBDS.ItemType = "String"
    toDB.Select strSqlStatement, lstBDS

    '**** Move4 V2.3 MSIM AEL : Recupere les lignes secondaires    **** Mv 5.2 OKH CJUM
    If lstBDS.Count > 0 Then
        For i = 0 To lstBDS.Count - 1
            IdBDSSource     = trim_f(lstBDS.itembyindex(i), 1)
            IdEDSSourceMig  = trim_f(lstBDS.itembyindex(i), 2)
            TypeBDSSource   = trim_f(lstBDS.itembyindex(i), 4)
            '*****Interdire le changement de titulaire pour une ligne en cours de migration
            If checkMigration(IdEDSSourceMig) Then
                traitementDde = False
                strmessage = "Cette ligne " & IdEDSSourceMig & " a une migration initi�e�"
                Exit Function
            End If

            If TypeBDSSource = "1" then
                strSqlStatement = " SELECT ls.objid||'|'||ls.x_av_id_eds||'|'||pn.x_av_cross_ref||'|'||ls.x_av_type_article" & _
                                  " FROM table_contr_itm lp," & _
                                  "      table_contr_itm ls," & _
                                  "      table_x_av_code code," & _
                                  "      table_mod_level ml," & _
                                  "      table_part_num  pn," & _
                                  "      table_n_attributevalue attr," & _
								  "      table_x_av_code xav," & _
                                  "      table_n_properties prop" & _
                                  " WHERE lp.child2contr_itm      = " & IdBDSSource & _
                                  " AND lp.contr_itm2mod_level    = ml.objid" & _
                                  " AND ml.part_info2part_num     = pn.objid" & _
                                  " AND pn.x_av_cross_ref         = code.x_av_code" & _
                                  " AND code.x_av_type            = 'BDS2_BUNDLE'" & _
								  " AND code.x_av_libelle 		  = 'Option Multi Sim MOVE'" & _
                                  " AND attr.n_focuslowid         = lp.objid" & _
                                  " AND attr.x_av_value2n_properties = prop.objid" & _
                                  " AND prop.x_av_cross_ref       = code.x_av_code_2" & _
                                  " AND ls.objid                  = attr.n_targetlowid" & _
                                  " AND ls.child2contr_itm        IS NULL" & _
								  " AND xav.x_av_type               = 'TYPE_LIGNE_SECONDAIRE' " & _
                                  " AND ls.x_av_type_article      = xav.x_av_num "

                lstTmp2.ItemType = "String"
                toDB.Select strSqlStatement, lstTmp2
				lstBDS.AppendItem lstTmp2
            End If
        Next i

        '**** Move4 V2.3 MSIM AEL : FIN
        For i = 0 To lstBDS.Count - 1
            IdBDSSource     = trim_f(lstBDS.itembyindex(i), 1)
            IdEDSSource     = trim_f(lstBDS.itembyindex(i), 2)
            TypeBDSSource   = trim_f(lstBDS.itembyindex(i), 4)
			
			TRUELOG " Traitement de la BDS : " & IdBDSSource
			
            If TypeBDSSource = "1" then
                If checkChangementTituEnCours(IdBDSSource) Then
                    'TRUELOG "Demande de changement de titulaire ou de payeur en cours "
                    traitementDde = False
                    strmessage = "Demande de changement de titulaire ou de payeur en cours"
                    Exit Function
                End If
                'TRUELOG " Pas de Demande de changement de titulaire ou de payeur en cours "
                If checkADGEnCours(IdEDSSource) Then
                    traitementDde = False
                    strmessage = "une commande de changement de PTA , changement Option ,r�siliation � �ch�ance ou offre de suspension est en attente ou en cours de traitement"
                    Exit Function
                End If
            End If
            '[MOVE ET4 V1] : Interdire le changement de titulaire pour une ligne ayant une BDS2 Active ou en cours d'activation
            ' cf spec : CLFY_0317_SFS_Processus_de_modification_de_structure_client_mobile_PRICE_V06.2_En_cours_Etape_4
            ' & 2.2.2.4.2
			'debug.print "If Not checkBDS2ParcDuo2(Clng(IdBDSSource)) Then -->  IdBDSSource : " & IdBDSSource & " IdEDSSource : " & IdEDSSource
            'If Not checkBDS2ParcDuo(IdBDSSource,IdEDSSource) Then
			
			parcduo = True
			
			If Not checkBDS2ParcDuo2(Clng(IdBDSSource), False) Then
                parcduo = False
				'TRUELOG "La ligne " & IdBDSSource & " ne contient pas de BDS2 Parc DUO Active ou en cours d'activation."
                If orgDifferente  Then
                   If Not checkBdsInterdite(IdEDSSource)  Then
                      If savedde(IdBDSSource, ObjidLotSource, ObjidLotCible, SdateEffet) Then 
                         traitementDde = True
                      Else
                         strmessage = "probl�me d'enregistrement de la demande de changement pour la ligne "& lstBDS.itembyindex(i)
                         traitementDde = False
                      End If
                   End If
                Else
                   If savedde(IdBDSSource, ObjidLotSource, ObjidLotCible, SdateEffet) Then
					  traitementDde = True
                   Else
					  strmessage = "probl�me d'enregistrement de la demande de changement pour la ligne "& lstBDS.itembyindex(i)
                      traitementDde = False
                   End If
                End If
			Else
				traitementDde = false
				strmessage = "L'Acte de changement de titulaire pour la ligne " & lstBDS.itembyindex(i) & " ne peut pas se lancer car une option parc duo est active, merci de la r�silier pr�alablement."
            End If

        Next i
    Else
        strmessage = "Ligne non �ligible au changement de titulaire."
    End If
CleanUp:
    Set lstBDS      = Nothing
    Set toDB        = Nothing
    Set br          = Nothing
    Set lstTmp      = Nothing
    Set lstTmp2     = Nothing
    Set toDB        = Nothing
    strSQLStatement = ebnullstring

Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function

'*********************************************************************/
'Author: Imane AAJAIL
'Date :
'Description: V�rifier que parmi les  lignes mobiles �ligibles du lot source ne poss�dent pas de BDS dont la cross_ref est param�tr�e dans la liste ��BDS_INTERDITES_PR_CTI_ORG_DIFF��
'*********************************************************************/
Function checkBdsInterdite(IdEDSSource As String) As Boolean
On Error GoTo Error_Handling

    Dim strSqlStatement   As String
    Dim listBDS           As New List
    Dim toDB              As New SQLDB
    Dim br                As New Bulkretrieve
    Dim strBDSInterdites  As String
    Dim lstTmp            As New List
    Dim nomLotSource      As String
    Dim idContratSource   As String
    Dim objidBdsInterdite As String
    Dim lst               As New List


    checkBdsInterdite = False

    br.Clear
    br.SimpleQuery 0, "x_av_code"
    br.AppendFilter 0, "x_av_type", Cbequal, "BDS_INTERDITES_PR_CTI_ORG_DIFF"
    br.RetrieveRecords

    Set lstTmp = br.GetRecordlist (0)
    strBDSInterdites = ListCodeToString (lstTmp, "x_av_code", "'")
	
    strSqlStatement = " SELECT ci.objid" & _
                      " FROM table_contr_itm ci," & _
                      " table_mod_level ml," & _
                      " table_part_num pn" & _
                      " WHERE ci.x_av_id_eds = '" & IdEDSSource & "'" & _
		      " AND nvl(ci.x_av_flag_transfert,0) <> 1"&_
                      " AND ci.contr_itm2mod_level = ml.objid"&_
                      " AND ml.part_info2part_num = pn.objid"&_
                      " AND pn.x_av_cross_ref in ( " &  strBDSInterdites & " )" &_
                      " AND ci.x_av_statut_act NOT IN ( 'R�sili�' )"

        listBDS.ItemType = "String"
        toDB.Select strSQLStatement, listBDS


  If listBDS.Count  > 0 Then
           checkBdsInterdite = True
           objidBdsInterdite=trim_f(listBDS.itembyindex(0), 1)
           Set lst = recupNomlotIdcontrat(IdEDSSource)
           nomLotSource = ""
           idContratSource = ""
           If lst.Count > 0 Then
           nomLotSource = trim_f(lst.itembyindex(0), 1)
           idContratSource = trim_f(lst.itembyindex(0), 2)
           End If
           'TRUELOG "La ligne de masterId [" & IdEDSSource & "] du Lot [" & nomLotSource & "] / Contrat [" & idContratSource & "] poss�de une BDS interdite d'objid [" & objidBdsInterdite & "]�: elle n'est pas �ligible au changement de titulaire."
           strmessage = "La ligne de masterId [" & IdEDSSource & "] du Lot [" & nomLotSource & "] / Contrat [" & idContratSource & "] poss�de une BDS interdite d'objid [" & objidBdsInterdite & "]�: elle n'est pas �ligible au changement de titulaire."
           Exit Function
        End If



Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function
'*********************************************************************/
'Author: Imane AAJAIL
'Date :
'Description: V�rifier si l'organisation du contrat source est diff�rente de celle du contrat cible
'*********************************************************************/
Function checkOrg(strIdContratSource  As String,strIdContratCible   As String) As Boolean
On Error GoTo Error_Handling

    Dim br                          As New BulkRetrieve
    Dim lstTmp                      As New List
    Dim recTmp                      As Record
    Dim StrOrgSrc                   As String
    Dim StrOrgCbl                   As String

    br.SimpleQuery  0, "contract"
    br.AppendFilter 0, "id", cbEqual, strIdContratSource
    br.TraverseFromParent 1, "sell_to2bus_org", 0
    br.RetrieveRecords

    Set lstTmp = br.getRecordList(1)
    If lstTmp.Count = 1 Then
        Set recTmp = lstTmp.ItemByIndex(0)
        StrOrgSrc = recTmp.getfield("objid")
    End If

    br.Clear
    br.SimpleQuery  0, "contract"
    br.AppendFilter 0, "id", cbEqual, strIdContratCible
    br.TraverseFromParent 1, "sell_to2bus_org", 0
    br.RetrieveRecords

    Set lstTmp = br.getRecordList(1)
    If lstTmp.Count = 1 Then
        Set recTmp = lstTmp.ItemByIndex(0)
        StrOrgCbl = recTmp.getfield("objid")
    End If

    If StrOrgSrc = StrOrgCbl Then
        checkOrg = True
    Else
        checkOrg = False
    End if

CleanUp:
    Set br      = Nothing
    Set lstTmp  = Nothing
    Set recTmp  = Nothing

    Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function
'*********************************************************************/
'Author: Imane AAJAIL
'Date :
'Description: R�cup�rer le couple nom du Lot / id Contrat Source
'*********************************************************************/
Function recupNomlotIdcontrat(IdEDSSource As String) As List
On Error GoTo Error_Handling
    Dim lst             As New List
    Dim toDB            As New SQLDB
    Dim strSQLStatement As String

    strSqlStatement = " SELECT cs.schedule_id||'|'||c.id" & _
                      " FROM table_contr_itm ci," & _
                      "      table_contr_schedule cs," & _
                      "      table_contract c" & _
                      " WHERE ci.contr_itm2contr_schedule = cs.objid" & _
                      " AND cs.schedule2contract = c.objid" & _
                      " AND ci.x_av_id_eds = '" & IdEDSSource & "'" & _
		      " AND nvl(ci.x_av_flag_transfert,0) <> 1"&_
                      " AND ci.child2contr_itm IS NULL"

    lst.ItemType = "String"
    toDB.Select strSqlStatement, lst

    Set recupNomlotIdcontrat = lst

    Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description

End Function
' Debut function eel
'**** MOVE5 V1 EEL : Recuperer les lignes de l'acc�s
Function GetBdsLigneToAcces(objidAcces As String) As List
On Error GoTo Error_Handling

    Dim br                  As New BulkRetrieve
    Dim lstBDSLigne         As New List
    Dim lstTmp              As New List
    Dim recBds              As New Record
    Dim i                   As Integer
    Dim objidBDSLigne       As Long

    br.Clear
    br.SimpleQuery 0, "contr_itm"
    br.AppendFilter 0, "objid", cbEqual, objidAcces
    br.TraverseFromParent 1, "x_av_acces2itm", 0
    br.RetrieveRecords

    Set lstTmp = br.GetRecordlist(1)
    lstBDSLigne.ItemType = "Long"
    If lstTmp.count > 0 Then
        For i = 0 To lstTmp.count - 1
            Set recBds = lstTmp.ItemByIndex(i)
            objidBDSLigne = recBds.GetField("objid")
            lstBDSLigne.AppendItem objidBDSLigne
        Next i
    End If
	Set GetBdsLigneToAcces = lstBDSLigne
    Set br                 = Nothing
    Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function
' fin function eel

'*********************************************************************/
'Author: Youness AADISSA
'Date :
'Description: Enregistrer la demande pour chaque ligne
'*********************************************************************/
Function savedde(IdBDSSource As String, ObjidLotSource As String, ObjidLotCible As String, SdateEffet As String) As Boolean
On Error GoTo Error_Handling
    Dim lstTmp                      As New List
	Dim lstTmpLigneAcces            As New List''eel
    Dim br                          As New Bulkretrieve
    Dim bs                          As New BulkSave
    Dim recTmp                      As New Record
    Dim recTmp2                     As New Record
    Dim recSuivi                    As New Record
    Dim IdContratSource             As String
    Dim idCFSource                  As String
    Dim idCUSource                  As String
    Dim IdContratcible              As String
    Dim objidCFCible                As String
    Dim IDCFCible                   As String
    Dim objidCUCible                As String
    Dim toDB                        As New SQLDB
    Dim lstParameters               As New List
    Dim i                           As Integer
    Dim k                           As Integer
    Dim vFromDate                   As String
    Dim recNew                      As New Record
    Dim par_nbrheures               As Integer
    Dim nbrheure                    As Integer
    Dim dtdiff                      As Date
    Dim str_date                    As String

    'Prepeare les data
    ' - Annuler la demande en cours :
    Set lstTmp = New List
    lstTmp.ItemType = "String"
    lstTmp.AppendItem "Changement Payeur", "Changement Titulaire"
    br.Clear
    br.SimpleQuery 0, "x_av_suivi_chmt_cf"
    br.AppendFilter 0, "x_av_type", cbin, lstTmp
    br.AppendFilter 0, "x_av_focus_id", cbequal, ObjidLotSource
    br.AppendFilter 0, "x_av_status", cbequal, "A traiter"
    br.RetrieveRecords
    Set lstTmp = br.GetRecordlist(0)
    If lstTmp.Count  > 0 Then
        For i = 0 To lstTmp.Count - 1
            Set recSuivi = lstTmp.ItemByIndex(i)
            recSuivi.SetField "x_av_status", "Annul�"
            recSuivi.SetField "x_av_lib_etat", "le " & Cstr(App.CurrentDate)
            bs.UpdateRecord recSuivi
            bs.Save
        Next i
    End If

    'Mis � jour de la table contr_itm 'eel mettre le flag sur les lignes de l'acces
    lstTmpLigneAcces.ItemType = "Long"

    br.Clear
    br.SimpleQuery 0, "contr_itm"
    br.AppendFilter 0, "objid", cbEqual, IdBDSSource
    br.RetrieveRecords
    Set lstTmp = br.GetRecordList(0)
    Set recTmp = lstTmp.ItemByIndex(0)

    recTmp.SetField "x_av_chgmt_cu_cf", 1
    bs.UpdateRecord recTmp
    bs.save
    'Pour le cas d'un acc�s mettre le flag pour les lignes rattach�es
    If recTmp.GetField("x_av_categorie") = strAcces then
        Set lstTmpLigneAcces = GetBdsLigneToAcces(IdBDSSource)
		' COR C20204866 : Ne pas arr�ter un FUSAC si l'acc�s n'a pas de ligne rattach�e >
		If lstTmpLigneAcces.Count > 0 Then
		' COR C20204866 : Ne pas arr�ter un FUSAC si l'acc�s n'a pas de ligne rattach�e <
			br.Clear
			br.SimpleQuery 0, "contr_itm"
			br.AppendFilter 0, "objid", cbin , lstTmpLigneAcces
			br.RetrieveRecords
			Set lstTmp = br.GetRecordList(0)
			For k =0 To lstTmp.Count -1
				Set recTmp2 = lstTmp.ItemByIndex(k)
				recTmp2.SetField "x_av_chgmt_cu_cf", 1
				bs.UpdateRecord recTmp2
				bs.save
			Next k
		' COR C20204866 : Ne pas arr�ter un FUSAC si l'acc�s n'a pas de ligne rattach�e >
		End If
		' COR C20204866 : Ne pas arr�ter un FUSAC si l'acc�s n'a pas de ligne rattach�e <
    End If

	

	'OKH : RCE Mv 5.2 MSIM/CJUM
	Dim toDBx2 As New SQLDB
	Dim strSQLStatementSec2	As String
 	strSqlStatementSec2 =" SELECT 1 " & _                           
				" FROM  table_contr_itm LS," & _  
				" table_x_av_code param " & _                
				" where LS.objid = " &  recTmp.GetField("objid") & _  
				" and param.x_av_type='TYPE_LIGNE_SECONDAIRE' "&_
				" and param.x_av_num = LS.x_av_type_article "		   
    Dim lstLSec2 As New List
    lstLSec2.ItemType = "String"
    toDBx2.Select strSqlStatementSec2, lstLSec2
	'fin okh

    If (lstLSec2.Count = 0 or recTmp.GetField("x_av_categorie") = strAcces  or recTmp.GetField("x_av_categorie") = strMobile or recTmp.GetField("x_av_categorie") = strFixe)then ' EEL
        ' - Insertion dans la table x_av_suivi_chmt_cf pour les lignes Standart et principales
        br.Clear
        br.SimpleQuery 0, "contr_schedule"
        br.AppendFilter 0, "objid", cbequal, ObjidLotSource
        br.TraverseFromParent 1, "schedule2contract", 0
        br.TraverseFromParent 2, "bill_to2site", 0
        br.TraverseFromParent 3, "ship_to2site", 0
        br.RetrieveRecords
        Set lstTmp = br.GetRecordList(1)
        Set recTmp = lstTmp.ItemByIndex(0)
        IdContratSource  = recTmp.GetField("ID")

        Set lstTmp = br.GetRecordList(2)
        Set recTmp = lstTmp.ItemByIndex(0)
        idCFSource = recTmp.GetField("site_id")

        Set lstTmp = br.GetRecordList(3)
        Set recTmp = lstTmp.ItemByIndex(0)
        idCUSource = recTmp.GetField("site_id")

        br.Clear
        br.SimpleQuery 0, "contr_schedule"
        br.AppendFilter 0, "objid", cbequal, ObjidLotCible
        br.TraverseFromParent 1, "schedule2contract", 0
        br.TraverseFromParent 2, "bill_to2site", 0
        br.TraverseFromParent 3, "ship_to2site", 0
        br.RetrieveRecords
        Set lstTmp = br.GetRecordList(1)
        Set recTmp = lstTmp.ItemByIndex(0)
        IdContratcible  = recTmp.GetField("ID")

        Set lstTmp = br.GetRecordList(2)
        Set recTmp = lstTmp.ItemByIndex(0)
        objidCFCible = recTmp.GetField("objid")
        IDCFCible = recTmp.GetField("site_id")

        Set lstTmp = br.GetRecordList(3)
        Set recTmp = lstTmp.ItemByIndex(0)
        objidCUCible = recTmp.GetField("site_id")


        '898 NRED
        str_date = cstr(app.CurrentDate)
        str_date = Mid$(str_date,1,10)
        If date_effet = "1" Then
            vFromDate = str_date
        '898 NRED END
        Else
            'charger les dates d'effets
            dtdiff = Now()
            nbrheure = 24 - Hour(dtdiff)
            If (nbrheure < par_nbrheures) Then
                vFromDate = Cstr (Format(DateAdd("d", 1, App.CurrentDate), "short Date"))
            Else
                vFromDate = App.CurrentDate
            End If

            Set toDB = New SQLDB
            lstParameters.Clear
            lstParameters.ItemType = "variant"
            lstParameters.AppendItem objidCFCible, date2caract (Day(vFromDate)) & "/" & date2caract (Month(vFromDate)) & "/" & CStr(Year(vFromDate))
            toDB.ExecuteProc "sa.PROC_X_AV_GET_NEXT_CUTOFF_DATE", lstParameters, typResponseCutOff
            vFromDate = typResponseCutOff.DateCutOff
        End If

        If  Len(Trim(SdateEffet)) <> 0 Then ' D EEL
            vFromDate =  date2caract (Day(SdateEffet)) & "/" & date2caract (Month(SdateEffet)) & "/" & CStr(Year(SdateEffet))
            'cdate (SdateEffet)
        end if         ' F EEL M

        Set recNew = New record
        recNew.RecordType = "x_av_suivi_chmt_cf"
        recNew.SetField "x_av_type", "Changement Titulaire"
        recNew.SetField "x_av_id_contract", IdContratSource
        recNew.SetField "x_av_id_contr_schedule", Clng(ObjidLotSource)
        recNew.SetField "x_av_focus_id", Clng(IdBDSSource)
        recNew.SetField "x_av_cu_source", idCUSource
        recNew.SetField "x_av_cf_source", idCFSource
        recNew.SetField "x_av_id_contract_cible", IdContratcible 'Contrat cible
        recNew.SetField "x_av_id_contr_schedule_cible", Clng(ObjidLotCible) 'Lot cible
        recNew.SetField "x_av_cu_cible", objidCUCible
        recNew.SetField "x_av_cf_cible", IDCFCible
        recNew.SetField "x_av_date_effet", vFromDate
        recNew.SetField "x_av_dem_dt", App.CurrentDate
        recNew.SetField "x_av_dem_login", App.UserName
		recNew.SetField "x_av_status", "A traiter"
        bs.InsertRecord recNew
        bs.save
    End If
    savedde = True
Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function
'*********************************************************************/
'Author: Youness AADISSA
'Date :    15/01/2010
'Description: Convertir une liste en string s�par�es par "Separateur"
'*********************************************************************/
Function ListCodeToString(LstTmp As List, Field_name As String, Separateur As String) As String
    Dim recTmp As Record
    Dim StrChaine As String
    Dim i As Integer
    For i = 0 To lstTmp.Count - 1
        Set recTmp = lstTmp.itembyindex (i)
        If i = 0 Then
            StrChaine = Separateur & recTmp.getField(Field_name) & Separateur
        Else
            StrChaine = StrChaine & ", " & Separateur & recTmp.getField(Field_name) & Separateur
        End If
    Next i
    ListCodeToString = StrChaine
End Function

'*********************************************************************/
'Author: Ahmed El Hamdany
'Date  : 17/06/2011
'Description: V�rifier que le contrat cible est li� � un VPN mobile dans le cas o� le contrat source l�est
'*********************************************************************/
Function checkVPNContrat(strIdContratSource,strIdContratCible) As Boolean
On Error GoTo Error_Handling
    Dim br                          As New BulkRetrieve
    Dim lstTmp                      As New List
    Dim lstTmp2                     As New List
    Dim recTmp                      As Record


    br.SimpleQuery  0, "contract"
    br.AppendFilter 0, "id", cbEqual, strIdContratSource
    br.TraverseFromParent 1, "x_av_contract2vpn", 0
    br.RetrieveRecords

    Set lstTmp = br.getRecordList(1)

    br.SimpleQuery  0, "contract"
    br.AppendFilter 0, "id", cbEqual, strIdContratCible
    br.TraverseFromParent 1, "x_av_contract2vpn", 0
    br.RetrieveRecords

    Set lstTmp2 = br.getRecordList(1)

    If lstTmp.Count > 0 Then
        If lstTmp2.Count > 0 Then
            checkVPNContrat = True
            Exit Function
        Else
            checkVPNContrat = False
            Exit Function
        End If
    End If
    checkVPNContrat = True
Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description

End Function
'*********************************************************************/
'Author      : Imane AAJAIL
'Date        : 17/08/2011
'Description : V�rifier qu'il n�existe pas sur la ligne une BDS2 Parc Duo � Active � ou � En cours d�activation �.
'cf SPEC     : CLFY_0317_SFS_Processus_de_modification_de_structure_client_mobile_PRICE_V06.2_En_cours_Etape_4
'              & 2.2.2.4.2
'Update      :
'*********************************************************************/
Function checkBDS2ParcDuo(strObjid  As String, strIdEDS As String) As Boolean
On Error GoTo Error_Handling
    Dim br                               As New BulkRetrieve
    Dim lstTmp                           As New List
    Dim listBDS                          As New List
    Dim toDB                             As New SQLDB
    Dim strSqlStatement                  As String
    Dim strActivPduo                     As String
    Dim strActivPduoCfAct                As String
    Dim strActivPduoCfFact               As String
    Dim strActivEnCoursPduo              As String
    Dim strActivEnCoursPduoCfAct         As String
    Dim strActivEnCoursPduoCfFact        As String
    Dim strParcDuoPRICE                  As String

    checkBDS2ParcDuo = False

    br.Clear
    br.SimpleQuery 0, "x_av_code"
    br.AppendFilter 0, "x_av_type", Cbequal, "STATUT_ACTIV_PDUO_ACTE"
    br.SimpleQuery 1, "x_av_code"
    br.AppendFilter 1, "x_av_type", Cbequal, "STATUT_ACTIV_PDUO_CF_STAT_ACTE"
    br.SimpleQuery 2, "x_av_code"
    br.AppendFilter 2, "x_av_type", Cbequal, "STATUT_ACTIV_PDUO_CF_STAT_FACT"
    br.SimpleQuery 3, "x_av_code"
    br.AppendFilter 3, "x_av_type", Cbequal, "STATUT_ACTIV_ENCOURS_PDUO_ACTE"
    br.SimpleQuery 4, "x_av_code"
    br.AppendFilter 4, "x_av_type", Cbequal, "STATUT_ACTIV_ENCOURS_PDUO_CF_STAT_ACTE"
    br.SimpleQuery 5, "x_av_code"
    br.AppendFilter 5, "x_av_type", Cbequal, "STATUT_ACTIV_ENCOURS_PDUO_CF_STAT_FACT"
    br.SimpleQuery 6, "x_av_code"
    br.AppendFilter 6, "x_av_type", Cbequal, "PARC_DUO_PRICE_CROSS_REF"
    br.RetrieveRecords

    Set lstTmp = br.GetRecordlist (0)
    strActivPduo = ListCodeToString (lstTmp, "x_av_code", "'")
    Set lstTmp = br.GetRecordlist (1)
    strActivPduoCfAct = ListCodeToString (lstTmp, "x_av_code", "'")
    Set lstTmp = br.GetRecordlist (2)
    strActivPduoCfFact = ListCodeToString (lstTmp, "x_av_code", "'")
    Set lstTmp = br.GetRecordlist (3)
    strActivEnCoursPduo = ListCodeToString (lstTmp, "x_av_code", "'")
    Set lstTmp = br.GetRecordlist (4)
    strActivEnCoursPduoCfAct = ListCodeToString (lstTmp, "x_av_code", "'")
    Set lstTmp = br.GetRecordlist (5)
    strActivEnCoursPduoCfFact = ListCodeToString (lstTmp, "x_av_code", "'")
    Set lstTmp = br.GetRecordlist (6)
    strParcDuoPRICE = ListCodeToString (lstTmp, "x_av_code", "'")

    strSqlStatement = " SELECT ci.objid" & _
                      " FROM table_contr_itm ci," & _
                      " table_mod_level ml," & _
                      " table_part_num pn" & _
                      " WHERE ci.child2contr_itm = '" & strObjid & "'" & _
                      " AND ci.contr_itm2mod_level = ml.objid"&_
                      " AND ml.part_info2part_num = pn.objid"&_
                      " AND pn.x_av_cross_ref IN ( " &  strParcDuoPRICE & " )" &_
                      " AND ((ci.x_av_statut_act  IN ( " & strActivPduo  & " )" &_
                      " AND ci.x_av_etat_act  IN ( " & strActivPduoCfAct  & " )" &_
                      " AND ci.x_av_status_c2a  IN ( " & strActivPduoCfFact  & " ))" &_
                      " OR ( ci.x_av_statut_act  IN ( " & strActivEnCoursPduo  & " )" &_
                      " AND ci.x_av_etat_act  IN ( " & strActivEnCoursPduoCfAct  & " )" &_
                      " AND ci.x_av_status_c2a  IN ( " & strActivEnCoursPduoCfFact  & " )))"

    listBDS.ItemType = "String"
    toDB.Select strSqlStatement, listBDS

    If listBDS.Count  > 0 Then
        checkBDS2ParcDuo = True
        TRUELOG "La ligne " & strObjid & " contient une BDS2 Parc DUO Active ou en cours d'activation."
        'Si la ligne poss�de une option Parc Duo active ou En cours d�activation un message d�erreur est 'trac� dans les logs : � La ligne [Master_id  de la ligne] poss�de une option Parc duo active ou en 'cours d�activation �
        strmessage = "La ligne [" & strIdEDS & "] poss�de une option Parc duo active ou en cours d'activation."
    End If

    Set br                               = Nothing
    Set lstTmp                           = Nothing
    Set listBDS                          = Nothing
    Set toDB                             = Nothing
    strSqlStatement                      = ebnullstring


Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function

' # 30-05-2017 - KKAN : COR C18284878 - D�but >
'***********************************************************************************************************/
'Author      : Kassem KANSOU
'Date        : 30/05/2017
'Description : Fonction permettant de v�rifier s'il existe sur une ligne donn�e une BDS2 Parc Duo � Active �.
'Info	     : C18284878 - Correctif - CTI Option Parc Duo
'***********************************************************************************************************/
Function checkBDS2ParcDuo2 (p_Objid As Long, p_contr_schedule_objid As Boolean) As Boolean
On Error GoTo Error_Handling
    Dim strSqlStatement As string
    Dim toDB            As New SQLDB
    Dim lstBDS          As list
	Dim strCondition    As string
    
	checkBDS2ParcDuo2 = False
	
	strCondition = " and cs.objid = " & p_Objid
	
	Set lstBDS = New List
	lstBDS.itemtype = "Long" 'D�fini en dur car n'est pas li� aux fichiers globals
	
	if p_contr_schedule_objid then
		strCondition = " and cs.objid = " & p_Objid
	else
		strCondition = " and ci1.objid = " & p_Objid
	end if
	
	strSqlStatement = " select distinct ci1.objid" & _
                      " FROM table_part_num pn1," & _
                      "      table_mod_level ml1," & _
                      "      table_contr_itm ci1," & _
                      "      table_part_num pn2," & _
                      "      table_mod_level ml2," & _
                      "      table_contr_itm ci2," & _
                      "      table_contr_schedule cs," & _
                      "      table_contract c," & _
                      "      table_bus_org bo," & _
                      "      table_site cu," & _	
                      "      table_site cf," & _
                      "      table_n_attributevalue attr," & _
                      "      table_n_properties prop1" & _
                      " where pn1.objid = ml1.part_info2part_num" & _
					  " and ci1.contr_itm2mod_level = ml1.objid" & _
					  " and pn2.objid = ml2.part_info2part_num" & _
					  " and ci2.contr_itm2mod_level = ml2.objid" & _
					  " and ci1.objid = ci2.child2contr_itm" & _
					  " and cs.objid = ci1.contr_itm2contr_schedule" & _
					  " and c.objid = cs.schedule2contract" & _
					  " and c.sell_to2bus_org = bo.objid" & _
					  " and ci2.x_av_used_by2site = cu.objid(+)" & _
					  " and ci2.x_av_bill_to2site = cf.objid(+)" & _
					  " and ci1.objid=attr.n_focuslowid(+)" & _
					  " and attr.x_av_value2n_properties = prop1.objid(+)" & _
					  "	and pn2.x_av_install_type like ('%F')" & _
					  " and ci1.x_av_statut_act ='Cr��'" & _
					  " and pn2.x_av_cross_ref in ('OPT_SPLIT_PARC_DUO','OPT_DUO_RC')" & _
					  " and ci2.x_av_arb_status in ('CRE_ARB','MOD_ARB')" & _
						strCondition
					  '" and ci1.objid = " & p_Objid 
    toDB.Select strSqlStatement, lstBDS
    
	If lstBDS.Count > 0 Then
        checkBDS2ParcDuo2 = True
    End If

    Set toDB    = Nothing
    Set lstBDS  = Nothing
    
	strSQLStatement = ebnullstring
Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function
' # 30-05-2017 - KKAN : COR C18284878 - Fin >

'*********************************************************************/
'Author: Marouane NABIH
'Description:
'Input : V�rifier qu'il n'existe pas de lignes en cours de migration
'Output : Boolean
'Update:
'*********************************************************************/
Function checkMigration(ideds As String) As Boolean
On  Error GoTo Error_Handling
    Dim statut          As New List
    Dim strSqlStatement As string
    Dim toDB            As New SQLDB
    Dim br              As New Bulkretrieve
    Dim lstTmp          As New List
    Dim strAdgNonCum    As String

    statut.ItemType = "String"

    strSqlStatement = " SELECT x_av_statut_migration" & _
                      " FROM table_contr_itm" & _
                      " WHERE x_av_id_eds = '" & ideds & "'" & _
		      " AND nvl(x_av_flag_transfert,0) <> 1"&_
                      " AND child2contr_itm is null"& _
                      " AND x_av_statut_migration is not null"

    toDB.Select strSQLStatement, statut


    If statut.Count > 0 Then
        checkMigration = True
    Else
        checkMigration = False
    End If
    Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function

'*********************************************************************/
'Author: Marouane NABIH
'Description:
'Input : V�rifier que les lots sources et cibles ne sont pas des lots de lignes secondaires
'Output : Boolean
'Update:
'*********************************************************************/
Function checkLotsSecondaires(objidLotSource As String, objidLotCible As String) As Boolean
On  Error GoTo Error_Handling
    Dim lstTmp          As New List
    Dim strSqlStatement As string
    Dim toDB            As New SQLDB
    Dim br              As New Bulkretrieve
    Dim lstTmp2         As New List
    Dim strAdgNonCum    As String
    Dim strCoffreDefaut As String


    br.Clear
    br.SimpleQuery 0, "x_av_code"
    br.AppendFilter 0, "x_av_type", Cbequal, "LISTE_ID_COFFRE_DEFAUT"
    br.RetrieveRecords
    Set lstTmp2 = br.GetRecordlist (0)
    strCoffreDefaut = ListCodeToString (lstTmp2, "x_av_code", "'")

    lstTmp.ItemType = "String"

    strSqlStatement = " SELECT ci.objid" & _
                      " FROM table_contr_itm ci," & _
                      "      table_mod_level ml," & _
					  "      table_x_av_code code," & _
                      "      table_part_num pn" & _
                      " WHERE ci.contr_itm2mod_level                   = ml.objid" & _
                      " AND ml.part_info2part_num                      = pn.objid" & _
                      " AND ci.contr_itm2contr_schedule               IN ( '" & ObjidLotSource & "', '" & ObjidLotCible & "' )" & _
                      " AND ci.child2contr_itm                        IS NULL" & _
					  " AND code.x_av_type                        	   ='TYPE_LIGNE_SECONDAIRE' " & _
                      " AND ci.x_av_type_article                       = code.x_av_num" & _
                      " AND ci.x_av_ndi                           IS NOT NULL" & _
                      " AND NVL(ci.x_av_o_scs, 0)                      = 0" & _
                      " AND LENGTH(TRIM(NVL(pn.x_av_generic_quad,''))) > 0" & _
                      " AND pn.x_av_part_prov_level                    = 'SI'" & _
                      " AND pn.x_av_generic_quad                  NOT IN ( " & strCoffreDefaut & " )"

    toDB.Select strSQLStatement, lstTmp
    If lstTmp.Count > 0 Then
        checkLotsSecondaires = True
    Else
        checkLotsSecondaires = False
    End If

    Set br                               = Nothing
    Set lstTmp                           = Nothing
    Set lstTmp2                          = Nothing
    Set toDB                             = Nothing
    strSqlStatement                      = ebnullstring

    Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function

' Debut EEL
Function InitParamXAvCode() As Boolean
On Error GoTo Error_Handling
    'IAD R�cup�ration des cat�gories � partir du param
    Dim br             As New BulkRetrieve
    Dim lstTmp         As New list
    Dim lstTyp         As New List
    Dim recTmp         As New Record
    Dim Indx           As Long

    InitParamXAvCode = False
    lstTyp.ItemType  = "string"
    lstTyp.AppendItem "CAT_BDS1_PBE", "CAT_BDS1_MOVE"

    br.Clear
    br.SimpleQuery 0, "x_av_code"
    br.AppendFilter 0, "x_av_type", CbIn, lstTyp
    br.RetrieveRecords

    Set lstTmp = br.GetRecordlist(0)

    Indx          = lstTmp.FindFirstIndex("CAT_BDS1_PBE", "x_av_type", "LIGNE_PBE", "x_av_code")
    If Indx < 0 Then
        TRUELOG "Param�trage CAT_BDS1_PBE|LIGNE_PBE Manquant."
        Goto CleanUp
    End If
    Set recTmp    = lstTmp.ItemByIndex(Indx)
    strFixe       = recTmp.GetField("x_av_code_2")

    Indx          = lstTmp.FindFirstIndex("CAT_BDS1_PBE", "x_av_type", "ACCES", "x_av_code")
    If Indx < 0 Then
        TRUELOG "Param�trage CAT_BDS1_PBE|ACCES Manquant."
        Goto CleanUp
    End If
    Set recTmp    = lstTmp.ItemByIndex(Indx)
    strAcces      = recTmp.GetField("x_av_code_2")

    Indx          = lstTmp.FindFirstIndex("CAT_BDS1_MOVE", "x_av_type", "LIGNE_MOBILE", "x_av_code")
    If Indx < 0 Then
        TRUELOG "Param�trage CAT_BDS1_MOVE|LIGNE_MOBILE Manquant."
        Goto CleanUp
    End If
    Set recTmp    = lstTmp.ItemByIndex(Indx)
    strMobile     = recTmp.GetField("x_av_code_2")

    InitParamXAvCode = True

CleanUp:
    Set br        = Nothing
    Set lstTmp    = Nothing
    Set lstTyp    = Nothing
    Set recTmp    = Nothing

Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function
' Fin EEL

'*********************************************************************/
'Author: Sebastien PELEGRY
'Description:  R�cuperer l'objid de la Ligne 
'*********************************************************************/
Function recupeObjiIdLigne(IdLigneSource As String) As String
On Error GoTo Error_Handling

    Dim lst             As New List
    Dim toDB            As New SQLDB
    Dim strSQLStatement As String

    strSqlStatement = " SELECT NVL(child2contr_itm, objid)" & _
                      " FROM table_contr_itm " & _
                      " WHERE x_av_ndi = '" & IdLigneSource & "'" & _
		              " AND x_av_statut_act not in ('R�sili�','RESILIE FACTURE','RESILIE NON FACTURE')" & _
		              " ORDER BY create_date DESC"

    lst.ItemType = "String"
    toDB.Select strSqlStatement, lst

    If lst.Count > 0 Then
		recupeObjiIdLigne = lst.itembyindex(0)
	Else
		recupeObjiIdLigne = ""
        strmessage = "La ligne n'existe pas."
	End If

    Set lst                              = Nothing
    Set toDB                             = Nothing
    strSqlStatement                      = ebnullstring

    Exit Function
Error_Handling:
    TRUELOG "Erreur : "  
End Function

'*********************************************************************/
'Author: Sebastien PELEGRY
'Description: V�rifier l'appartenance de la ligne au lot
'Input :
'Output : Boolean
'Update:
'*********************************************************************/
Function chkLotLigne(ObjidLot As String, ObjidLigne As String) As Boolean
On Error GoTo Error_Handling
  
	Dim brLigne As new bulkretrieve
	Dim lstLigne As list
	
	brLigne.simplequery 0, "contr_itm"
	brLigne.appendfilter 0, "objid", cbEqual, ObjidLigne
	brLigne.TraverseFromParent 1, "contr_itm2contr_schedule", 0
	brLigne.appendfilter 1, "objid", cbEqual, ObjidLot

	brLigne.retrieverecords
    set lstLigne = brLigne.getRecordlist(1)
    chkLotLigne = (lstLigne.count > 0)

   Exit Function
Error_Handling:
   TRUELOG "Erreur : "  
End Function