'Description: Fonction utilis�e pour transformer un integer en un string de deux caract�res s'il
'        n'est compos� que d'un seul
'*********************************************************************************************************/
Function date2caract (intDate As Integer) As String
On Error GoTo ErrHandler
    Dim strDate2Caract As String
    strDate2Caract = cStr(intDate)
    If Len(strDate2Caract) = 1 Then
        strDate2Caract = "0" & strDate2Caract
    End If
    date2caract = strDate2Caract
    Exit Function
ErrHandler:
    TRUELOG "Erreur dans la conversion de : " & intDate & "en deux caract�res"
End function
'*********************************************
'*** Function:    Date_Comparaison
'*** Name:    Youness AADISSA
'*** DATE:
'*** DESCRIPION:
'*** NOTES     : Teste si la date (sans tenir compte des heures) pass�e en entr�e est "sup", "inf" ou "eg" � la date du jour
'**********************************************
Function Date_Comparaison(varDate As Variant, operator As String, optional egal) As Boolean
On Error Goto Error_Handling
    Dim dtCurrent   As Date
    Dim dtCompar    As Date
    Dim intDate     As Integer

    Date_Comparaison = False
    If varDate = "*/*/* *:*:*" Then
        Date_Comparaison = True
        Exit Function
    End If
    dtCurrent = App.CurrentDate
    dtCompar = vStr2Date(varDate)

    If Year(dtCompar) = 1753 Then     'Si la date est vide, le test est correct
        Date_Comparaison = True
        Exit Function
    End If

    intDate = DateDiff("d", dtCompar, dtCurrent)
    Select Case intDate
        Case 0
            If Not isMissing (egal) Or operator = "eg" Then Date_Comparaison = True
        Case Is > 0
            If operator = "inf" Then Date_Comparaison = True
        Case Is < 0
            If operator = "sup" Then Date_Comparaison = True
    End Select

Exit Function
Error_Handling:
    TRUELOG "Date : [" & varDate & "], Op�rateur : [" & operator & "] - Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description
End Function
'*********************************************************************************************************/
'Author: Youness AADISSA
'Date :
'Description: check Date format
'*********************************************************************************************************/
Sub vCheckDateFormat()
    Dim zTestDate           As String        ' Need a String for Summit test
    Dim nDay                As Integer
    Dim nSummitDateFormat   As Integer
    Dim nPOMSDateFormat     As Integer

    If gzClarifyDateFormat <> "" Then
        Exit Sub
    End If
    nDay = Day( "01/02/03" )
    Select Case nDay
        Case 1
            nSummitDateFormat = DATE_DDMMYY
        Case 2
            nSummitDateFormat = DATE_MMDDYY
        Case 3
            nSummitDateFormat = DATE_YYMMDD
    End Select
    gzClarifyDateFormat = vGetPOMSDateFormat()
    Select Case Left(gzClarifyDateFormat, 2)
        Case "%d"
            nPOMSDateFormat = DATE_DDMMYY
        Case "%m"
            nPOMSDateFormat = DATE_MMDDYY
        Case "%y", "%Y"
            nPOMSDateFormat = DATE_YYMMDD
        Case Else
            nPOMSDateFormat = DATE_MMDDYY
    End Select
    Select Case nPOMSDateFormat
        Case DATE_MMDDYY
            Select Case nSummitDateFormat
                Case DATE_MMDDYY
                    gbSwapDaysAndMonths = False
                Case DATE_DDMMYY
                    gbSwapDaysAndMonths = True
                Case DATE_YYMMDD
                    gbSwapDaysAndMonths = True
            End Select
        Case DATE_DDMMYY
            Select Case nSummitDateFormat
                Case DATE_MMDDYY
                    gbSwapDaysAndMonths = True
                Case DATE_DDMMYY
                    gbSwapDaysAndMonths = False
                Case DATE_YYMMDD
                    gbSwapDaysAndMonths = False
            End Select
        Case DATE_YYMMDD
            Select Case nSummitDateFormat
                Case DATE_MMDDYY
                    gbSwapDaysAndMonths = False
                Case DATE_DDMMYY
                    gbSwapDaysAndMonths = False
                Case DATE_YYMMDD
                    gbSwapDaysAndMonths = False
            End Select
    End Select
End Sub
'*********************************************************************************************************/
'Author: Youness AADISSA
'Date :
'Description: String To Date
'*********************************************************************************************************/
Function vStr2Date( ByVal azDate As String ) As Date
    Dim nDay        As Integer
    Dim nMonth      As Integer
    Dim nYear       As Integer
    Dim nHour       As Integer
    Dim nMinute     As Integer
    Dim nSecond     As Integer
    Dim dDate       As Date
    If azDate = "?/?/? ?:?:?" Then
        vStr2Date = #01/01/1753#    ' Unset date in the past
        Exit Function
    ElseIf azDate = "*/*/* *:*:*" Then
        vStr2Date = #31/12/4712#    ' Unset date in the future
        Exit Function
    ElseIf Not IsDate( azDate ) Then
        vStr2Date = #01/01/1753#    ' Not a valid date
        Exit Function
    End If
    vCheckDateFormat
    nDay = Day( azDate )
    If nDay <= 12 And gbSwapDaysAndMonths Then
        nMonth  = nDay
        nDay    = Month( azDate )
        nYear   = Year( azDate )
        nHour   = Hour( azDate )
        nMinute = Minute( azDate )
        nSecond = Second( azDate )
        dDate   = DateSerial( nYear, nMonth, nDay )
        dDate   = DateAdd( "h", nHour,   dDate )
        dDate   = DateAdd( "n", nMinute, dDate )
        dDate   = DateAdd( "s", nSecond, dDate )
    Else
        dDate = CDate( azDate )
    End If
    vStr2Date = dDate
End Function
'*********************************************************************************************************/
'Author: Youness AADISSA
'Date :
'Description: Date To String
'*********************************************************************************************************/
Function vDate2Str( ByVal adDate As Date ) As String
    Dim nDay        As Integer
    Dim nMonth      As Integer
    Dim nYear       As Integer
    Dim nHour       As Integer
    Dim nMinute     As Integer
    Dim nSecond     As Integer
    Dim zDate       As String
    Dim nIndex      As Integer
    vCheckDateFormat
    nDay    = Day( adDate )
    nMonth  = Month( adDate )
    nYear   = Year( adDate )
    nHour   = Hour( adDate )
    nMinute = Minute( adDate )
    nSecond = Second( adDate )
    zDate = gzClarifyDateFormat
    nIndex = Instr( zDate, "%d" )
    If nIndex = 0 Then
        vDate2Str = CStr( adDate )
        Exit Function
    End If
    zDate = Left$( zDate, nIndex - 1) & Format( nDay, "00" ) & Mid$( zDate, nIndex + 2 )
    nIndex = Instr( zDate, "%m" )
    If nIndex = 0 Then
        vDate2Str = CStr( adDate )
        Exit Function
    End If
    zDate = Left$( zDate, nIndex - 1) & Format( nMonth, "00" ) & Mid$( zDate, nIndex + 2 )
    nIndex = Instr( zDate, "%y" )
    If nIndex = 0 Then
        nIndex = Instr( zDate, "%Y" )
        If nIndex = 0 Then
            vDate2Str = CStr( adDate )
            Exit Function
        End If
        zDate = Left$( zDate, nIndex - 1) & Format( nYear, "0000" ) & Mid$( zDate, nIndex + 2 )
    Else
        zDate = Left$( zDate, nIndex - 1) & Format( nYear mod 100, "00" ) & Mid$( zDate, nIndex + 2 )
    End If
    If (nHour + nMinute + nSecond) > 0 Then
        zDate = zDate & " " & Format( nHour, "00" ) & ":" & Format( nMinute, "00" ) & ":" & Format( nSecond, "00" )
    End If
    vDate2Str = zDate
End Function

Function vGetPOMSDateFormat() As String
    Dim zDateFormat As String
    zDateFormat = Environ$( "CLARIFY_DATE_FORMAT" )
    If zDateFormat = "" Then
        zDateFormat = "%m/%d/%y"
    End If
    vGetPOMSDateFormat = zDateFormat
End Function

'*********************************************************************/
'Author:Youness AADISSA
'Description:  R�cuperer l'objid du lot
'*********************************************************************/
Function recupeObjiId(strContrat As String, strLot As String) As String
On Error GoTo Error_Handling

    Dim br    As New BulkRetrieve
    Dim lst    As List
    Dim rec    As record

    '--Aho RCE Lot2 : Pour �viter qu'un x_av_id_install soit non-unique en base,
    '                 l'objid du lot est recherch� avec l'id install et dans le contrat donn�
    br.SimpleQuery 0,"contract"
    br.AppendFilter 0, "id", cbEqual, strContrat
    br.TraverseFromParent 1, "contract2contr_schedule", 0
    br.AppendFilter 1,"x_av_id_install", cbequal, strLot
    br.RetrieveRecords
    Set lst = br.GetRecordList(1)
    Set rec = lst.ItemByIndex (0)
    recupeObjiId = rec.getField("objid")
    Exit Function
Error_Handling:
    TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function
