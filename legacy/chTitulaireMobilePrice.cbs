Option Explicit

'********** Variables de traitement **************************************
Dim strAcces              As String  'Acces
Dim strFixe               As String  'Fixe
Dim strMobile             As String  'Mobile


Global gbSwapDaysAndMonths  As Boolean
Global gzClarifyDateFormat  As String    ' The setting of Clarify Date format
Global strTimeStamp         As String
Declare Function vGetPOMSDateFormat() As String
Declare Sub vCheckDateFormat()
Declare Sub TRUELOG(strin As String)
Declare Sub TRUEERR(strin As String)
Declare Function date2caract (intDate As Integer)As String
Declare Function vStr2Date( ByVal azDate As String)As Date
Declare Function trim_f(strin As String,  i As integer)As string
Declare Function recupBds1(ObjidLotSource As String, index As Integer) As List
Declare Function chkContrat(strID As String) As Boolean
Declare Function chkLotCible(ObjidLotCible As String) As Boolean
Declare Function chkLots(ObjidLotSrc As String, ObjidLotCbl As String) As Boolean
Declare Function recupeObjiId(strContrat As String, strLot As String) As String
Declare Function chkExLot(strLot As String, strType As String) As Boolean
Declare Function chkExContrat(strID As String, strType As String) As Boolean
Declare Function chkContratLot(strID As String, strLot As String) As Boolean
Declare Function savedde(IdBDSSource As String, ObjidLotSource As String, ObjidLotCible As String, SdateEffet As String) As Boolean 'eel
Declare Function traitementDde(ObjidLotSource As String, ObjidLotCible As String, ObjidLigne As String, SdateEffet As String) As Boolean 'COR/EVO C16365854 : Gestion d'un changement de titulaire � la ligne
Declare Function chkCF(IdLotSource As String,IdLotCible As String,IdContratCible As String) As Boolean
Declare Function ListCodeToString1(LstTmp As List, Separateur As String) As String
Declare Function chkTerme(IdLotSource As String,IdLotCible As String) As Boolean
Declare Function ListCodeToString(LstTmp As List, Field_name As String, Separateur As String) As String
Declare Function checkChangementTituEnCours( bdssource As String) As Boolean
Declare Function checkADGEnCours(ideds As String) As Boolean
Declare Function checkOrg(strIdContratSource  As String,strIdContratCible   As String) As Boolean
Declare Function Checkbdsinterdite(IdEDSSource As String) As Boolean
Declare Function recupNomlotIdcontrat(IdEDSSource As String) As List
Declare Function checkVPNContrat(strIdContratSource,strIdContratCible) As Boolean 'AEL RCE ET4
Declare Function checkBDS2ParcDuo(strObjid  As String,strIdEDS As String) As Boolean 'IAA [MOVE ET4 V1]
' # 30-05-2017 - KKAN : COR C18284878 - D�but >
Declare Function checkBDS2ParcDuo2 (p_Objid As Long, p_contr_schedule_objid As Boolean) As Boolean
' # 30-05-2017 - KKAN : COR C18284878 - Fin >
Declare Function checkMigration(ideds As String) As Boolean 'MNA [MOVE4 V2.3]
Declare Function checkLotsSecondaires(objidLotSource As String, objidLotCible As String) As Boolean 'MNA [MOVE4 V2.3]
Declare Function GetBdsLigneToAcces(objidAcces As String) As List ''eel
Declare Function InitParamXAvCode() As Boolean  'eel parametrage
Declare Function recupeObjiIdLigne(IdLigneSource As String) As String             'COR/EVO C16365854 : Gestion d'un changement de titulaire � la ligne
Declare Function chkLotLigne(ObjidLot As String, ObjidLigne As String) As Boolean 'COR/EVO C16365854 : Gestion d'un changement de titulaire � la ligne
Declare Function changementEnCoursArticle(IdLigneSource As String) As Boolean     'COR/EVO C16365854 : Gestion d'un changement de titulaire � la ligne

Const DATE_MMDDYY   = 1
Const DATE_DDMMYY   = 2
Const DATE_YYMMDD   = 3
Const cstCVSID      = "@(#)$Id: "
Const ErrLogNo      = 3
const SUBCHMTTIT    = "chTitulaireMobilePrice"
' # 30-05-2017 - KKAN : COR C18284878 - D�but >
const CtiNonPermisPDuoA		= "Un CTI ne peut pas se lancer sur une ligne ayant une otpion parc duo active, merci de la r�silier pr�alablement."
' # 30-05-2017 - KKAN : COR C18284878 - Fin >
Dim ErrLog               As String
Dim ErrKO                As String
Dim SourceFile           As String
Dim SEPARATOR            As String
Dim strDateDebut         As String
Dim strDateFin           As String
Dim strDateFichier       As String
Dim lngErrCount          As Long
Dim lngAvrCount          As Long
Dim intSucces            As Long
Dim strmessage           As String
Dim iCountBDS1           As Integer
Type strResponse
   lnum                  As Integer
   response              As String
End Type
Dim typResponse          As strResponse
Type strResponseCutOff
    DateCutOff As String
End Type
Dim typResponseCutOff As strResponseCutOff
Dim orgDifferente As Boolean
Dim parcduo As Boolean
Dim date_effet As String '898 NRED
Sub chTitulaire (ByVal strFile As String, strDataOut As String, strLogOut As String, strLogFile As String, strValidDir As String, strDateEffet As String)
On Error GoTo ErrHandler

    Dim SourceFileNumber    As Integer
    Dim intIgnCount         As Long
    Dim nLu                 As Long
    Dim SourceFileName      As String
    Dim strTextLine         As String
    Dim dtTimeStamp         As Date
    Dim dtTimeStop          As Date
    Dim dd                  As String
    Dim mm                  As String
    Dim yyyy                As String
    Dim hh                  As String
    Dim nn                  As String
    Dim ss                  As String
    Dim strTimeStop         As String
    Dim strDateDebut        As String
    Dim strDateFichier      As String
    Dim strDateFin          As String
    Dim strIdContratSource  As String
    Dim strLotSource        As String
    Dim strIdContratCible   As String
    Dim strLotCible         As String
    Dim ObjidLotSource      As String
    Dim ObjidLotCible       As String
    Dim nbrLine             As Integer
  	Dim strDateEffetFile    As String 'eel
	Dim IdLigneSource       As String  'COR/EVO C16365854 : Gestion d'un changement de titualire � la ligne
	Dim EstLigne            As Boolean 'COR/EVO C16365854 : Gestion d'un changement de titualire � la ligne
    Dim ObjidLigneS			As String

    date_effet      = strDateEffet '898 NRED

    nLu             = 0
    lngErrCount     = 0
    intSucces       = 0
    strmessage      = ""
    SourceFileName  = strFile
	ObjidLigneS     = ""

    Call vCheckDateFormat

    strTimeStamp    = App.CurrentDate
    dtTimeStamp     = vStr2Date(strTimeStamp)
    dd              = date2caract (Day(strTimeStamp))
    mm              = date2caract (Month(strTimeStamp))
    yyyy            = CStr(Year(strTimeStamp))
    hh              = date2caract (Hour(strTimeStamp))
    nn              = date2caract (Minute (strTimeStamp))
    ss              = date2caract (Second(strTimeStamp))
    'D�termination du s�parateur
    SEPARATOR       = "|"
    strDateDebut    = dd & "/" & mm & "/" & yyyy & " � " & hh & ":" & nn & ":" & ss
    strDateFichier  = dd & mm & yyyy & hh & nn & ss
    'D�termine le nom du fichier sans son chemin
    If strFile Like "/*" Then 'Path pass� en entr�e (migration)
        SourceFile = strFile
        Dim intLettre As Integer
        For intLettre = 1 To Len(strFile)
            If Mid(strFile, Len(strFile) - intLettre, 1) <> "/" Then
                SourceFileName  = Right(strFile, intLettre + 1)
            Else
                Exit For
            End If
        Next intLettre
    Else 'Seul le nom du fichier est pass� en entr�e (Import en masse)
        SourceFile = Trim(strDataOut) & "/" & strFile
        If strFile Like "./*" Then
            SourceFileName = Right(strFile, Len(strFile) - 2)
        Else
            SourceFileName = strFile
        End If
    End If
    'Le fichier en entr�e doit respecter la nomenclature suivante :
    'Chgt_Titu_Liste_Lots_Mobile_Price_<AAAAMMJJ>_<n� s�quentiel>.ini
    If SourceFileName Like "Chgt_Titu_Liste_Lots_Mobile_Price_*" Then
    Else
        Debug.Print "FORMAT FICHIER INVALID"
        Exit Sub
    End If

    'GO :
    ErrLog = strLogOut & "/" & SourceFileName & "_" & strDateFichier & ".log"
    ErrKO = strValidDir & "/" & SourceFileName & "_" & strDateFichier & "_KO"

    Debug.Print "G�n�ration des fichiers de log :[ " & ErrLog & "]"

    Call TRUELOG("--- Date de d�but du traitement : " & Date & " - " & Time & " ---")

    SourceFileNumber = FreeFile
    ' Open source file For reading
    Open SourceFile For Input As #SourceFileNumber

    If Not InitParamXAvCode() Then  Exit Sub 'EEL parametrage

    nLu         = 0
    lngErrCount = 0
    lngAvrCount = 0
    Do While Not EOF(SourceFileNumber)
        ' Read line inTo variable strTextLine
        Line Input #SourceFileNumber, strTextLine

        strIdContratSource    = trim_f(strTextLine, 1)
        strLotSource          = trim_f(strTextLine, 2)
        strIdContratCible     = trim_f(strTextLine, 3)
        strLotCible           = trim_f(strTextLine, 4)
	    strDateEffetFile      = trim_f(strTextLine, 5) 'eel
		IdLigneSource    	  = trim_f(strTextLine, 6) 'COR/EVO C16365854 : Gestion d'un changement de titulaire � la ligne
        EstLigne = (Len(Trim(IdLigneSource)) > 0)      'COR/EVO C16365854 : Gestion d'un changement de titulaire � la ligne
		
        nLu = nLu + 1
        strmessage  = ""

        Debug.Print "--------------------------------------------------------"
        'V�rifier que les champs obligatoires sont renseign�s
        If (Len(Trim(strIdContratSource)) = 0 Or Len(Trim(strLotSource)) = 0 Or Len(Trim(strIdContratCible)) = 0 Or Len(Trim(strLotCible)) = 0) Then
            TRUELOG " ERREUR Ligne " & nLu & " : Ligne incorrecte"
            lngErrCount = lngErrCount + 1
            TRUEERR strTextLine 'Tracer ligne KO
            GOTO NEXT_LINE
        End If

        'COR/EVO C16365854 : Gestion d'un changement de titulaire � la ligne - DEBUT >
		'V�rifier que si l'identifiant de ligne est renseign�, il est au bon format
        If EstLigne Then
			If Not IsNumeric(IdLigneSource) then
				TRUELOG " ERREUR Ligne " & nLu & " : L'identifiant de la ligne doit etre un nombre"
				lngErrCount = lngErrCount + 1
				TRUEERR strTextLine 'Tracer ligne KO
				GOTO NEXT_LINE
			End If
        End If
        'COR/EVO C16365854 : Gestion d'un changement de titulaire � la ligne - FIN >

        'Verifier que le contrat cible est li� � un VPN mobile dans le cas o� le contrat source l est
        If Not checkVPNContrat(strIdContratSource,strIdContratCible) Then
            TRUELOG " ERREUR Ligne " & nLu & " : Le contrat cible n a pas de VPN Mobile "
            lngErrCount = lngErrCount + 1
            TRUEERR strTextLine 'Tracer ligne KO
            GOTO NEXT_LINE
        End If

        'v�rifier l'existance de objets
        If Not chkExContrat(strIdContratSource, "source") Or Not chkExLot(strLotSource, "source") Or Not chkExContrat(strIdContratCible, "cible") Or Not chkExLot(strLotCible, "cible") Then
            TRUELOG " ERREUR Ligne " & nLu & " : " & strmessage
            lngErrCount = lngErrCount + 1
            TRUEERR strTextLine 'Tracer ligne KO
            GOTO NEXT_LINE
        End if
        'Le contrat source n'est pas ORIAN
        If Not chkContrat(strIdContratSource) Then
            TRUELOG " ERREUR Ligne " & nLu & " : Le contrat source "& strIdContratSource &" est un contrat ORIAN"
            lngErrCount = lngErrCount + 1
            TRUEERR strTextLine 'Tracer ligne KO
            GOTO NEXT_LINE
        End if
        'Le contrat cible n'est pas ORIAN
        If Not chkContrat(strIdContratCible) Then
            TRUELOG " ERREUR Ligne " & nLu & " : Le contrat cible "& strIdContratCible &" est un contrat ORIAN"
            lngErrCount = lngErrCount + 1
            TRUEERR strTextLine 'Tracer ligne KO
            GOTO NEXT_LINE
        End if
        'v�rifier que les contrats ne sont pas identiques
        If strIdContratSource = strIdContratCible Then
            TRUELOG " ERREUR Ligne " & nLu & " : Le contrat source et le contrat cible doivent �tre diff�rents"
            lngErrCount = lngErrCount + 1
            TRUEERR strTextLine 'Tracer ligne KO
            GOTO NEXT_LINE
        End if
        'v�rifier que lots ne sont pas identiques
        If strLotSource = strLotCible Then
            TRUELOG " ERREUR Ligne " & nLu & " : Le lot source et le lot cible doivent �tre diff�rents"
            lngErrCount = lngErrCount + 1
            TRUEERR strTextLine 'Tracer ligne KO
            GOTO NEXT_LINE
        End If
        'v�rifier l'appartenance des lots aux contrats
        If chkContratLot(strIdContratSource, strLotSource) And chkContratLot(strIdContratCible, strLotCible) Then
            'r�cuperer les objid des lots
            ObjidLotSource = recupeObjiId(strIdContratSource, strLotSource)
            ObjidLotCible  = recupeObjiId(strIdContratCible, strLotCible)
        Else
            TRUELOG " ERREUR Ligne " & nLu & " : " & strmessage
            lngErrCount = lngErrCount + 1
            TRUEERR strTextLine 'Tracer ligne KO
            GOTO NEXT_LINE
        End if

        'Le lot source et le lot cible poss�dent bien le m�me triplet Famille / ligne / Offre
        If Not chkLots(ObjidLotSource, ObjidLotCible) Then
            TRUELOG " ERREUR Ligne " & nLu & " : Le lot source " & strLotSource & " et le lot cible " & strLotCible & " ne poss�dent pas le m�me triplet Famille / ligne / Offre"
            lngErrCount = lngErrCount + 1
            TRUEERR strTextLine 'Tracer ligne KO
            GOTO NEXT_LINE
        End If

        'Le lot cible poss�de bien un site de facturation
        If Not chkLotCible(ObjidLotCible) Then
            TRUELOG " ERREUR Ligne " & nLu & " : Le lot cible " & strLotCible & " ne poss�de pas un site de facturation"
            lngErrCount = lngErrCount + 1
            TRUEERR strTextLine 'Tracer ligne KO
            GOTO NEXT_LINE
        End If

        '******* Les lots sources et cibles ne sont pas des lots de lignes secondaires
        If checkLotsSecondaires(ObjidLotSource, ObjidLotCible) Then
            TRUELOG " ERREUR Ligne " & nLu & " : Le Lot source " & strLotSource & " et/ou le lot cible " & strLotCible & " sont des lots de lignes secondaires"
            lngErrCount = lngErrCount + 1
            TRUEERR strTextLine 'Tracer ligne KO
            GOTO NEXT_LINE
        End If

        'Check sur le site de facturation et d'installation du lot cible
        If Not chkCF(ObjidLotSource,ObjidLotCible,strIdContratCible) Then
            TRUELOG " ERREUR Ligne " & nLu & " : " & strmessage
            lngErrCount = lngErrCount + 1
            TRUEERR strTextLine 'Tracer ligne KO
            GOTO NEXT_LINE
        End If

		'Check si l'organisation du contrat source est diff�rente de celle du contrat cible
        If checkOrg(strIdContratSource,strIdContratCible) Then
			orgDifferente = False
			TRUELOG "L'organisation du contrat source est identique � celle du contrat cible."
        Else
			orgDifferente = True
			TRUELOG "L'organisation du contrat source est diff�rente de celle du contrat cible."
        End If

        'COR/EVO C16365854 : Gestion d'un changement de titulaire � la ligne - DEBUT >
		'V�rifications fonctionnelles concernant l'identifiant de ligne si renseign�
        If EstLigne Then
			'V�rifier si la ligne existe
			ObjidLigneS = recupeObjiIdLigne (IdLigneSource)
			If (Len(Trim(ObjidLigneS)) = 0) then
				TRUELOG " ERREUR Ligne " & nLu & " : " & strMessage
				lngErrCount = lngErrCount + 1
				TRUEERR strTextLine 'Tracer ligne KO
				GOTO NEXT_LINE
			End If
			
			'V�rifier si la ligne appartient bien au lot source sp�cifi�
			If Not chkLotLigne(ObjidLotSource, ObjidLigneS) then
				TRUELOG " ERREUR Ligne " & nLu & " : La ligne n'appartient pas au lot source"
				lngErrCount = lngErrCount + 1
				TRUEERR strTextLine 'Tracer ligne KO
				GOTO NEXT_LINE
			End If
		End If
        'COR/EVO C16365854 : Gestion d'un changement de titulaire � la ligne - FIN >

        'COR/EVO C16365854 : Gestion d'un changement de titulaire � la ligne - DEBUT >
		'Traitement de la demande pour une ligne
		If traitementDde(ObjidLotSource,ObjidLotCible,ObjidLigneS,strDateEffetFile) Then
			If EstLigne Then
				TRUELOG " Ligne " & nLu & " : Acte de changement de titulaire global sur la ligne " & IdLigneSource & " r�alis� correctement."
			Else
				TRUELOG " Ligne " & nLu & " : Acte de changement de titulaire global sur le lot " & strLotSource & " r�alis� correctement."
			End If
			intSucces = intSucces + 1
		Else
			TRUELOG " ERREUR Ligne " & nLu & " : " & strmessage
			lngErrCount = lngErrCount + 1
			TRUEERR strTextLine 'Tracer ligne KO
		End If
NEXT_LINE:
    Loop
    Debug.Print "--------------------------------------------------------"
    Call TRUELOG("--- Date de Fin du traitement : " & Date & " - " & Time & " -----")

REAL_END:

    Dim dtDureeTraitement   As Date
    ' Set the end date
    strTimeStop     = App.CurrentDate
    dtTimeStop      = CDate(strTimeStop)
    strDateFin      = Day(dtTimeStop) & "/" & Month(dtTimeStop) & "/" & Year(dtTimeStop) & " � " & Hour(dtTimeStop) & ":" & Minute (dtTimeStop) & ":" & Second(dtTimeStop)
    Dim dtFinish            As Date
    Dim dtStart             As Date
    Dim strDureeTraitement  As String

    'Calcule la dur�e du traitement : on consid�re que le traitement ne durera pas plus d'un jour. Seule la dur�e en
    'temps sera donc affich�e.
    If Hour(dtTimeStop) >= Hour(dtTimeStamp) Then
       dtFinish = TimeSerial(Hour(dtTimeStop)   ,Minute (dtTimeStop),Second(dtTimeStop))
       dtStart  = TimeSerial(Hour(dtTimeStamp)  ,Minute (dtTimeStamp),Second(dtTimeStamp))
    Else
       dtFinish = TimeSerial(24,Minute (dtTimeStop),Second(dtTimeStop)) 'Pas correct
       dtStart  = TimeSerial((Hour(dtTimeStamp) - Hour(dtTimeStop)),Minute (dtTimeStamp),Second(dtTimeStamp)) 'Pas correct
    End If

    dtDureeTraitement = Abs(dtFinish - dtStart)

    TRUELOG "                                                  "
    TRUELOG "Fichier d'entr�e : " & SourceFileName
    TRUELOG "D�but du traitement : " & strDateDebut
    TRUELOG "Nombre d'objets traites : " & nLu
    TRUELOG "Nombre d'objets en erreur: " & lngErrCount
    TRUELOG "Nombre d'avertissements : " & lngAvrCount
    TRUELOG "Nombre d'objets traites avec succes: " & intSucces
    TRUELOG "Fin du traitement : " & strDateFin
    TRUELOG "Duree du traitement : " & dtDureeTraitement
    TRUELOG "                                                  "

    Exit Sub
ErrHandler:
    TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End sub

'*********************************************************************/
'Author: Youness AADISSA
'Description: Le contrat (source/cible) n'est pas ORIAN
'Input :
'Output : Boolean
'Update:
'*********************************************************************/
Function chkContrat(strID As String) As Boolean
On Error GoTo Error_Handling

    Dim brContrat       As new BulkRetrieve
    Dim lstContrat      As List
    Dim recContrat      As Record

    brContrat.SimpleQuery  0, "contract"
    brContrat.AppendFilter 0, "id", cbEqual, strID
    'brContrat.AppendFilter 0, "x_av_o_scs", cbEqual, 0
    brContrat.RetrieveRecords
    Set lstContrat  = brContrat.getRecordList(0)
    Set recContrat  = lstContrat.itembyIndex(0)

    If lstContrat.count > 0 Then
        If recContrat.GetField("x_av_o_scs") = 0 Or recContrat.GetField("x_av_o_scs") = Null Then
            chkContrat = True
        Else
            chkContrat = False
        End If
    Else
        chkContrat = False
    End if
    Exit Function
Error_Handling:
    TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function

'*************************************************************************************************/
'Author: Youness AADISSA
'Description: Le lot source et le lot cible poss�dent bien le m�me triplet Famille / ligne /Offre
'Input :
'Output : Boolean
'Update:
'*************************************************************************************************/
Function chkLots(ObjidLotSrc As String, ObjidLotCbl As String) As Boolean
On Error GoTo Error_Handling

    Dim br            As New BulkRetrieve
    Dim lstTmp        As New List
    Dim recTmp        As Record
    Dim StrTrplLotSrc As String
    Dim StrTrplLotCbl As String
    Dim StrTrplLotSec As String

    chkLots = False

    br.SimpleQuery  0, "contr_schedule"
    br.AppendFilter 0, "objid", cbEqual, ObjidLotSrc
    br.SimpleQuery  1, "contr_schedule"
    br.AppendFilter 1, "objid", cbEqual, ObjidLotCbl
    br.RetrieveRecords

    Set lstTmp = br.getRecordList(0)
    If lstTmp.Count = 1 Then
        Set recTmp = lstTmp.ItemByIndex(0)
        StrTrplLotSrc = Trim(recTmp.getfield("x_av_family")) & "|" & Trim(recTmp.getfield("x_av_line")) & "|" & Trim(recTmp.getfield("x_av_offer"))
    Else
        Goto CleanUp
    End If

    Set lstTmp = br.getRecordList(1)
    If lstTmp.Count = 1 Then
        Set recTmp = lstTmp.ItemByIndex(0)
        StrTrplLotCbl = Trim(recTmp.getfield("x_av_family")) & "|" & Trim(recTmp.getfield("x_av_line")) & "|" & Trim(recTmp.getfield("x_av_offer"))
    Else
        Goto CleanUp
    End If

    If StrTrplLotSrc = StrTrplLotCbl Then
        chkLots = True
    End if

CleanUp:
    Set br      = Nothing
    Set lstTmp  = Nothing
    Set recTmp  = Nothing

    Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function

'*********************************************************************/
'Author: Youness AADISSA
'Description: Le lot cible poss�de bien un site de facturation
'Input :
'Output : Boolean
'Update:
'*********************************************************************/
Function chkLotCible(ObjidLotCible As String) As Boolean
On Error GoTo Error_Handling

    Dim brLot    As New Bulkretrieve
    Dim lstLot   As List

    brLot.simplequery 0, "contr_schedule"
    brLot.appendfilter 0, "objid", cbEqual, ObjidLotCible
    brLot.TraverseFromParent 1, "bill_to2site", 0
    'brLot.appendfilter 1, "x_av_o_scs", cbGreater, 0
    brLot.retrieverecords

    Set lstLot = brLot.getRecordlist(1)
    If lstLot.count > 0 Then
        chkLotCible = True
    Else
        chkLotCible = False
    End if

    Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function
'******************************************************************************************************************/
'Author: Youness AADISSA
'Description:V�rification que la Le statut d'activation de la BDS1 (champ X_AV_STATUT_ACT) est inclus dans
'            une liste param�trable. (NB : cette liste de statuts autoris�s est commune au changement de titulaire
'            . Elle est stock�e dans la table X_AV_CODE et est identifi�e par le type � LISTE_STATUT_CTI_CF �).
'Input :
'Output : List
'Update:
'******************************************************************************************************************/
Function recupBds1(ObjidLotSource As String,index As Integer) As List
On Error GoTo Error_Handling

    Dim brBds1                  As New Bulkretrieve
    Dim lstBds1                 As New List
    Dim brStatutsActivation     As new Bulkretrieve
    Dim lstStatutsActivation    As New List
    Dim recStatutsActivation    As Record
    Dim strQuery                As String
    Dim i                       As Integer
    Dim strSqlStatement         As String
    Dim toDB                    As New SQLDB
    Dim lstSiteFact             As New List
    Dim nb                      As Integer

   strQuery = "'"

   brStatutsActivation.simplequery 0, "x_av_code"
   brStatutsActivation.appendfilter 0, "x_av_type", cbequal, "LISTE_STATUT_BDS1_ACTE"
   brStatutsActivation.retrieverecords
   Set lstStatutsActivation = brStatutsActivation.getrecordlist(0)
   If lstStatutsActivation.count > 0 Then
       For i = 0 To lstStatutsActivation.Count -1
           Set recStatutsActivation = lstStatutsActivation.itembyindex(i)
           strQuery = strQuery & recStatutsActivation.getField("x_av_code") & "','"
       Next i
       strQuery = left(strQuery, Len(strQuery) -2)
   End If
   If Len(Trim(strQuery)) > 1 Then

    lstSiteFact.itemtype = "String"
    If index = 0 Then
        strSqlStatement = "SELECT tci.objid "
    Else
        strSqlStatement = "SELECT tci.x_av_id_eds "
    End If
    strSqlStatement = strSqlStatement + "FROM table_contr_itm tci, table_contr_schedule tcs, table_contract tc " &_
                     "WHERE tci.contr_itm2contr_schedule = tcs.objid " &_
                     "AND tc.objid = tcs.schedule2contract " &_
                     "AND tci.CHILD2CONTR_ITM IS  NULL " &_
                     "AND tcs.objid = " & ObjidLotSource &" " &_
                     "AND x_av_statut_act in (" & strQuery & ")"

    nb = toDB.Select(strSqlStatement, lstSiteFact)

    If nb > 0 Then
        Set lstBds1 = lstSiteFact
    End If
    End If
    Set recupBds1 = lstBds1
    Exit Function
Error_Handling:
   TRUELOG "Erreur n�" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
End Function

