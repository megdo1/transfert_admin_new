'**********************
'Ecriture fichier log
'**********************
sub TRUELOG(strin as string)
   OPEN ErrLog For Append Shared As #ErrLogNo
   Print #ErrLogNo,strin
   'debug.print strin
   Close #ErrLogNo
end sub
'> Recopiees depuis Globals_ARS_functions.cbs
'****************************************************
'* Function used to write the logs
'****************************************************
Function WriteLog(strFonction as string,strMsgCode as string,strMsgType as string, strMsgLibelle) as string
On Error GoTo ErrHandler

  'Determination du dernier message d'erreur a inscrire dans l'enregistrement de suivi
  dim intNumeroMessage as integer
  intNumeroMessage = cInt(left(strMsgCode, 2)) 'Les deux premiers numeros du code de message
                                                     ' indiquent le niveau d'importance du message
  if intNumeroMessage > 30 and intNumeroMessage < 60 then 'Warning = 35 ; Fatal = 40 ; 60 = Suivi
    if intNumeroMessage > intDernNumErreur then 'Le premier numero le plus important
                                                            ' est conserve (message le plus explicite)
      strDernMessageErreur = strMsgLibelle
      intDernNumErreur = intNumeroMessage
    End if
  End if
  WriteLog = CreateLogMsg(strFonction, strMsgCode, strMsgType, strMsgLibelle)
  Exit function

ErrHandler:
  debug.print "Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description
End Function

