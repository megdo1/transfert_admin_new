End Type


'****************************************************
'* Main Sub called.
'* Will call different Subs depending on the type
'* of Records that are To be treated
'****************************************************
Sub MainChmtCF (strLogOut As String)

'debug.print "Debut traitement" 'Trace

On Error GoTo ErrHandler
  Dim strDate         As String
  Dim strTime         As String
  Dim nLu             As Long
  Dim i               As Integer
  Dim dd              As String
  Dim mm              As String
  Dim yyyy            As String
  Dim hh              As String
  Dim nn              As String
  Dim ss              As String
  Dim strDateDebut    As String
  Dim strDateFichier  As String
  Dim strDateFin      As String
  Dim strTimeStop     As String
  Dim logOK           As Boolean
  Dim existsErr       As Boolean
  Dim dtTimeStamp     As Date
  Dim dtTimeStop      As Date

  Dim strDate3        As String
  Dim strDate2        As String
  Dim dtDate2         As Date
  Dim dtDate3         As Date

  Dim lstBdsP         As New List
  Dim RecBdsP         As Record

  existsErr = false
  logOK = false
  bolSuivi = false
  lngWarnCount = 0
  intSucces = 0
  nLu = 0

  Call Initialize_constants("chmt_cf.cbs", cstCVSID)

  ' ****************** Set the execution date
  Call vCheckDateFormat
  dtTimeStamp = Now()

  mm = date2caract (Month(dtTimeStamp))
  dd = date2caract (Day(dtTimeStamp))
  yyyy = cStr (Year(dtTimeStamp))
  hh = date2caract (Hour(dtTimeStamp))
  nn = date2caract (Minute (dtTimeStamp))
  ss = date2caract (Second(dtTimeStamp))

  strDateDebut = dd & gcstCOMVarSLASH & mm & gcstCOMVarSLASH & yyyy & " à " & hh & ":" & nn & ":" & ss
  strDateFichier = dd & mm & yyyy

  strDate = dd & gcstCOMVarSLASH & mm & gcstCOMVarSLASH & yyyy
  strTime = CStr(format(Time$,"short time"))

  ' ErrLog : chmt_cf_ddmmyyyy.log
  ErrLog = strLogOut & gcstCOMVarSLASH & SourceFileName & gcstCOMVarUNDERSCORE & strDateFichier & ".log"

  ' OpenLogFile
  OPEN ErrLog For APPEND As #ErrLogNo
  Close #ErrLogNo
  call GetGFilename(ErrLog)

  logOK = true
  debug.print "Generation du fichier de log :[" & ErrLog & "]"

  dtDate2  = DateAdd(gcstCOMVarD, 1, App.Currentdate)
  dtDate3  = App.CurrentDate
  strDate2 = date2caract(Day(dtDate2)) & gcstCOMVarSLASH & date2caract(Month(dtDate2)) & gcstCOMVarSLASH & cStr(Year(dtDate2))
  strDate3 = date2caract(Day(dtDate3)) & gcstCOMVarSLASH & date2caract(Month(dtDate3)) & gcstCOMVarSLASH & cStr(Year(dtDate3))

  '>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  ' chercher dans la table_x_av_suivi_chmt_cf pour tout les demandes à traiter
  ' dont la date d'effet egale à la date du jour
  Dim br As New BulkRetrieve
  Dim lstSuivi As List
  Dim lstSuiviAd As List
  Dim recSuivi As Record
  Dim recBds As Record
  Dim mssg As String
  Dim lstSuiviP As List
  Dim lstTyp As New List

  lstTyp.ItemType = gcstCOMVarSTRING
  lstTyp.AppendItem cstChangementPayeur, cstChangementTitulaire

  br.Clear
  br.SimpleQuery  0, SUIVICHMTCF
  br.AppendFilter 0, gcstCOMVarSTATUSAV, cbEqual, gcstStatutDemProformaAtraiter
  br.AppendFilter 0, gcstCOMVarAVTYPE, cbNotEqual, cstChangementPayeur
  br.AppendFilter 0, gcstCOMVarAVTYPE, cbNotEqual, cstChangementTitulaire
  br.AppendFilter 0, gcstCOMVarAVTYPE, cbNotEqual, cstTransfertAdminmove
  br.AppendFilter 0, "x_av_date_effet", cbLessOrEqual, strDate
  br.SimpleQuery  1, SUIVICHMTCF
  br.AppendFilter 1, gcstCOMVarSTATUSAV, cbEqual, gcstStatutDemProformaAtraiter
  br.AppendFilter 1, gcstCOMVarAVTYPE, cbIn, lstTyp
  br.AppendFilter 1, "x_av_date_effet", cbLessOrEqual, strDate2
  br.SimpleQuery  2, SUIVICHMTCF
  br.AppendFilter 2, gcstCOMVarSTATUSAV, cbEqual, gcstStatutDemProformaAtraiter
  br.AppendFilter 2, gcstCOMVarAVTYPE, cbEqual, cstTransfertAdminmove
  br.AppendFilter 2, "x_av_date_effet", cbLessOrEqual, strDate2
  br.AppendFilter 2, "x_av_acces_cible", cbNotEqual, ""
  br.RetrieveRecords

  Set lstSuivi  = br.GetRecordList(0)
  Set lstSuiviP = br.GetRecordList(1)
  Set lstSuiviAd = br.GetRecordList(2)
  ' aucune demande a été trouvée
  If lstSuivi.Count + lstSuiviP.Count + lstSuiviAd.Count  <= 0 Then
    GoTo FinalEnd
  End If
  '<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

  debug.print lstSuivi.Count + lstSuiviP.Count + lstSuiviAd.Count & " lignes à traiter."

  If Not InitParamXAvCode() Then GoTo FinalEnd

  'Cas Transfert Administratif & Structure Fact
  For i = 0 To lstSuivi.Count - 1
    Set recSuivi = lstSuivi.ItemByIndex(i)
    Call ChmtCF(recSuivi.GetField(gcstCOMVarObjid))
    nLu = nLu + 1
  Next i

  'Cas Changement Payeur & Changement Titulaire - BDS Price
  For i = 0 To lstSuiviP.Count - 1
      Set recSuivi = lstSuiviP.ItemByIndex(i)

      br.Clear
      br.SimpleQuery  0, gcstCOMVarContrItm
      br.AppendFilter 0, gcstCOMVarObjid, cbEqual, recSuivi.GetField("x_av_focus_id")
      br.RetrieveRecords
      Set lstBdsP = br.GetRecordList(0)
      Set RecBdsP = lstBdsP.ItemByIndex(0)

      If RecBdsP.GetField("x_av_type_article") = "1" Then
          'AEL : Move4.2.3 MSIM
          ' Traiter les lignes secondaires MSIM
          Call ChmtCFBdsPrincipal(recSuivi.GetField(gcstCOMVarObjid))
      End If

      'Traiter les lignes mobiles standard, les accès et lignes principales MSIM
      Call ChmtCFPrice(recSuivi.GetField(gcstCOMVarObjid))

      If RecBdsP.GetField("x_av_categorie") = strAcces Then
          'IAD Move5.1 : Traiter selon la Catégorie
          ' Cas d'un accès : créer des demandes pour les lignes qui y sont rattachées
          ' Les demandes des lignes doivent être traitées après celle de l'accès (lien x_av_itm2acces)
          Call ChmtCFAccesFull(recSuivi.GetField(gcstCOMVarObjid), RecBdsP.GetField(gcstCOMVarObjid))
      End If

      nLu = nLu + 1
  Next i

  'Cas Transfert Administratif Move
  For i = 0 To lstSuiviAd.Count - 1
      Set recSuivi = lstSuiviAd.ItemByIndex(i)

      'MOU : si c'est un accès, on traite d'abord les lignes fixes rattachées à cet accès
      br.Clear
      br.SimpleQuery  0, gcstCOMVarContrItm
      br.AppendFilter 0, gcstCOMVarObjid, cbEqual, recSuivi.GetField("x_av_focus_id")
      br.RetrieveRecords
      Set lstBdsP = br.GetRecordList(0)
      Set RecBdsP = lstBdsP.ItemByIndex(0)

      If RecBdsP.GetField("x_av_categorie") = strAcces Then
          ' Cas d'un accès : créer des demandes pour les lignes qui y sont rattachées
          Call ChmtAdminAccesFull(recSuivi.GetField(gcstCOMVarObjid))
      End If

      'Traiter les demandes sur les lignes fixes et accès
      Call ChmtAdminMove(recSuivi.GetField(gcstCOMVarObjid))
      nLu = nLu + 1
  Next i


FinalEnd:

	if existsErr then Close #ErrFileNumber
		if bolSuivi = false then 'Pas encore commence a traiter les enregistrements
			TRUELOG WriteLog(SUBMAINCHMTCF,"15090109",Info, "Aucun changement n'a ete traité.")
		else if (bolSuivi = true and Len(recSuivi.GetField("x_av_id_contract_cible")) > 0) Then
				Dim lstCtr As List
				Dim RecCtr As Record
				Dim bsSave      As New BulkSave

				br.Clear
				br.SimpleQuery  0, gcstCOMVarContract
				br.AppendFilter 0, gcstCOMVarID, cbEqual, recSuivi.GetField("x_av_id_contract_cible")
				br.RetrieveRecords
				Set lstCtr = br.GetRecordList(0)
				Set RecCtr = lstCtr.ItemByIndex(0)
				If RecCtr.GetField("x_av_current_version") <> RecCtr.GetField("x_av_last_validated") Then
					RecCtr.SetField "x_av_last_validated", RecCtr.GetField("x_av_current_version")
					bsSave.UpdateRecord RecCtr
					bsSave.Save
				End If
		End If
	End If

      Set br        = Nothing
      Set lstSuivi  = Nothing
      Set recSuivi  = Nothing
      Set lstSuiviP = Nothing
      Set lstTyp    = Nothing
      Set lstBdsP   = Nothing
      Set RecBdsP   = Nothing
      
  strTimeStop = App.CurrentDate
  dtTimeStop = Now()
  strDateFin = date2caract(Day(dtTimeStop)) & gcstCOMVarSLASH & date2caract(Month(dtTimeStop)) & _
  gcstCOMVarSLASH & date2caract(Year(dtTimeStop)) & " à " & _
  date2caract(Hour(dtTimeStop)) & ":" & date2caract(Minute (dtTimeStop)) & ":" & date2caract(Second(dtTimeStop))
  Dim dtFinish As date
  Dim dtStart As date
  Dim strDureeTraitement As String
  'Calcule la duree du traitement : on considere que le traitement ne durera pas plus d'un jour. Seule la duree en
  'temps sera donc affichee.

  if Hour(dtTimeStop) >= Hour(dtTimeStamp) then
    dtFinish = TimeSerial(Hour(dtTimeStop),Minute (dtTimeStop),Second(dtTimeStop))
    dtStart = TimeSerial(Hour(dtTimeStamp),Minute (dtTimeStamp),Second(dtTimeStamp))
  else
    dtFinish = TimeSerial(24,Minute (dtTimeStop),Second(dtTimeStop)) 'Pas correct
    dtStart = TimeSerial((Hour(dtTimeStamp) - Hour(dtTimeStop)),Minute (dtTimeStamp),Second(dtTimeStamp)) 'Pas correct
  End if

  Dim dtDureeTraitement As date
  dtDureeTraitement = Abs(dtFinish - dtStart)

  TRUELOG WriteLog(SUBMAINCHMTCF,"60090020",SUIVI, "Debut du traitement : " & strDateDebut)
  TRUELOG WriteLog(SUBMAINCHMTCF,"60090030",SUIVI, "Nombre d'objets traites : " & nLu)
  TRUELOG WriteLog(SUBMAINCHMTCF,"60090050",SUIVI, "Nombre d'objets en erreur: " & lngErrCount)
  TRUELOG WriteLog(SUBMAINCHMTCF,"60090060",SUIVI, "Nombre d'objets traites avec succes: " & intSucces)
  TRUELOG WriteLog(SUBMAINCHMTCF,"60090040",SUIVI, "Nombre d'avertissements : " & lngWarnCount)
  TRUELOG WriteLog(SUBMAINCHMTCF,"60090080",SUIVI, "Fin du traitement : " & strDateFin)
  TRUELOG WriteLog(SUBMAINCHMTCF,"60090090",SUIVI, "Duree du traitement : " & dtDureeTraitement)

  TRUELOG "                                                                                                                                                                                                            " 'Ligne vide pour laisser le

Exit Sub
ErrHandler:
  if logOK = false then
    debug.print "Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
  Else
    TRUELOG WriteLog(SUBMAINCHMTCF,"40090001",Fatal, "Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description)
    logOK = false 'L'erreur suivante ne doit pas rentrer dans cette condition sinon,
                              ' on sera dans une boucle infinie
    GoTo FinalEnd
  End if
End Sub

Sub EnErreur(lobjidSuivi As Long, mssg As String)
  Dim recSuivi As Record
  Dim br As New BulkRetrieve
  Dim bs As New BulkSave
  Dim lstSuivi As List

  br.SimpleQuery 0, SUIVICHMTCF
  br.AppendFilter 0, gcstCOMVarObjid, cbEqual, lobjidSuivi
  br.RetrieveRecords

  Set lstSuivi = br.GetRecordList(0)
  Set recSuivi = lstSuivi.ItemByIndex(0)

  recSuivi.SetField "x_av_lib_etat", mssg
  recSuivi.SetField gcstCOMVarSTATUSAV, "En erreur"

    recSuivi.SetField "x_av_arb_status", ""
    recSuivi.SetField "x_av_lib_etat_arb", ""

  bs.UpdateRecord recSuivi
  bs.Save

  TRUELOG WriteLog(SUBCHMTCF,"35091485",Warn,"objid: " & lobjidSuivi & "  " & mssg)
  debug.print mssg
  lngWarnCount = lngWarnCount + 1

  Set recSuivi = Nothing
  Set br = Nothing
  Set bs = Nothing
  Set lstSuivi = Nothing

End Sub

Sub ChmtCF(lobjidSuivi As Long)
On Error GoTo ErrorHandling
    Dim br As New BulkRetrieve
    Dim brOld As New BulkRetrieve
    Dim bs As New BulkSave
    Dim blsSave As New BulkSave
    Dim blsSave2 As New BulkSave
    Dim blsCUCF3 As New BulkSave
    Dim bSaveRollBack As New BulkSave
    Dim blsCUCF As New BulkSave
    Dim blsSave3 As New BulkSave
    Dim recOldCF As Record
    Dim recOldCU As Record
    Dim recSuivi As Record
    Dim recPArtNum As New Record
    Dim recArbor As New Record
    Dim rtemp As Record
    Dim recIDStocheck   As Record
    Dim recArborOrder As New Record
    Dim recArtCUCF As Record
    Dim recSchedule As Record
    Dim recSite As New Record
    Dim recArt As New Record
    Dim recContrat As Record
    Dim recNewCF As Record
    Dim recNewCU As Record
    Dim recLI As Record
    Dim lstLI As List
    Dim lstCF As List
    Dim lstCU As List
    Dim lstParameters As New List
    Dim lstContrat As List
    Dim lstOld As List
    Dim lstSuivi As List
    Dim lstArbor As  List
    Dim lstArborOld As  List
    Dim lstArbor2 As  List
    Dim lstDummy As New List
    Dim lstIDStocheck   As List
    Dim lstIDStocheck2  As List
    Dim lstSchedules As New List
    Dim lstArtCUCFArborToDo As New List
    Dim lstArtCUCFToDo As New List
    Dim lstArborOrder As New List
    Dim lstArborOrder2 As New List
    Dim lstArborOrder2NRC As New List
    Dim lstPN As New List
    Dim lstArtCUCFArbor As New List
    Dim lstArtCUCF As New List
    Dim ordList As List
    Dim lstTemp As List
    Dim lstPArtNum As New list
    Dim lobjidBdS As Long
    Dim OldCF As Long
    Dim OldCU As Long
    Dim strib As String
    Dim mssg As String
    Dim SqlStatement As String
    Dim z As Integer
    Dim i As Integer
    Dim intModSched As Integer
    Dim intTotSched As Integer
    Dim blnDummy As Boolean
    Dim toDB As New SQLDB
    Dim typResponse As ResString
    Dim recArtToCheck As Record
    dim demain as date
    dim strdemain as string

    debug.print "Traitement de la ligne de suivi : " & lobjidSuivi

    br.SimpleQuery 0, SUIVICHMTCF
    br.AppendFilter 0, gcstCOMVarObjid, cbEqual, lobjidSuivi
    br.RetrieveRecords

    Set lstSuivi = br.GetRecordList(0)
    Set recSuivi = lstSuivi.ItemByIndex(0)

    ''''''''''''
    ' verification des données du Record x_av_suivi_chmt_cf
    ''''''''''''
    if recSuivi.GetField(gcstCOMVarAVTYPE) = StrucFact then
        if recSuivi.GetField(gcstCOMVarAVACTION) = Decent then
            if recSuivi.GetField ("x_av_cf_cible") <> recSuivi.GetField ("x_av_cu_cible") then
                mssg = cstSuiviWarn & gcstPDCHistoriqueModifCFDecentr
                Call EnErreur(lobjidSuivi, mssg)
                lngErrCount = lngErrCount+1
                GoTo Cleanup1
            end if
        elseif recSuivi.GetField(gcstCOMVarAVACTION) <> Centra and recSuivi.GetField(gcstCOMVarAVACTION) <> Regroup then
            mssg = cstSuiviWarn & StrucFact
            Call EnErreur(lobjidSuivi, mssg)
            lngErrCount = lngErrCount+1
            GoTo Cleanup1
        end if
    elseif recSuivi.GetField(gcstCOMVarAVTYPE) <> TransAdm then
        mssg = cstSuiviWarn & "le champ type est incorrecte"
        Call EnErreur(lobjidSuivi, mssg)
        lngErrCount = lngErrCount+1
        GoTo Cleanup1
    end if

    br.Clear
    br.SimpleQuery 0,gcstCOMVarContract
    br.AppendFilter 0, gcstCOMVarID, cbEqual, recSuivi.GetField ("x_av_id_contract")
    br.SimpleQuery 1,gcstCOMVarSite
    br.AppendFilter 1, gcstCOMVarSITEID, cbEqual, recSuivi.GetField ("x_av_cf_cible")
    br.AppendFilter 1, gcstCOMVarObjid, cbnotequal, -2
    br.SimpleQuery 2,gcstCOMVarSite
    br.AppendFilter 2, gcstCOMVarSITEID, cbEqual, recSuivi.GetField ("x_av_cu_cible")
    br.AppendFilter 2, gcstCOMVarObjid, cbnotequal, -2

    br.RetrieveRecords

    Set lstContrat = br.GetRecordList(0)
    Set recContrat = lstContrat.ItemByIndex(0)
    Set lstCF = br.GetRecordList(1)
    if lstCF.Count <> 1 then
        mssg = cstSuiviWarn & "CF cible"
        Call EnErreur(lobjidSuivi, mssg)
        lngErrCount = lngErrCount+1
        GoTo Cleanup1
    end if
    Set recNewCF = lstCF.ItemByIndex(0)
    Set lstCU = br.GetRecordList(2)
    if lstCU.Count <> 1 then
        mssg = cstSuiviWarn & "CU cible"
        Call EnErreur(lobjidSuivi, mssg)
        lngErrCount = lngErrCount+1
        GoTo Cleanup1
    end if
    Set recNewCU = lstCU.ItemByIndex(0)


    '''''''''''''''''''
    ' verification du CF
    '''''''''''''''''''
    lstParameters.Clear
    lstParameters.ItemType  =gstrCOMVarVARIANT
    lstParameters.AppendItem recNewCF.GetField(gcstCOMVarObjid), recNewCU.GetField(gcstCOMVarObjid), recContrat.GetField(gcstCOMVarObjid)
    toDB.ExecuteProc "sa.verif_cf", lstParameters,typResponse
    If typResponse.response <> gcstCOMVarVide Then
        Call EnErreur(lobjidSuivi, typResponse.response)
        lngErrCount = lngErrCount+1
        GoTo Cleanup1
    End If

    lobjidBdS = recSuivi.GetField("x_av_focus_id")

    ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
    ''''''''''''''''''' Calcul RIB
    ''''''''''''''''''' [06PPUMA_10_F02] 'Si le CF a un champs RIB neuf cegetel vide,
    ''''''''''''''''''' ce champs est calculé comme à la validation d'un contrat
    ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
    IF recNewCF.GetField("x_av_rib_neufcegetel") = gcstPDCSelectionner OR recNewCF.GetField("x_av_rib_neufcegetel") = gcstCOMVarVide  THEN
        If CalculRIb(recNewCF, strib) Then
            recNewCF.SetField "x_av_rib_neufcegetel", strib
            bs.updateRecord recNewCF
            bs.Save
        Else
            Call EnErreur(lobjidSuivi, strib)
        END IF
    END IF

    '>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
    ' traitement Transfert administratif
    if recSuivi.GetField(gcstCOMVarAVTYPE) = TransAdm then
        br.Clear
        br.simplequery 0, gcstCOMVarContrItm
        br.appendfilter 0, gcstCOMVarObjid, cbequal, lObjidBdS
        br.traversefromparent 1, "contr_itm2mod_level", 0
        br.traversefromparent 2, "part_info2part_num", 1
        br.appendfilter 2, "active", cbequal, "Active"
        br.retrieverecords

        Set lstPartNum = br.getrecordlist(2)

        If lstPartNum.Count = 1 Then
            Set recPartnum = lstPArtNum.ItemByIndex(0)
        Else
			'debug.print "AucunArt 1"
            mssg = AucunArt
            Call EnErreur(lobjidSuivi, mssg)
            lngErrCount = lngErrCount+1
            GoTo Cleanup1
        End If

        lstParameters.Clear
        lstParameters.ItemType =gstrCOMVarVARIANT
        lstParameters.AppendItem lobjidBdS
        toDB.ExecuteProc "sa.proc_verif_statut_chmt_cf", lstParameters,typResponse
        If typResponse.response <> gcstCOMVarVide Then
            Call EnErreur(lobjidSuivi, typResponse.response)
            lngErrCount = lngErrCount+1
            GoTo Cleanup1
        End If

        brOld.SimpleQuery 0, gcstCOMVarContrItm
        brOld.AppendFilter 0, gcstCOMVarObjid, cbEqual , lobjidBdS
        brOld.AppendFilter 0, "x_av_statut_act", cbnotequal, "Résilié"
        brOld.traversefromparent 1, gcstCOMVarAVUSEDBY2SITE, 0
        brOld.traversefromparent 2, gcstCOMVarAVBILLTO2SITE, 0
        brOld.RetrieveRecords

        Set lstLI = brOld.GetRecordList(0)
        if lstLI.Count < 1 then
			'debug.print "AucunArt 2"
            mssg = AucunArt
            Call EnErreur(lobjidSuivi, mssg)
            lngErrCount = lngErrCount+1
            GoTo Cleanup1
        end if
        Set recLI = lstLI.ItemByIndex(0)

        Set lstOld = brOld.GetRecordList(1)
        if lstOld.Count < 1 then
            OldCU = 0
        else
            Set recOldCU = lstOld.ItemByIndex(0)
            OldCU = recOldCU.GetField(gcstCOMVarObjid)
        end if
        Set lstOld = brOld.GetRecordList(2)
        if lstOld.Count < 1 then
            OldCF = 0
        else
            Set recOldCF = lstOld.ItemByIndex(0)
            OldCF = recOldCF.GetField(gcstCOMVarObjid)
        end if

        IF recPartNum.GetField(gcstCOMVarAVTYPE) = "REMCF" THEN
            br.Clear
            br.simplequery 0,   gcstCOMVarSite
            br.appendfilter 0, gcstCOMVarObjid, cbequal, recNewCF.GetField(gcstCOMVarObjid)
            br.traversefromparent 1, "x_av_site2mtm_hq", 0
            br.retrieverecords
            dim lst1 as list
            set lst1 = br.getrecordlist(1)
            if lst1.count > 0  then
                mssg = cstSuiviWarn & "Le CF sélectionné appartient déjà à un groupe HQ !"
                Call EnErreur(lobjidSuivi, mssg)
                lngErrCount = lngErrCount+1
                GoTo Cleanup1
            END IF
            set lst1 = nothing
        END IF

        ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
        '''''''''''Détermination des LineItems à Résilier
        ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
        If recPartNum.GetField(gcstCOMVarAVGENSI) = 1 Then
            br.Clear
            br.Simplequery 0, gcstCOMVarContrItm
            if recLI.GetField(gcstCOMVarAVIDS) <> "" then
                br.Appendfilter 0, gcstCOMVarAVIDS,cbequal,recLI.GetField(gcstCOMVarAVIDS)
                br.AppendFilter 0, gcstCOMVarAVSTATUS, cbequal, gcstCOMArticleArbStatusFactTraité
                br.traversefromparent 1, "contr_itm2mod_level", 0
                br.traversefromparent 2, "part_info2part_num", 1
                br.Appendfilter 2, gcstCOMVarAVTYPE, cbnotequal, gcstPDCConCadTypNRC
                br.traversefromparent 3, "part_num2mod_level", 2
                br.traversefromparent 4, "part_info2contr_itm",3
                br.Appendfilter 4, gcstCOMVarAVIDS,cbequal,recLI.GetField(gcstCOMVarAVIDS)
                br.AppendFilter 4, gcstCOMVarAVSTATUS, cbequal, gcstCOMArticleArbStatusFactTraité
                br.retrieverecords

                Set lstARbor = br.getrecordlist(0)
                Set lstARborOld = br.getrecordlist(0, cbbyValue)
                Set lstArbor2 = br.getrecordlist(4)
            else
                mssg = cstSuiviWarn & "L'article ne contient pas un IDS valable."
                Call EnErreur(lobjidSuivi, mssg)
                lngErrCount = lngErrCount+1
                GoTo Cleanup1
            end if

        'tous les LI portant la même service instance et dont le statut est à Facturé - Transmis doivent avoir leur évenement dans x_av_c3a _events effacé
        ElseIf recPArtNum.GetField(gcstCOMVarAVPARTPROVLEVEL) = "CF" Then
            br.Clear
            br.Simplequery 0, gcstCOMVarContrItm
            br.Appendfilter 0, gcstCOMVarObjid,cbequal,lobjidBdS
            br.AppendFilter 0, gcstCOMVarAVSTATUS, cbequal, gcstCOMArticleArbStatusFactTraité
            br.traversefromparent 1, "contr_itm2mod_level", 0
            br.traversefromparent 2, "part_info2part_num", 1
            br.Appendfilter 2, gcstCOMVarAVTYPE, cbnotequal, gcstPDCConCadTypNRC
            br.traversefromparent 3, "part_num2mod_level", 2
            br.traversefromparent 4, "part_info2contr_itm", 3
            br.Appendfilter 4, gcstCOMVarObjid,cbequal,lobjidBdS
            br.AppendFilter 4, gcstCOMVarAVSTATUS, cbequal, gcstCOMArticleArbStatusFactTraité
            br.retrieverecords

            Set lstARbor = br.getrecordlist(0)
            Set lstARborOld = br.getrecordlist(0, cbByValue)
            Set lstArbor2 = br.getrecordlist(4)
        End If

        'Setter la date de début de facturation à Demain et la date de fin de facturation à aujourd'hui

'MAT JIRA 2587 : Ne plus "jouer" avec les dates de facturation des BdS facturables >
'        demain = DateAdd(gcstCOMVarD, 1, app.currentdate)
'        strdemain = Day(demain) & gcstCOMVarSLASH & Month(demain) & gcstCOMVarSLASH & Year(demain)
'        strdemain = strdemain & " " & time()

'        For i = 0 To lstARbor.Count -1
'            Set recArbor = lstArbor.ItemByIndex(i)
'            recArbor.SetField gcstCOMVarCHGSTARTDT, strdemain
'            recArbor.SetField gcstCOMVarCHGENDDT, strdemain
'            lstArbor.ReplaceByIndex i, recArbor
'            blsCUCF.UpdateRecord recArbor
'        Next i
'        blsCUCF.Save
'MAT JIRA 2587 : Ne plus "jouer" avec les dates de facturation des BdS facturables <

        'Appel de résiliation Arbor
		if (lstARbor.count > 0) then
			'debug.print "Etape 1"
			Call RepliqueArborInterface ( blsSave, 5, -1 , 3, lstARbor, 0 )
		end if
		
        'Appel de création Arbor
        'Début correction Ano 2447 DKH
		if (lstARbor2.count > 0) then
			'debug.print "Etape 2"
			Call RepliqueArborInterface ( blsSave2, 5, -1 , 1, lstARbor2, 0 )
		end if
        'Fin correction Ano 2447 DKH

'MAT JIRA 2587 : Ne plus "jouer" avec les dates de facturation des BdS facturables >
        'Remettre les dates de facturation en l'état
'        Set recArbor = New Record

'        For i = 0 To lstARborOld.Count -1
'            Set recArbor = lstArborOld.ItemByIndex(i)
'            recArbor.Setfield "last_mod_dt",app.currentdate
'            IF left(recArbor.GetField(gcstCOMVarCHGSTARTDT),5) = gcstPDCConCadDateVide then
'                 recArbor.Setfield gcstCOMVarCHGSTARTDT,gcstCOMDtNulle
'            else
'                recArbor.Setfield gcstCOMVarCHGSTARTDT,recArbor.GetField(gcstCOMVarCHGSTARTDT)
'            end if
'            IF left(recArbor.GetField(gcstCOMVarCHGENDDT),5) = gcstPDCConCadDateVide then
'                recArbor.Setfield gcstCOMVarCHGENDDT, gcstCOMDtNulle
'            else
'                recArbor.Setfield gcstCOMVarCHGENDDT,recArbor.GetField(gcstCOMVarCHGENDDT)
'            end if
'            blsCUCF3.UpdateRecord recArbor
'        Next i
'MAT JIRA 2587 : Ne plus "jouer" avec les dates de facturation des BdS facturables <

        ''''''''''''''''''Mise à jour du CU et du CF
        if recPArtNum.GetField(gcstCOMVarAVTYPE) <> gcstPDCConCadTypNRC then
            blsCUCF3.RelateRecords recLI, recNewCU, gcstCOMVarAVUSEDBY2SITE
            blsCUCF3.RelateRecords recLI, recNewCF, gcstCOMVarAVBILLTO2SITE
            blsCUCF3.UpdateRecord recLI
        end if
        blsCUCF3.Save

        ''''''''''''''''''Création des éléments historiques correspondant
        'recNewCU : Record du nouveau CU
        'recNewCF : Record du nouveau CF
        'recOldCU : Record de l'ancien CU
        'recOldCF : Record de l'ancien CF

        lstDummy.ItemType = gcstCOMVarRECORD
        lstDummy.AppendItem recLI
        If (recNewCU.GetField(gcstCOMVarObjid) <> OldCU) and Not (recNewCF.GetField(gcstCOMVarObjid) <> OldCF) Then 'le CU a été modifié
            blnDummy = Version_inf202(gcstPDCHistoriqueModifCU, _
                        lstdummy, _
                        cstr(OldCU), _
                        cstr(recNewCU.GetField(gcstCOMVarObjid)))
        End If
        If (recNewCF.GetField(gcstCOMVarObjid) <> OldCF) and Not (recNewCU.GetField(gcstCOMVarObjid) <> OldCU) Then 'le CF a été modifié
            blnDummy = Version_inf202(gcstPDCHistoriqueModifCF, _
                        lstDummy, _
                        cstr(OldCF), _
                        cstr(recNewCF.GetField(gcstCOMVarObjid)))
        End If
        '953
        If (recNewCF.GetField(gcstCOMVarObjid) <> OldCF) and (recNewCU.GetField(gcstCOMVarObjid) <> OldCU) Then 'le CF et CU ont été modifié
            blnDummy = Version_inf202(gcstPDCHistoriqueModifCU, _
                        lstDummy, _
                        cstr(OldCF & "/" & OldCU), _
                        cstr(recNewCF.GetField(gcstCOMVarObjid) & "/" & recNewCU.GetField(gcstCOMVarObjid)))
        End If

    br.Clear
    br.SimpleQuery 0, gcstCOMVarContrItm
    br.AppendFilter 0, gcstCOMVarObjid, cbequal, recLI.GetField(gcstCOMVarObjid)
    br.TraverseFromParent 1, "contr_itm2contr_schedule", 0
    br.AppendFilter 1, gcstCOMVarSCHEDULEID, cbNotLike, "%RCS*%"
    br.AppendFilter 1, "x_av_status", cbnotequal, "Résilié"
    br.RetrieveRecords
    Set lstSchedules = br.GetRecordList(1)

    end if

    ' traitement Transfert administratif
    '<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

    Dim lstTemp3 as list
    Set lstTemp3 = FloEdi() 'YZA ITEM 810

    '>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
    ' traitement Structure Fact
    if recSuivi.GetField(gcstCOMVarAVTYPE) = StrucFact then
        '****************************************
        '* Détermination des Listes lstArtCUCFArbor et lstArtCUCF
        '****************************************

        lstArtCUCFArbor.ItemType = gcstCOMVarRecord
        lstArtCUCF.ItemType = gcstCOMVarRecord
        IF recNewCF.GetField(gstrCOMVarAVJURIDICTION) <>gcstPDCSelectionner and recNewCF.GetField(gstrCOMVarAVJURIDICTION) <> "" and recSuivi.GetField(gcstCOMVarAVACTION) <> Decent  THEN
            Set ordList = New List
            ordList.ItemType = gcstCOMVarLONG

            SqlStatement = " select table_contr_itm.Objid " & _
            " from table_N_AttributeValue, table_N_Properties, table_N_Attribute " & _
            " ,table_contr_itm , table_contr_schedule,table_mod_level,table_part_num " & _
            " where table_N_Properties.objid = table_N_AttributeValue.x_av_value2N_Properties " & _
            " AND table_N_Attribute.objid = table_N_Properties.n_propts2N_Attribute " & _
            " and table_N_Properties.x_av_cross_ref = 'MP_JURIDICTION' " & _
            " AND table_N_AttributeValue.N_StringVALUE = '" & recNewCF.GetField(gstrCOMVarAVJURIDICTION) & "' " & _
            " and table_contr_itm.objid = table_N_AttributeValue.N_FocusLowid " & _
            " and table_contr_itm.x_av_used_by2site=" & cstr(recNewCU.GetField(gcstCOMVarObjid)) & " " &   _
            " and table_contr_schedule.objid = table_contr_itm.contr_itm2contr_schedule " & _
            " and table_contr_schedule.schedule2contract = " & cstr(recContrat.GetField(gcstCOMVarObjid)) & " " &   _
            " and table_mod_level.objid = table_contr_itm.contr_itm2mod_level " & _
            " and table_mod_level.part_info2part_num = table_part_num.objid " & _
            " and table_part_num.x_av_cross_ref = '" & gcstCROSSREF_MP_USG_JURIDICTION & "' " & _
            " and table_contr_schedule.SCHEDULE_ID not in (select distinct cs.SCHEDULE_ID from table_contr_itm itm " & _
            " inner join table_contr_schedule cs on itm.CONTR_ITM2CONTR_SCHEDULE = cs.objid " & _
            " where upper(itm.X_AV_STATUT_ACT) = 'A MIGRER PHOENIX' and itm.X_AV_USED_BY2SITE = " & cstr(recNewCU.GetField(gcstCOMVarObjid)) & ") " 

            if lstTemp3.count = 3 then
                SqlStatement =SqlStatement & " and table_contr_schedule.x_av_family <> '" & lstTemp3.itembyindex(0) & "'" &_
                " and table_contr_schedule.x_av_line <> '" & lstTemp3.itembyindex(1) & "'" & _
                " and table_contr_schedule.x_av_offer <> '" & lstTemp3.itembyindex(2) & "'"
            end if

            toDB.Select SqlStatement, ordList
            If (ordList.Count > 0 ) then
                br.Clear
                br.SimpleQuery 0,gcstCOMVarContrItm
                br.AppendFilter 0,gcstCOMVarObjid,cbin,ordList
                br.RetrieveRecords
                Set lstArtCUCFArbor = br.GetRecordList(0)
                Set lstArtCUCF = br.GetRecordList(0)
            else
				'debug.print "AucunArt 3"
                mssg = AucunArt
                Call EnErreur(lobjidSuivi, mssg)
                lngErrCount = lngErrCount+1
                goto cleanup1
            END IF
        else
            SqlStatement = "select i.objid from table_contr_itm i, table_contr_schedule s, table_contract c" & _
            ", table_mod_level m, table_part_num p " & _
            "where i.CONTR_ITM2CONTR_SCHEDULE = s.objid " & _
            "and s.SCHEDULE2CONTRACT = c.objid " & _
            "and i.CONTR_ITM2MOD_LEVEL = m.objid " & _
            "and m.PART_INFO2PART_NUM = p.objid " & _
            "and s.SCHEDULE_ID not like '%%RCS*%%'  " & _
            " and i.X_AV_USED_BY2SITE = " & cstr(recNewCU.GetField(gcstCOMVarObjid)) & _
            " and c.objid = " & cstr(recContrat.GetField(gcstCOMVarObjid))  & _
            " and s.SCHEDULE_ID not in (select distinct cs.SCHEDULE_ID from table_contr_itm itm " & _
            " inner join table_contr_schedule cs on itm.CONTR_ITM2CONTR_SCHEDULE = cs.objid " & _
            " where upper(itm.X_AV_STATUT_ACT) = 'A MIGRER PHOENIX' and itm.X_AV_USED_BY2SITE = " & cstr(recNewCU.GetField(gcstCOMVarObjid)) & ") " 

            if lstTemp3.count = 3 then
                SqlStatement =SqlStatement & " and s.x_av_family <> '" & lstTemp3.itembyindex(0) & "'" &_
                " and s.x_av_line <> '" & lstTemp3.itembyindex(1) & "'" & _
                " and s.x_av_offer <> '" & lstTemp3.itembyindex(2) & "'"
            end if

            IF recSuivi.GetField("x_av_exclus_usg_mp") = 1 THEN
                SqlStatement = SqlStatement & " and p.X_AV_CROSS_REF not in ('MP_USG_JURIDICTION', 'REV_USG_REVERSEMENT')"
            END IF

            dim str1 as string
            dim str2 as string
            'str1 = " and ((p.X_AV_GEN_SI = 1 and ( nvl(i.x_av_statut_si,'null') = 'CRE_ARB' or  nvl(i.x_av_statut_si,'null') like 'MOD%')) or p.X_AV_PART_PROV_LEVEL = 'CF') "
            str1 = " and ((p.X_AV_GEN_SI = 1 and NVL(i.x_av_statut_mat, 'null') = 'Référencé') or p.X_AV_PART_PROV_LEVEL = 'CF') "
            str2 = "and (nvl(p.x_av_type, '-') <> 'NRC' or i.x_av_arb_status = 'Initialisation') " & _
            " and ((p.X_AV_GEN_SI = 1  and NVL(i.x_av_statut_mat, 'null') = 'Référencé') or p.X_AV_PART_PROV_LEVEL = 'CF' or p.X_AV_INSTALL_TYPE in ('F2','IF2')) "
            '" and ((p.X_AV_GEN_SI = 1  and ( nvl(i.x_av_statut_si,'null') = 'CRE_ARB' or  nvl(i.x_av_statut_si,'null') like 'MOD%')) or p.X_AV_PART_PROV_LEVEL = 'CF' or p.X_AV_INSTALL_TYPE in ('F2','IF2')) "

			set toDB = new SQLDB
			set ordList = new list
			ordList.ItemType = gcstCOMVarLONG
			
            toDB.Select SqlStatement &  str1 , ordList
            debug.print "REQUETE ***** :" & SqlStatement &  str1

            if ordList.count > 0 then
                br.Clear
                br.simplequery 0, gcstCOMVarContrItm
                br.appendfilter 0, gcstCOMVarObjid, cbin, ordList
                br.retrieverecords

                set lstArtCUCFArbor = br.getrecordlist(0)
            else
                    'VABF 725
                mssg = AucunArtRep
                Call EnErreur(lobjidSuivi, mssg)
                lngErrCount = lngErrCount+1
                goto cleanup1
            end if

            SqlStatement = SqlStatement & str2 & "  union " & _
            "select i.objid from table_contr_itm i, table_contr_schedule s, table_contract c" & _
            ", table_mod_level m, table_part_num p " & _
            "where i.CONTR_ITM2CONTR_SCHEDULE = s.objid " & _
            "and s.SCHEDULE2CONTRACT = c.objid " & _
            "and i.CONTR_ITM2MOD_LEVEL = m.objid " & _
            "and m.PART_INFO2PART_NUM = p.objid " & _
            "and s.SCHEDULE_ID not like '%%RCS*%%' " & _
            "and p.X_AV_GEN_SI = 0 " & _
            "and (nvl(p.x_av_type, '-') <> 'NRC' or i.x_av_arb_status = 'Initialisation') " & _
            "and i.LINE_NO = 0 " & _
            "and i.X_AV_USED_BY2SITE = " & cstr(recNewCU.GetField(gcstCOMVarObjid)) & _
            " and c.objid = " & cstr(recContrat.GetField(gcstCOMVarObjid))  & _
            " and s.SCHEDULE_ID not in (select distinct cs.SCHEDULE_ID from table_contr_itm itm " & _
            " inner join table_contr_schedule cs on itm.CONTR_ITM2CONTR_SCHEDULE = cs.objid " & _
            " where upper(itm.X_AV_STATUT_ACT) = 'A MIGRER PHOENIX' and itm.X_AV_USED_BY2SITE = " & cstr(recNewCU.GetField(gcstCOMVarObjid)) & ") " 
			
			'debug.print "REQUETE 2 ***** :" & SqlStatement 
			
            toDB.Select SqlStatement, ordList
            If (ordList.Count > 0 ) then
                br.Clear
                br.simplequery 0, gcstCOMVarContrItm
                br.appendfilter 0, gcstCOMVarObjid, cbin, ordList
                br.retrieverecords
                Set lstArtCUCF = br.GetRecordList(0)
            else
				'debug.print "AucunArt 4"
                mssg = AucunArt
                Call EnErreur(lobjidSuivi, mssg)
                lngErrCount = lngErrCount+1
                goto cleanup1
            END IF
        END IF


'-- Case 8623 - Laurent Léonardi - 27/10/2003

        '****************************************
        '* Mise à jour des Listes en fonction de ce qui est réellement à modifier
        '****************************************
        lstArtCUCFArborToDo.ItemType = gcstCOMVarRecord
        lstArtCUCFToDo.ItemType = gcstCOMVarRecord
        For i = 0 To lstArtCUCFArbor.Count-1
            Set recArtToCheck = lstArtCUCFArbor.ItemByIndex(i)
            if recArtToCheck.GetField("x_av_statut_act") <> "Résilié" then
                lstParameters.Clear
                lstParameters.ItemType =gstrCOMVarVARIANT
                lstParameters.AppendItem recArtToCheck.GetField(gcstCOMVarObjid)
                toDB.ExecuteProc "sa.proc_verif_statut_chmt_cf", lstParameters,typResponse
                If typResponse.response = gcstCOMVarVide Then
                    br.Clear
                    br.simplequery 0, gcstCOMVarContrItm
                    br.appendfilter 0, gcstCOMVarObjid, cbequal, recArtToCheck.GetField(gcstCOMVarObjid)
                    br.traversefromparent 1, gcstCOMVarAVBILLTO2SITE, 0
                    br.appendfilter 1, gcstCOMVarObjid, cbequal, recNewCF.GetField(gcstCOMVarObjid)
                    br.retrieverecords

                    set lstTemp = br.GetRecordList(1)
                    if lstTemp.count = 0  then
                        lstArtCUCFArborToDo.AppendItem recArtToCheck
                    End If
                Else
                    Call EnErreur(lobjidSuivi, typResponse.response)
                    lngErrCount = lngErrCount+1
                    goto cleanup1
                End If
            end if
        Next i
        For i = 0 To lstArtCUCF.Count-1
            Set recArtToCheck = lstArtCUCF.ItemByIndex(i)
			'debug.print "x_av_statut_act = " & recArtToCheck.GetField("x_av_statut_act") & "objid = " & recArtToCheck.GetField("objid")
            if recArtToCheck.GetField("x_av_statut_act") <> "Résilié" then
                lstParameters.Clear
                lstParameters.ItemType =gstrCOMVarVARIANT
                lstParameters.AppendItem recArtToCheck.GetField(gcstCOMVarObjid)
				'debug.print "lstArtCUCF.count : " & lstArtCUCF.count
				'debug.print "recArtToCheck.GetField(gcstCOMVarObjid) : " & recArtToCheck.GetField(gcstCOMVarObjid)
                toDB.ExecuteProc "sa.proc_verif_statut_chmt_cf", lstParameters,typResponse

                If typResponse.response = gcstCOMVarVide  Then
                    br.Clear
                    br.simplequery 0, gcstCOMVarContrItm
                    br.appendfilter 0, gcstCOMVarObjid, cbequal, recArtToCheck.GetField(gcstCOMVarObjid)
                    br.traversefromparent 1, gcstCOMVarAVBILLTO2SITE, 0
                    br.appendfilter 1, gcstCOMVarObjid, cbequal, recNewCF.GetField(gcstCOMVarObjid)
                    br.retrieverecords

                    set lstTemp = br.GetRecordList(1)
					
					'debug.print "lstTemp.count : " & lstTemp.count & " , lstArtCUCFToDo.count : " & lstArtCUCFToDo.count
                    if lstTemp.count = 0  then
                        lstArtCUCFToDo.AppendItem recArtToCheck
                    End If
                Else
                    Call EnErreur(lobjidSuivi, typResponse.response)
                    lngErrCount = lngErrCount+1
                    goto cleanup1
                End If
            end if
        Next i

        if lstArtCUCFToDo.count < 1 then
			'debug.print "AucunArt 5"
            mssg = AucunArt
            Call EnErreur(lobjidSuivi, mssg)
            lngErrCount = lngErrCount+1
            goto cleanup1
        end if

        '****************************************
        '* Détermination des articles pour lesquels des ordres Arbor sont à envoyer
        '****************************************
        set lstArborOrder = new list
        set lstArborOrder2 = new list
		set lstArborOrder2NRC = new list
        set lstArborOld = new list
        set lstPN = new list

        lstArborOrder.ItemType = gcstCOMVarRecord
        lstArborOrder2.ItemType=gcstCOMVarRecord
		lstArborOrder2NRC.ItemType=gcstCOMVarRecord
        lstArborOld.ItemType = gcstCOMVarRecord
        For i = 0 To lstArtCUCFArborToDo.Count-1
            Set recArt = lstArtCUCFArborToDo.ItemByIndex(i)
            If recArt.GetField(gcstCOMVarAVSTATUS) = gcstCOMArticleArbStatusFactTraité Then
                lstArborOrder.AppendItem recArt
                lstArborOld.AppendItem recArt
                'Début correction Ano 7593
                br.Clear
                br.Simplequery 0, gcstCOMVarContrItm
                br.AppendFilter 0, gcstCOMVarObjid, cbequal, recArt.GetField(gcstCOMVarObjid)
                br.TraverseFromParent 1, "contr_itm2mod_level", 0
                br.TraverseFromParent 2, "part_info2part_num", 1
                br.AppendFilter 2, gcstCOMVarAVTYPE, cbnotequal, gcstPDCConCadTypNRC
                br.RetrieveRecords
                Set lstPN = br.GetRecordList(2)
                if lstPN.count = 1 then
					Dim recPartNumNRC As Record
					Set recPartNumNRC = lstPN.ItemByIndex(0)
					if recPartNumNRC.GetField("x_av_type") <> "NRC" Then
						lstArborOrder2.AppendItem recArt
					else
						lstArborOrder2NRC.AppendItem recArt
					end if
                end if
                'Fin correction Ano 7593
            End If
        
            If Len(recArt.GetField(gcstCOMVarAVIDS))> 1 Then
                br.Clear
                br.Simplequery 0, gcstCOMVarContrItm
                br.AppendFilter 0, gcstCOMVarAVIDS, cbequal, recArt.GetField(gcstCOMVarAVIDS)
                br.AppendFilter 0, gcstCOMVarAVSTATUS, cbequal, gcstCOMArticleArbStatusFactTraité
                br.AppendFilter 0, gcstCOMVarObjid, cbnotequal, recArt.GetField(gcstCOMVarObjid)
                br.TraverseFromParent 1, "contr_itm2mod_level", 0
                br.TraverseFromParent 2, "part_info2part_num", 1
                br.AppendFilter 2, gcstCOMVarAVTYPE, cbnotequal, gcstPDCConCadTypNRC
                br.TraverseFromParent 3, "part_num2mod_level",2
                br.TraverseFromParent 4, "part_info2contr_itm", 3
                br.AppendFilter 4, gcstCOMVarAVIDS, cbequal, recArt.GetField(gcstCOMVarAVIDS)
                br.AppendFilter 4, gcstCOMVarAVSTATUS, cbequal, gcstCOMArticleArbStatusFactTraité
                br.AppendFilter 4, gcstCOMVarObjid, cbnotequal, recArt.GetField(gcstCOMVarObjid)
                br.RetrieveRecords

                Set lstIDSTocheck = br.GetRecordList(0)
                Set lstIDSTocheck2 = br.GetRecordList(4)
                For z = 0 To lstIDStocheck2.Count-1
                    Set recIDSTocheck = lstIDStocheck2.ItemByIndex(z)
'MAT JIRA 2587 : correction anomalie détectée dans trace PFV >
'					if recIDSTocheck.GetField("x_av_type") <> "NRC" then
						lstArborOrder2.AllowDuplicates = False
						lstArborOrder2.AppendItem recIDStocheck 'article à créer
'					else
'						lstArborOrder2NRC.AllowDuplicates = False
'						lstArborOrder2NRC.AppendItem recIDStocheck 'article à créer
'					end if
'MAT JIRA 2587 : correction anomalie détectée dans trace PFV <
                Next z

                For z = 0 To lstIDStocheck.Count-1
                    Set recIDSTocheck = lstIDStocheck.ItemByIndex(z)

                    lstArborOrder.AppendItem recIDStocheck 'article à résilier
                    lstArborOld.AppendItem recIDStocheck
                Next z
            End If
        Next i

'MAT JIRA 2587 : Ne plus "jouer" avec les dates de facturation des BdS facturables >
        '****************************************
        '* Envoi des ordres de résilisation à Arbor
        '****************************************
        'Setter la date de début de facturation à Demain et la date de fin de facturation à aujourd'hui
'        demain = DateAdd(gcstCOMVarD, 1, app.currentdate)
'        strdemain = Day(demain) & gcstCOMVarSLASH & Month(demain) & gcstCOMVarSLASH & Year(demain)
'        strdemain = strdemain & " " & time()
'        For i = 0 To lstARborOrder.Count -1
'            Set recArborOrder = lstArborOrder.ItemByIndex(i)
'            recArborOrder.SetField gcstCOMVarCHGSTARTDT, strdemain
'            recArborOrder.SetField gcstCOMVarCHGENDDT, strdemain
'            lstArborOrder.ReplaceByIndex i, recArborORder
'            blsCUCF.UpdateRecord recArborOrder
'        Next i
'        blsCUCF.Save
'MAT JIRA 2587 : Ne plus "jouer" avec les dates de facturation des BdS facturables <
        Dim recPartNum1 As Record
        Dim lstPart As List
        Dim recArborOrder1 As New Record
        Dim lstArborOrderMp As New List
        set lstArborOrderMp = new list
        Dim lstArborOrderNotMp As New List
        set lstArborOrderNotMp = new list
        'envoi des ordres de résilisation
        
		Dim lstArborOrderMpNRC As New List
        set lstArborOrderMpNRC = new list
		Dim lstArborOrderNotMpNRC As New List
        set lstArborOrderNotMpNRC = new list
		
        br.Clear
        For i = 0 To lstARborOrder.Count -1
        Set recArborOrder1 = lstArborOrder.ItemByIndex(i)
        br.simplequery 0, gcstCOMVarContrItm
        br.Appendfilter 0, gcstCOMVarObjid, cbequal, clng(recArborOrder1.GetField("objid"))
        br.TraversefromParent 1, "contr_itm2mod_level", 0
        br.TraverseFromParent 2, "part_info2part_num", 1
        br.retrieverecords
        Set lstPart = br.GetRecordList(2)
        If lstPart.Count > 0 Then
			'debug.print "STEP / STEP"
            Set recPartNum1 = lstPart.ItemByIndex(0)
            if ( IsMPAccesType(recPartNum1)) then
				'debug.print "STEP 0"
				if recPartNum1.GetField("x_av_type") <> "NRC" Then
					'debug.print "STEP 1"
					lstArborOrderMp.AppendItem recArborOrder1
				else
					'debug.print "STEP 2"
					lstArborOrderMpNRC.AppendItem recArborOrder1
				end if
            else
				'debug.print "STEP 3"
				if recPartNum1.GetField("x_av_type") <> "NRC" then
					'debug.print "STEP 4"
					lstArborOrderNotMp.AppendItem recArborOrder1
				else
					'debug.print "STEP 5"
					lstArborOrderNotMpNRC.AppendItem recArborOrder1
				end if
            end if
        End If
        Next i
        
        if (  lstArborOrderNotMp.count >0) then
			'debug.print "Etape 3"
			Call RepliqueArborInterface ( blsSave, 5, -1 , 3, lstArborOrderNotMp, 0 )
        end if
		
		If (lstArborOrderNotMpNRC.count > 0) Then
			Dim recArborOrderNotMpNRC As Record
			For i = 0 To lstArborOrderNotMpNRC.count - 1
				Set recArborOrderNotMpNRC = lstArborOrderNotMpNRC.ItemByIndex(i)
				If recArborOrderNotMpNRC.GetField("x_av_status_c2a") = "Facturé - Traité" Then
					'debug.print "Etape 3.1 - x_av_status_c2a : " & recArborOrderNotMpNRC.GetField("x_av_status_c2a")
					'debug.print "Etape 3.2 - Objid : " & recArborOrderNotMpNRC.GetField("objid")
					recArborOrderNotMpNRC.SetField "x_av_statut_act", "Résilié"
					recArborOrderNotMpNRC.SetField "x_av_arb_status", "RES_ARB"
				End If
				bSaveRollBack.UpdateRecord recArborOrderNotMpNRC
			Next i
			bSaveRollBack.Save
		End If

        '****************************************
        '* Création de l'évenement historique et MAJ des relations CF
        '****************************************
        lstDummy.Clear
        lstDummy.ItemType = gcstCOMVarRecord
        Set blsSave = New BulkSave
        For i = 0 To lstArtCUCFToDo.Count-1
            Set recArtCUCF = lstArtCUCFToDo.ItemByIndex(i)
            Set lstDummy = New List
            'Set pwrCF = New PowerQuery
            lstDummy.AppendItem recArtCUCF
            'dans le cas d'une décentralisation
            If recSuivi.GetField(gcstCOMVarAVACTION) = Decent Then
                mssg = gcstPDCHistoriqueModifCFDecentr
            End If
            'dans le cas d'une centn
            If  recSuivi.GetField(gcstCOMVarAVACTION) = Centra Then
                mssg = gcstPDCHistoriqueModifCFcentr
            End If
            'dans le cas d'un regroupement
            If recSuivi.GetField(gcstCOMVarAVACTION) = Regroup Then
                mssg = gcstPDCHistoriqueModifCFRegroup
            End If

            br.Clear
            br.simplequery 0, gcstCOMVarContrItm
            br.Appendfilter 0, gcstCOMVarObjid, cbequal, recArtCUCF.GetField(gcstCOMVarObjid)
            br.TraversefromParent 1, gcstCOMVarAVBILLTO2SITE, 0
            br.TraverseFromParent 2, "contr_itm2contr_schedule", 0
            br.TraverseFromParent 3, "bill_to2site", 2
            br.RetrieveRecords

            Set lstTemp = br.GetRecordList(1)

            if lstTemp.count = 0 then
                TRUELOG WriteLog(SUBCHMTCF,"35091480",Warn,"objid: " & lobjidSuivi & "  Le CF de la BDS <" & recArtCUCF.GetField(gcstCOMVarObjid) & "> n'a pas été trouvé.")
                Set lstTemp = br.GetRecordList(3)
                if lstTemp.count = 0 then
                    mssg = "Erreur lors de la récupération du CF de la BDS <" & recArtCUCF.GetField(gcstCOMVarObjid) & ">"
                    Call EnErreur(lobjidSuivi, mssg)
                    lngErrCount = lngErrCount+1
                    goto cleanup1
                end if
            end if

            Set recOldCF = lstTemp.ItemByIndex(0)
            blnDummy = Version_inf202(mssg, lstdummy, cstr(recOldCF.GetField(gcstCOMVarObjid)), cstr(recNewCF.GetField(gcstCOMVarObjid)))
            blsSave.RelateRecords recNewCF, recArtCUCF, "x_av_site2bill_to"
        Next i
        blsSave.Save
        
        if (  lstArborOrderMp.count >0) then
			'debug.print "Etape 4"
			Call RepliqueArborInterface ( blsSave, 5, -1 , 3, lstArborOrderMp, 0 )
        end if
		
		If (lstArborOrderMpNRC.count > 0) Then
			Dim recArborOrderMpNRC As Record
			For i = 0 To lstArborOrderMpNRC.count - 1
				Set recArborOrderMpNRC = lstArborOrderMpNRC.ItemByIndex(i)
				If recArborOrderMpNRC.GetField("x_av_status_c2a") = "Facturé - Traité" Then
					'debug.print "Etape 4.1 - x_av_status_c2a : " & recArborOrderMpNRC.GetField("x_av_status_c2a")
					'debug.print "Etape 4.2 - Objid : " & recArborOrderMpNRC.GetField("objid")
					recArborOrderMpNRC.SetField "x_av_statut_act", "Résilié"
					recArborOrderMpNRC.SetField "x_av_arb_status", "RES_ARB"
				End If
				bSaveRollBack.UpdateRecord recArborOrderMpNRC
			Next i
			bSaveRollBack.Save
		End If
		
        '****************************************
        '* Envoi des ordres de création
        '****************************************
        'Debut correction Ano 2447 DKH
        if (lstARborOrder2.count > 0) then
			'debug.print "Etape 5"
			Call RepliqueArborInterface ( blsSave2, 5, -1 , 1, lstARborOrder2, 0 )
		end if
		
		If (lstARborOrder2NRC.count > 0) Then
			Dim recARborOrder2NRC As Record
			For i = 0 To lstArborOrderMpNRC.count - 1
				Set recARborOrder2NRC = lstARborOrder2NRC.ItemByIndex(i)
				If recARborOrder2NRC.GetField("x_av_status_c2a") = "Facturé - Traité" Then
					'debug.print "Etape 5.1 - x_av_status_c2a : " & recARborOrder2NRC.GetField("x_av_status_c2a")
					'debug.print "Etape 5.2 - Objid : " & recARborOrder2NRC.GetField("objid")
					recARborOrder2NRC.SetField "x_av_statut_act", "Résilié"
					recARborOrder2NRC.SetField "x_av_arb_status", "RES_ARB"
				End If
				bSaveRollBack.UpdateRecord recARborOrder2NRC
			Next i
			bSaveRollBack.Save
		End If
        'Fin correction Ano 2447 DKH

'MAT JIRA 2587 : Ne plus "jouer" avec les dates de facturation des BdS facturables >
        'Remettre les dates de facturation en l'état
'        For i = 0 To lstARborOld.Count -1
'            Set recArbor = lstArborOld.ItemByIndex(i)
'             'Forcer les champs à Dirty
'            recArbor.Setfield "last_mod_dt",app.currentdate
'            IF left(recArbor.GetField(gcstCOMVarCHGSTARTDT),5) = gcstPDCConCadDateVide then
'                 recArbor.Setfield gcstCOMVarCHGSTARTDT,gcstCOMDtNulle
'            else
'                recArbor.Setfield gcstCOMVarCHGSTARTDT,recArbor.GetField(gcstCOMVarCHGSTARTDT)
'            end if
'            IF left(recArbor.GetField(gcstCOMVarCHGENDDT),5) = gcstPDCConCadDateVide then
'                recArbor.Setfield gcstCOMVarCHGENDDT, gcstCOMDtNulle
'            else
'                recArbor.Setfield gcstCOMVarCHGENDDT,recArbor.GetField(gcstCOMVarCHGENDDT)
'            end if
'            bSaveRollBack.UpdateRecord recArbor
'        Next i
'        bSaveRollBack.Save
'MAT JIRA 2587 : Ne plus "jouer" avec les dates de facturation des BdS facturables <

    br.Clear
    br.SimpleQuery 0, gcstCOMVarContract
    br.AppendFilter 0, gcstCOMVarObjid, cbequal, recContrat.GetField(gcstCOMVarObjid)
    br.TraverseFromParent 1, "contract2contr_schedule", 0
    br.AppendFilter 1, gcstCOMVarSCHEDULEID, cbNotLike, "%RCS*%"
    br.AppendFilter 1, "x_av_status", cbnotequal, "Résilié"
    br.RetrieveRecords

    Set lstSchedules = br.GetRecordList(1)
    end if

    ' traitement Structure Fact
    '<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

    '****************************************
    '* Modification potentielle des Sites de facturation au niveau lot
    '****************************************

    Dim lstTemp1 as list
    Dim lstTemp2 as list

    Dim lstOrder as new list
    Dim j as integer

    Dim sDB as new sqldb
    Dim strStmt as string
    Dim lstBdS as new list
    Dim lstBdS2 as new list

    intModSched = 0
    For i = 0 To lstSchedules.Count-1

        Set recSchedule = lstSchedules.ItemByIndex(i)

        if lstTemp3.count <> 3 or (lstTemp3.count = 3 and recSchedule.getfield("x_av_family") <> lstTemp3.ItemByIndex(0) _
        and recSchedule.getfield("x_av_line") <> lstTemp3.ItemByIndex(1) and _
        recSchedule.getfield("x_av_offer") <> lstTemp3.ItemByIndex(2)) then 'YZA ITEM 810
            lstOrder.Clear
            br.Clear
            br.simplequery 0, gcstCOMVarContrSchedule
            br.appendfilter 0, gcstCOMVarObjid, cbequal, recSchedule.GetField(gcstCOMVarObjid)
            br.TraverseFromParent 1, "schedule2contr_itm", 0
            br.AppendFilter 1, "x_av_statut_act", cbnotequal, "Résilié"
            'br.TraverseFromParent 2, gcstCOMVarAVBILLTO2SITE, 1
            'br.AppendFilter 2, gcstCOMVarObjid, cbnotequal, recNewCF.GetField(gcstCOMVarObjid)
            br.traverseFromParent 2, "bill_to2site", 0
            br.AppendFilter 2, gcstCOMVarObjid, cbnotequal, recNewCF.GetField(gcstCOMVarObjid)
            br.RetrieveRecords

            Set lstTemp = br.GetRecordList(2)
            Set lstTemp1 = br.GetRecordList(1)

            'rbe MCO C3591846
            lstBdS.ItemType = gcstCOMVarLONG
            strStmt =   " select 1 from table_contr_itm " & _
                        " where contr_itm2contr_schedule = " & recSchedule.GetField(gcstCOMVarObjid) & _
                        " and   x_av_statut_act != 'Résilié' " & _
                        " and   x_av_bill_to2site is not null "
            sDB.Select strStmt, lstBdS
            'fin rbe
            if lstTemp.count > 0 then
                'rbe C4428011
                strStmt =   " select 1" & _
                            " from table_contr_itm itm," & _
                            " table_mod_level ml," & _
                            " table_part_num pn" & _
                            " where itm.contr_itm2contr_schedule = " & recSchedule.GetField(gcstCOMVarObjid) & _
                            " and   itm.x_av_statut_act != 'Résilié'" & _
                            " and   ml.part_info2part_num = pn.objid" & _
                            " and   ml.objid = itm.contr_itm2mod_level" & _
                            " and   (pn.x_av_gen_si = 1 or pn.x_av_part_prov_level = 'CF')" & _
                            " and   itm.x_av_bill_to2site is not null" & _
                            " and   itm.x_av_bill_to2site != " & recNewCF.GetField(gcstCOMVarObjid)

                lstBdS2.ItemType = gcstCOMVarLONG
                sDB.Select strStmt, lstBdS2

                'Set lstTemp = br.GetRecordList(2)
    '           if lstTemp.count > 0 then
    '               for j = 0 to lstTemp.count-1
    '                   Set recSite = lstTemp.ItemByIndex(j)
    '                   lstOrder.AllowDuplicates = False
    '                   lstOrder.AppendItem recSite.GetField(gcstCOMVarObjid)
    '               next j
    '           end if
    '
    '           If lstOrder.count = 1 then
    '               Set recSite = lstTemp.ItemByIndex(0)
    '               br.TraverseFromParent 3, "bill_to2site" ,0
    '               br.appendfilter 3, gcstCOMVarObjid, cbequal, recSite.GetField(gcstCOMVarObjid)
    '               br.RetrieveRecords
    '               Set  lstTemp2 = br.GetRecordList(3)
    '               if lstTemp2.count = 0 then
                if lstBdS2.count = 0 and lstBdS.count > 0 then
                        blsSave3.RelateRecords recSchedule, recNewCF, gcstCOMVarBILLTO2SITE
                        intModSched = intModSched + 1
    '               End If
    '           End If
                elseIf lstBdS.count > 0 and lstTemp1.Count = 0 and (recSuivi.GetField(gcstCOMVarAVACTION) = Regroup or recSuivi.GetField(gcstCOMVarAVACTION) = Centra) Then
                    blsSave3.RelateRecords recSchedule, recNewCF, gcstCOMVarBILLTO2SITE
                    intModSched = intModSched + 1
                End If
            end if
        END IF
    Next i
    blsSave3.Save

    TRUELOG WriteLog(SUBCHMTCF,"60090010","[SUIVI : " + cstr(recSuivi.GetField(gcstCOMVarObjid)) + "]", "Le site de facturation a été modifié pour " + cstr(intModSched) + " lot(s) pour le contrat " + recContrat.GetField(gcstCOMVarID) + ".")

	'****************************************
    '* Modification potentielle des Sites d'Installation au niveau lot 
	'* cor C17876791
    '****************************************
	
	    
   	Dim lstBdSCU as new list
	Dim sDB2 as new sqldb
	
    intModSched = 0
    For i = 0 To lstSchedules.Count-1

        Set recSchedule = lstSchedules.ItemByIndex(i)

        if lstTemp3.count <> 3 or (lstTemp3.count = 3 and recSchedule.getfield("x_av_family") <> lstTemp3.ItemByIndex(0) _
        and recSchedule.getfield("x_av_line") <> lstTemp3.ItemByIndex(1) and _
        recSchedule.getfield("x_av_offer") <> lstTemp3.ItemByIndex(2)) then 
            lstOrder.Clear
            br.Clear
            br.simplequery 0, gcstCOMVarContrSchedule
            br.appendfilter 0, gcstCOMVarObjid, cbequal, recSchedule.GetField(gcstCOMVarObjid)
            br.TraverseFromParent 1, "schedule2contr_itm", 0
            br.AppendFilter 1, "x_av_statut_act", cbnotequal, "Résilié"
			br.traverseFromParent 2, "ship_to2site", 0
            br.AppendFilter 2, gcstCOMVarObjid, cbnotequal, recNewCU.GetField(gcstCOMVarObjid)
            br.RetrieveRecords
			
						
			Set lstTemp = br.GetRecordList(2)
            Set lstTemp1 = br.GetRecordList(1)
          	
            lstBdS.ItemType = gcstCOMVarLONG
            strStmt =   " select 1 from table_contr_itm " & _
                        " where contr_itm2contr_schedule = " & recSchedule.GetField(gcstCOMVarObjid) & _
                        " and   x_av_statut_act != 'Résilié' " & _
						" and   X_AV_USED_BY2SITE is not null "
					
            sDB2.Select strStmt, lstBdS
            
            if lstTemp.count > 0 then

                strStmt =   " select 1" & _
                            " from table_contr_itm itm" & _
                            " where itm.contr_itm2contr_schedule = " & recSchedule.GetField(gcstCOMVarObjid) & _
                            " and   itm.x_av_statut_act != 'Résilié'" & _
                            " and   itm.X_AV_USED_BY2SITE is not null" & _
                            " and   itm.X_AV_USED_BY2SITE != " & recNewCU.GetField(gcstCOMVarObjid)
														
				debug.print strStmt
                lstBdSCU.ItemType = gcstCOMVarLONG
                sDB2.Select strStmt, lstBdSCU
				
                If lstBdSCU.count = 0 and lstBdS.count > 0 then
                    blsSave3.RelateRecords recSchedule, recNewCU, "ship_to2site"
                    intModSched = intModSched + 1
                   					
				end if
			end If			
        END IF
    Next i
    blsSave3.Save

    TRUELOG WriteLog(SUBCHMTCF,"60090010","[SUIVI : " + cstr(recSuivi.GetField(gcstCOMVarObjid)) + "]", "Le site d'installation a été modifié pour " + cstr(intModSched) + " lot(s) pour le contrat " + recContrat.GetField(gcstCOMVarID) + ".")
	
	'fin C17876791
	
    'DEBUT YZA EVOL 810

    if lstTemp3.count = 3 and (recOldCF.getfield("x_av_edi_hybride") = 1 or recOldCF.getfield("x_av_bill_type") = "EDI Structuré") then
    dim lstLot as new list

        strStmt =   " select ci.objid " & _
                    " from table_site s," & _
                    " table_contr_itm ci," & _
                    " table_contr_schedule lot " & _
                    " where s.objid = " & recOldCF.GetField(gcstCOMVarObjid) & _
                    " AND ci.x_av_bill_to2site = s.objid " & _
                    " and ci.contr_itm2contr_schedule = lot.objid " & _
                    " and lot.x_av_family <> '" & lstTemp3.itembyindex(0) & "'" &_
                    " and lot.x_av_line <> '" & lstTemp3.itembyindex(1) & "'" & _
                    " and lot.x_av_offer <> '" & lstTemp3.itembyindex(2) & "'"  & _
                    " and rownum = 1 "

         lstLot.ItemType = gcstCOMVarLONG
         sDB.Select strStmt, lstLot

         if lstLot.count = 0 then
         TRUELOG WriteLog(SUBCHMTCF,"60090010","[SUIVI : " + cstr(recSuivi.GetField(gcstCOMVarObjid)) + "]", "Le site <" + recOldCF.GetField(gcstCOMVarSITEID) + "> n'est plus référencé comme CF autrement que sur le lot EDI.")
         end if
    end if


'FIN YZA EVOL 810

    '****************************************
    '* Mise à jour la table_x_av_suivi_chmt_cf
    '****************************************

    recSuivi.SetField gcstCOMVarSTATUSAV, cstSuiviOK
    bs.UpdateRecord recSuivi
    bs.Save

    intSucces = intSucces + 1
    bolSuivi = true

Cleanup1:
    Set lstTemp2 = Nothing
    Set lstTemp1 = Nothing
    Set lstOrder = Nothing
    Set br = Nothing
    Set brOld = Nothing
    Set bs = Nothing
    Set blsSave = Nothing
    Set blsSave2 = Nothing
    Set blsCUCF3 = Nothing
    Set blsCUCF = Nothing
    Set recOldCF = Nothing
    Set recOldCU = Nothing
    Set recSuivi = Nothing
    Set recPArtNum = Nothing
    Set recArbor = Nothing
    Set rtemp = Nothing
    Set recIDStocheck   = Nothing
    Set recArborOrder = Nothing
    Set recArtCUCF = Nothing
    Set recNewCF = Nothing
    Set recSchedule = Nothing
    Set recSite = Nothing
    Set recArt = Nothing
    Set lstOld = Nothing
    Set lstSuivi = Nothing
    Set lstArbor = Nothing
    Set lstArborOld = Nothing
    Set lstArbor2 = Nothing
    Set lstDummy = Nothing
    Set lstIDStocheck = Nothing
    Set lstIDStocheck2 = Nothing
    Set lstSchedules = Nothing
    Set lstArtCUCFArborToDo = Nothing
    Set lstArtCUCFToDo = Nothing
    Set lstArborOrder = Nothing
    Set lstArborOrder2 = Nothing
	Set lstArborOrder2NRC = Nothing
    Set lstPN = Nothing
    Set lstParameters = Nothing
    Set lstContrat = Nothing
    Set recContrat = Nothing
    Set toDB = Nothing
    Set lstCF = Nothing
    Set recNewCF = Nothing
    Set lstCU = Nothing
    Set recNewCU = Nothing
    Set lstArtCUCFArbor = Nothing
    Set lstArtCUCF = Nothing
    Set ordList = Nothing
    Set recArtToCheck = Nothing
    Set lstTemp = Nothing
    Set blsSave3= Nothing
    Set bSaveRollBack = Nothing
    Set lstPArtNum = Nothing
    Set lstLI = Nothing
    Set recLI = Nothing


Exit Sub
ErrorHandling:
    TRUELOG WriteLog(SUBCHMTCF,"40090008","[SUIVI : " + cstr(recSuivi.GetField(gcstCOMVarObjid)) + "] " + Warn, " Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description)
    lngWarnCount = lngWarnCount + 1
    Resume Next
End Sub



