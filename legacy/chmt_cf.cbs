'****************************************
'* CALCUL RIB NEUF CEGETEL  [06PPUMA_10_F02]
'****************************************

Function CalculRIB (recSite As Record , ByRef strib As String) As Boolean
On Error GoTo Error_Handling

Dim lstRib As New List
Dim recRib As New Record
Dim brRib As New BulkRetrieve


   brRib.SimpleQuery 0, gcstCOMVarAVCODE
   brRib.AppendFilter 0,gcstCOMVarAVTYPE, cbEqual ,"RIB_PAR_DEFAUT"
   brRib.AppendFilter 0,gcstCOMVarAVCODE, cbEqual, recSite.GetField("x_av_rcs_contrat")
   brRib.AppendFilter 0,gcstCOMVarAVCODE2, cbEqual,recSite.GetField(gcstCOMVarAVBILLPAYMETHOD)
   brRib.RetrieveRecords
   Set lstRib = brRib.GetRecordList(0)
   If lstRib.Count > 0 Then
      Set recRib = lstRib.ItemByIndex(0)
      strib = recRib.GetField(gcstCOMVarAVLIBELLE) 'chaine Rib retournée >
      CalculRIb=True
  Else
      strib = "Le Rib par défaut n'a pas été retrouvé"
    CalculRIb=false
   End if

   Set lstRib = Nothing
   Set recRib = Nothing
   Set brRib = Nothing

   exit function

Error_Handling:
 TRUELOG WriteLog("CalculRIB", "40090007","[SITE : " + cstr(recSite.GetField(gcstCOMVarObjid)) + "] " + Warn , " Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description)
 CalculRIb=false
    Set lstRib = Nothing
   Set recRib = Nothing
   Set brRib = Nothing
  exit function

End Function
'AEL : Move4 MSIM :
Function trim_f( strin As string,  i As integer,SEPARATOR As String )As string
On Error Goto Error_Handling
    trim_f = Rtrim(Item$(strin,i,i,SEPARATOR))
Exit Function
Error_Handling:
   ErrLogMsgBox cstCVSID, Err.number, Err.Source, Err.description, erl
End Function
'Creer un nouveau lot pour les ligns secondaires
Function CreateNewSchedule(lobjidSuivi As Long,idCF As String,idCU As String, idContrCible As String, strFLO_Lot As String, IsLotSecondaire As Boolean) As Long
On Error GoTo Error_Handling    
	Dim toDB            As New SQLDB
    Dim strSQLStatement As String
    Dim lstLotCible     As New List
    Dim br              As New BulkRetrieve
    Dim bs              As New BulkSave
    Dim lstTmp          As New List
    Dim recNewLot       As New Record
    Dim recLotCible     As New Record
    Dim rprog           As New Record
    Dim rContrat        As New Record
    Dim rSiteCU         As New Record
    Dim rSiteCF         As New Record
    Dim ErrMessage      As String
    Dim strIDinstall    As String
    Dim objidLotCible   As Long
    Dim nbSchedule      As Integer

    br.Clear
    br.SimpleQuery  0, gcstCOMVarSite
    br.AppendFilter 0, gcstCOMVarObjid, cbEqual, idCF
    br.SimpleQuery  1, gcstCOMVarSite
    br.AppendFilter 1, gcstCOMVarObjid, cbEqual, idCU
    br.RetrieveRecords

    Set lstTmp  = br.getrecordlist(0)
    Set rSiteCF = lstTmp.itembyindex(0)
    Set lstTmp  = br.getrecordlist(1)
    Set rSiteCU = lstTmp.itembyindex(0)

    strIDinstall = App.generateID("Schedule ID")

    If IsLotSecondaire Then

        ' Cas de création de lot secondaire - MultiSIM
        ' Le lot est dupliqué à partir du lot de la ligne principale ayant le même CF
        strSQLStatement = " SELECT sch.objid  " & _
                          " FROM table_contr_schedule sch,table_contract con" & _
                          " WHERE sch.bill_to2site = " & idCF & _
                          " AND con.id = '" & idContrCible & "'" & _
                          " AND sch.schedule2contract = con.objid "
        lstLotCible.ItemType = "Long"
        toDB.Select strSQLStatement, lstLotCible
        objidLotCible = lstLotCible.ItemByIndex(0)

        br.clear
        br.SimpleQuery 0, gcstCOMVarContrSchedule
        br.AppendFilter 0, gcstCOMVarObjid, cbEqual, objidLotCible
        br.RetrieveRecords

        Set lstLotCible = br.getRecordList(0)
        Set recLotCible = lstLotCible.ItemByIndex(0)
        Set recNewLot   = recLotCible.Copy(cbChangeToNew)


        br.clear
        br.SimpleQuery  0, gcstCOMVarContract
        br.AppendFilter 0, gcstCOMVarID, cbEqual, idContrCible
        br.RetrieveRecords

        Set lstTmp      = br.getrecordlist(0)
        Set rContrat    = lstTmp.itembyindex(0)


        recNewLot.SetField gcstCOMVarSCHEDULEID,recLotCible.getfield(gcstCOMVarSCHEDULEID)& "_Sec"
        recNewLot.SetField "x_av_family"    , trim_f(strFLO_Lot,1,"|")
        recNewLot.SetField "x_av_line"      , trim_f(strFLO_Lot,2,"|")
        recNewLot.SetField "x_av_offer"     , trim_f(strFLO_Lot,3,"|")
        recNewLot.SetField "item_count"     , 0
        recNewLot.SetField "last_p_line_no" , 0
        recNewLot.SetField "last_update"    , App.currentdate
        recNewLot.SetField "x_av_dtfact"    , CStr(App.CurrentDate)
        recNewLot.SetField "x_av_id_install", strIDinstall
        recNewLot.SetField "x_av_id_ext_site", strIDinstall
        recNewLot.SetField "x_av_id_import", ""
        
        bs.InsertRecord recNewLot
    Else

        ' Cas de création de lot standard
        ' - Le lot est soit déjà créé lors du traitement d'une autre demande sur le même accès
        strSQLStatement = " SELECT sch.objid" & _
                          " FROM   table_contr_schedule sch," & _
                          "        table_contract con" & _
                          " WHERE  sch.bill_to2site = " & idCF & _
                          " AND    sch.ship_to2site = " & idCU & _
                          " AND    con.id           = '" & idContrCible & "'" & _
                          " AND    con.objid        = sch.schedule2contract " & _
                          " AND    sch.x_av_family  = '" & trim_f(strFLO_Lot,1,"|") & "'" & _
                          " AND    sch.x_av_line    = '" & trim_f(strFLO_Lot,2,"|") & "'" & _
                          " AND    sch.x_av_offer   = '" & trim_f(strFLO_Lot,3,"|") & "'"
        lstLotCible.ItemType = "Long"
        toDB.Select strSQLStatement, lstLotCible
        If lstLotCible.Count > 0 Then
            CreateNewSchedule = lstLotCible.ItemByIndex(0)
            Goto CleanUp
        End If

        ' - Sinon, le nouveau lot est dupliqué à partir du premier lot trouvé sur le contrat
        br.clear
        br.SimpleQuery  0, gcstCOMVarContract
        br.AppendFilter 0, gcstCOMVarID, cbEqual, idContrCible
        br.TraverseFromParent 1, "contract2contr_schedule", 0
        br.RetrieveRecords

        Set lstTmp      = br.getrecordlist(0)
        Set rContrat    = lstTmp.itembyindex(0)
        Set lstLotCible = br.getRecordList(1)
        Set recLotCible = lstLotCible.ItemByIndex(0)
        Set recNewLot   = recLotCible.Copy(cbChangeToNew)

        nbSchedule      = Cint(rContrat.GetField("x_av_nb_sched")) + 1
        rContrat.SetField "x_av_nb_sched", nbSchedule
        bs.UpdateRecord rContrat

        If Len (rSiteCU.GetField("name") & "_" & nbSchedule) > 40 Then
            recNewLot.SetField gcstCOMVarSCHEDULEID, Mid(rSiteCU.GetField("name"), 1, 39 - Len (nbSchedule)) & "_" & nbSchedule
        Else
            recNewLot.SetField gcstCOMVarSCHEDULEID, rSiteCU.GetField("name") & "_" & nbSchedule
        End If
        
        recNewLot.SetField "x_av_id_import", ""
        recNewLot.SetField "x_av_family"    , trim_f(strFLO_Lot,1,"|")
        recNewLot.SetField "x_av_line"      , trim_f(strFLO_Lot,2,"|")
        recNewLot.SetField "x_av_offer"     , trim_f(strFLO_Lot,3,"|")
        recNewLot.SetField "item_count"     , 0
        recNewLot.SetField "last_p_line_no" , 0
        recNewLot.SetField "last_update"    , App.currentdate
        recNewLot.SetField "x_av_dtfact"    , CStr(App.CurrentDate)
        recNewLot.SetField "x_av_id_install", strIDinstall
        recNewLot.SetField "x_av_id_ext_site", strIDinstall
        recNewLot.SetField "x_av_status"    , "Actif"
        recNewLot.SetField "x_av_version"   , rContrat.GetField("x_av_current_version")

        bs.InsertRecord recNewLot
    End If

    br.clear
    br.simplequery  0,"price_prog"
    br.appendfilter 0,"name",cbequal,"Standard Cost"
    br.RetrieveRecords

    Set lstTmp   = br.getrecordlist(0)
    Set rprog    = lstTmp.itembyindex(0)


    bs.RelateRecords rContrat, recNewLot, "contract2contr_schedule"
    'bs.RelateRecords recNewLot,  recModLevel, "x_av_sched2mod_level"
    bs.RelateRecords recNewLot,rprog ,"default_prog2price_prog"
    bs.RelateRecords recNewLot, rSiteCU, "ship_to2site"
    bs.RelateRecords recNewLot, rSiteCF, "bill_to2site"
    bs.Save

    CreateNewSchedule = recNewLot.GetField(gcstCOMVarObjid)

CleanUp:
    Set toDB            = Nothing
    Set lstLotCible     = Nothing
    Set br              = Nothing
    Set bs              = Nothing
    Set lstTmp          = Nothing
    Set recNewLot       = Nothing
    Set recLotCible     = Nothing
    Set rprog           = Nothing
    Set rContrat        = Nothing
    Set rSiteCF         = Nothing
    Set rSiteCU         = Nothing
    strSQLStatement     = ebnullstring

Exit Function
Error_Handling:
    TRUELOG WriteLog(SUBCHMTCFPRICE,"40090002","[SUIVI : " + cstr(lobjidSuivi) + "] " + Warn , " Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description)
    lngWarnCount = lngWarnCount + 1
End Function



'Cas de ligne principale, Traiter les lignes secondaires
Sub ChmtCFBdsPrincipal(lobjidSuivi As Long)
On Error GoTo Error_Handling
    Dim br              As New BulkRetrieve
    Dim bs              As New BulkSave
    Dim lstBdsSec       As New List
    Dim toDB            As New SQLDB
    Dim strSQLStatement As String
    Dim ErrMessage      As String
    Dim StrTrplLotSec   As String
    Dim StrTrplLotPrc   As String
    Dim lstTmp          As New List
    Dim lstLotCible     As New List
    Dim lstLotCiblePrc  As New List
    Dim indx            As Integer
    Dim objidBdsSec     As Long
    Dim recSuivi        As New Record
    Dim lstSuivi        As New List
    Dim recNewSuivi     As New Record
    Dim objidLotCible   As Long
    Dim objidLotCibleLP   As Long
    Dim recTmp          As New Record
    Dim objidCFcible    As String

    'Recuperer les lignes secondaires
    br.SimpleQuery 0, SUIVICHMTCF
    br.AppendFilter 0, gcstCOMVarObjid, cbEqual, lobjidSuivi
    br.RetrieveRecords

    Set lstSuivi    = br.GetRecordList(0)
    Set recSuivi    = lstSuivi.ItemByIndex(0)

    strSQLStatement = " SELECT ls.objid " & _
                      " FROM table_contr_itm lp," & _
                      "      table_contr_itm ls," & _
                      "      table_x_av_code code," & _
                      "      table_mod_level ml," & _
                      "      table_part_num  pn," & _
                      "      table_n_attributevalue attr," & _
                      "      table_n_properties prop," & _
                      "      table_x_av_code xav" & _
                      " WHERE lp.child2contr_itm      = " & recSuivi.GetField("x_av_focus_id") & _
                      " AND lp.contr_itm2mod_level    = ml.objid" & _
                      " AND ml.part_info2part_num     = pn.objid" & _
                      " AND pn.x_av_cross_ref         = code.x_av_code" & _
                      " AND code.x_av_type            = 'BDS2_BUNDLE'" & _
                      " AND code.x_av_libelle            = 'Option Multi Sim MOVE'" & _
                      " AND attr.n_focuslowid         = lp.objid" & _
                      " AND attr.x_av_value2n_properties = prop.objid" & _
                      " AND prop.x_av_cross_ref       = code.x_av_code_2" & _
                      " AND ls.objid                  = attr.n_targetlowid" & _
                      " AND ls.child2contr_itm        IS NULL" & _
                      " AND xav.x_av_type             = 'TYPE_LIGNE_SECONDAIRE'" & _
                      " AND ls.x_av_type_article      = xav.x_av_num " & _
                      " ORDER BY 1"

    lstBdsSec.ItemType = "Long"
    toDB.Select strSQLStatement, lstBdsSec

    If lstBdsSec.Count > 0 Then
       'Verifier que le contrat source a un lot des lignes secondaires
        br.SimpleQuery  0, gcstCOMVarSite
        br.AppendFilter 0, gcstCOMVarSITEID, cbEqual, recSuivi.GetField ("x_av_cf_cible")
        br.SimpleQuery  1, gcstCOMVarContrItm
        br.AppendFilter 1, gcstCOMVarObjid, cbEqual, lstBdsSec.ItemByIndex(0)
        br.TraverseFromParent 2, "contr_itm2contr_schedule", 1
        br.RetrieveRecords

        Set lstTmp = br.getRecordList(2)
        If lstTmp.Count = 1 Then
            Set recTmp = lstTmp.ItemByIndex(0)
            StrTrplLotSec = recTmp.getfield("x_av_family") & "|" & recTmp.getfield("x_av_line") & "|" & recTmp.getfield("x_av_offer")
        Else
            ErrMessage = "Lot source des lignes secondaires introuvable pour la demande " & recSuivi.GetField(gcstCOMVarObjid)
            Call EnErreur(lobjidSuivi, ErrMessage)
            Goto CleanUp
        End If

        Set lstTmp = br.getRecordList(0)
        If lstTmp.Count = 1 Then
            Set recTmp   = lstTmp.ItemByIndex(0)
            objidCFcible = recTmp.GetField(gcstCOMVarObjid)
        Else
            ErrMessage = "CF Cible introuvable pour la demande " & recSuivi.GetField(gcstCOMVarObjid)
            Call EnErreur(lobjidSuivi, ErrMessage)
            Goto CleanUp
        End If

        'Si le lot cible n'est pas renseigné dans la demande et n'a pas été crée après l'enregistrement de la demande, alors il faut le créer ici dans le batch :
        br.clear
        br.SimpleQuery  0, gcstCOMVarContrItm
        br.AppendFilter 0, gcstCOMVarObjid, cbEqual, recSuivi.GetField("x_av_focus_id")
        br.TraverseFromParent 1, "contr_itm2contr_schedule", 0
        br.RetrieveRecords

        Set lstTmp = br.getRecordList(1)
        If lstTmp.Count = 1 Then
            Set recTmp = lstTmp.ItemByIndex(0)
            StrTrplLotPrc = recTmp.getfield("x_av_family") & "|" & recTmp.getfield("x_av_line") & "|" & recTmp.getfield("x_av_offer")
        Else
            ErrMessage = "Lot source de la ligne principale introuvable pour la demande " & recSuivi.GetField(gcstCOMVarObjid)
            Call EnErreur(lobjidSuivi, ErrMessage)
            Goto CleanUp
        End If

        'Recuperer le lot de la ligne principale
        strSQLStatement = " SELECT sch.objid" & _
                          " FROM table_contr_schedule sch," & _
                         "      table_contract con" & _
                         " WHERE sch.bill_to2site = " & objidCFcible & _
                          " AND con.id = '" & recSuivi.GetField("x_av_id_contract_cible") & "'" & _
                          " AND sch.schedule2contract = con.objid " & _
                          " AND sch.x_av_family || '|' || sch.x_av_line || '|' || sch.x_av_offer = '" & StrTrplLotPrc & "'"

        lstLotCiblePrc.ItemType = "Long"
        toDB.Select strSQLStatement, lstLotCiblePrc

        If lstLotCiblePrc.Count > 0 Then
            objidLotCibleLP = lstLotCiblePrc.ItemByIndex(0)
        Else
            If recSuivi.GetField ("x_av_id_contr_schedule_cible") <> 0 Then
                objidLotCibleLP = recSuivi.GetField ("x_av_id_contr_schedule_cible")
            Else
                objidLotCibleLP = CreateNewSchedule(lobjidSuivi, objidCFcible, objidCFcible, recSuivi.GetField("x_av_id_contract_cible"),StrTrplLotPrc , False)
                If objidLotCibleLP = 0 Then Goto CleanUp
            End If
        End if

        If recSuivi.GetField ("x_av_id_contr_schedule_cible") = gcstCOMVarVide then
                recSuivi.SetField "x_av_id_contr_schedule_cible", objidLotCibleLP
                bs.UpdateRecord recSuivi
                bs.Save
        End If


        'Recuperer le lot des lignes secondaires
        strSQLStatement = " SELECT sch.objid" & _
                          " FROM table_contr_schedule sch," & _
                          "      table_contract con" & _
                          " WHERE sch.bill_to2site = " & objidCFcible & _
                          " AND con.id = '" & recSuivi.GetField("x_av_id_contract_cible") & "'" & _
                          " AND sch.schedule2contract = con.objid " & _
                          " AND sch.x_av_family || '|' || sch.x_av_line || '|' || sch.x_av_offer = '" & StrTrplLotSec & "'"

        lstLotCible.ItemType = "Long"
        toDB.Select strSQLStatement, lstLotCible
        If lstLotCible.Count > 0 Then
            objidLotCible = lstLotCible.ItemByIndex(0)
        Else
            objidLotCible = CreateNewSchedule(lobjidSuivi, objidCFcible, objidCFcible, recSuivi.GetField("x_av_id_contract_cible"), StrTrplLotSec, True)
            If objidLotCible = 0 Then Goto CleanUp
        End If

        ' insertion nouvelle demande pour chaque ligne secondaire :
        For indx  = 0 To lstBdsSec.Count - 1
            objidBdsSec = lstBdsSec.ItemByIndex(indx)

            ' Vérifier qu'il n'y a pas de demandes sur la Ligne Secondaire (cas de retraitement d'une demande en erreur sur la ligne principale)
            br.Clear
            br.SimpleQuery 0, SUIVICHMTCF
            br.AppendFilter 0, "x_av_focus_id", cbEqual, objidBdsSec
            br.AppendFilter 0, "x_av_id_contr_schedule_cible", cbEqual, objidLotCible
            br.AppendFilter 0, gcstCOMVarSTATUSAV, cbNotEqual, cstSuiviOK
            br.AppendFilter 0, gcstCOMVarSTATUSAV, cbNotEqual, "Annulé"
            br.RetrieveRecords
            Set lstTmp = br.GetRecordList(0)
            If lstTmp.Count = 0 Then
                Set recNewSuivi = recSuivi.Copy(cbChangeToNew)
                recNewSuivi.SetField "x_av_focus_id", objidBdsSec
                recNewSuivi.SetField "x_av_id_contr_schedule_cible", objidLotCible
                bs.InsertRecord recNewSuivi
                bs.Save

                TRUELOG WriteLog(SUBMAINCHMTCF,"15090109",Info, "Ajout et traitement demande pour ligne secondaire : " & recNewSuivi.GetField(gcstCOMVarObjid))
                Call ChmtCFPrice(recNewSuivi.GetField(gcstCOMVarObjid))
            End If
        Next indx
    Else
        ErrMessage = "Aucune ligne secondaire n est trouve"
        Call EnErreur(lobjidSuivi, ErrMessage)
    End If

CleanUp:
    Set br              = Nothing
    Set bs              = Nothing
    Set lstBdsSec       = Nothing
    Set toDB            = Nothing
    Set lstTmp          = Nothing
    Set lstLotCible     = Nothing
    Set recSuivi        = Nothing
    Set lstSuivi        = Nothing
    Set recNewSuivi     = Nothing
    Set recTmp          = Nothing
    strSQLStatement     = ebnullstring

    Exit Sub
Error_Handling:
    TRUELOG WriteLog(SUBCHMTCFPRICE,"40090009"," [SUIVI : " + cstr(lobjidSuivi) + "]" + Warn , " Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description)
    lngWarnCount = lngWarnCount + 1
End Sub
'FIN AEL
Sub ChmtCFPrice(lobjidSuivi As Long)
On Error Goto Error_Handling
    Dim br              As New BulkRetrieve
    Dim br2             As New BulkRetrieve
    Dim bs              As New BulkSave
    Dim toDB            As New SQLDB
    Dim strSQLStatement As String
    Dim typResponse     As ResString
    Dim lstParameters   As New List
    Dim lstSuivi        As New List
    Dim lstBDS          As New List
    Dim lstAttribut     As New List
    Dim lstAjustements  As New List
    Dim lstTmp          As New List
    Dim lstTmp5         As New List
    Dim recTmp          As Record
    Dim recTmp2         As Record
    Dim recSuivi        As Record
    Dim recContrat      As Record
    Dim recContratCible As Record
    Dim recLotCible     As Record
    Dim recCFCible      As Record
    Dim recCUCible      As Record
    Dim recLotSource    As Record
    Dim recCFSource     As Record
    Dim recCUSource     As Record
    Dim recBDSSource    As Record
    Dim recOldLI        As Record
    Dim recNewLI        As Record
    Dim recPartnum      As Record
    Dim recNewAttribute As Record
    Dim recNewAjustement As Record
    Dim recBDS          As Record
    Dim ErrMessage      As String
    Dim strDateEffet    As String
    Dim strDateResil    As String
    Dim i               As Integer
    Dim j               As Integer
    Dim s               As Integer
    Dim nbrBDS          As Long
    Dim maxPLineNo      As Integer
    Dim BDS1Objid       As Long
    Dim objidAccesCible As Long
    Dim objidLotCible   As Long
    Dim modLevelObjid   As Long
	Dim ObjidBdsACCible	As Long
	Dim ObjidBdsACSource	As Long
    Dim nextLineNo      As Integer
    Dim xRefAttrMSIM    As String
    Dim recAccesCible   As Record
    Dim isBds1          As boolean
    Dim StrTrplLotSrc   As String
    Dim blnAC           As boolean
    Dim blnBdsAc        As boolean
    'Dim blnBdsAcMaintenue As boolean
    Dim recAc           As Record
    Dim lstBdsAc        As New List
    Dim strNomAc        As String
    Dim strOldNomAc     As String
    Dim strVersionAc    As String
    Dim strIdCoffre     As String
    Dim ordListAC       As New List
    Dim ordListAC2      As New List
    Dim SqlStatement	As String
	Dim recAttribute	As Record
	Dim doInsertArb 	As boolean
	Dim lstHisto 		As New list
	Dim lstBdsContrat	As New list
    Dim rec_lot_cible 	as new record
	Dim lstLineMax 		As New list
	dim objidBds1 		As String
    dim existBDS1       As Long

    debug.print "Traitement de la ligne de suivi (Price) : " & lobjidSuivi

    br.SimpleQuery 0, SUIVICHMTCF
    br.AppendFilter 0, gcstCOMVarObjid, cbEqual, lobjidSuivi
    br.RetrieveRecords

    Set lstSuivi = br.GetRecordList(0)
    Set recSuivi = lstSuivi.ItemByIndex(0)

    ' Trace COR C17720855
    TRUELOG WriteLog(SUBCHMTCF,"70090010","[SUIVI : " + cstr(lobjidSuivi) + "]", "Début  traitement ChmtCFPrice.")

    br.Clear
    br.SimpleQuery  0, gcstCOMVarContract
    br.AppendFilter 0, gcstCOMVarID, cbEqual, recSuivi.GetField ("x_av_id_contract")
    br.SimpleQuery  1, gcstCOMVarContrSchedule
    br.AppendFilter 1, gcstCOMVarObjid, cbEqual, recSuivi.GetField ("x_av_id_contr_schedule_cible")
    br.SimpleQuery 2, gcstCOMVarSite
    br.AppendFilter 2, gcstCOMVarSITEID, cbEqual, recSuivi.GetField("x_av_cf_cible")
    br.SimpleQuery 3, gcstCOMVarSite
    If Len (recSuivi.GetField("x_av_cu_cible")) > 0 Then
        br.AppendFilter 3, gcstCOMVarSITEID, cbEqual, recSuivi.GetField("x_av_cu_cible")
    Else
        br.AppendFilter 3, gcstCOMVarSITEID, cbEqual, -2
    End If
    br.SimpleQuery  4, gcstCOMVarContrSchedule
    br.AppendFilter 4, gcstCOMVarObjid, cbEqual, recSuivi.GetField ("x_av_id_contr_schedule")
    br.TraverseFromParent 5, "bill_to2site", 4
    br.TraverseFromParent 6, "ship_to2site", 4
'''    br.TraverseFromParent 7, "schedule2contr_itm", 1
'''    br.AppendSort 7, "p_line_no", cbDescending
    br.SimpleQuery  7, gcstCOMVarContract
    br.AppendFilter 7, gcstCOMVarID, cbEqual, recSuivi.GetField ("x_av_id_contract_cible")
    br.SimpleQuery  8, "x_av_code"
    br.AppendFilter 8, "x_av_type", cbEqual, "BDS2_BUNDLE"
    br.AppendFilter 8, "x_av_code", cbEqual, "LIEN_OPTION_MSIM"
    br.AppendFilter 8, "x_av_libelle", cbEqual, "Option Multi Sim MOVE"
    br.SimpleQuery 9, gcstCOMVarContrItm
    br.AppendFilter 9, gcstCOMVarObjid, cbEqual, recSuivi.GetField("x_av_acces_cible")
    br.SimpleQuery 10, gcstCOMVarContrItm
    br.AppendFilter 10, gcstCOMVarObjid, cbEqual, recSuivi.GetField("x_av_focus_id")
 '''   br.TraverseFromParent 11, "contract2contr_schedule", 8
 '''   br.TraverseFromParent 12, "schedule2contr_itm", 11
    'br.AppendFilter 12, "line_no", cbEqual, 1
    br.RetrieveRecords

    Set lstTmp     = br.GetRecordList(0)
    Set recContrat = lstTmp.ItemByIndex(0)
    Set lstTmp     = br.GetRecordList(7)
    Set recContratCible = lstTmp.ItemByIndex(0)

    Set lstTmp = br.GetRecordList(4)
    If lstTmp.Count <> 1 Then
        ErrMessage = cstSuiviWarn & "Lot Source"
        Call EnErreur(lobjidSuivi, ErrMessage)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    End If
    Set recLotSource = lstTmp.ItemByIndex(0)

    Set lstTmp = br.GetRecordList(5)
    If lstTmp.Count <> 1 Then
        ErrMessage = cstSuiviWarn & "CF Source"
        Call EnErreur(lobjidSuivi, ErrMessage)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    End If
    Set recCFSource = lstTmp.ItemByIndex(0)
    Set lstTmp = br.GetRecordList(6)

    If lstTmp.Count <> 1 Then
        ErrMessage = cstSuiviWarn & "CU Source"
        Call EnErreur(lobjidSuivi, ErrMessage)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    End If
    Set recCUSource = lstTmp.ItemByIndex(0)
    Set recCUCible  = lstTmp.ItemByIndex(0)

    If Len (recSuivi.GetField("x_av_cu_cible")) > 0 Then
        Set lstTmp = br.GetRecordList(3)
        If lstTmp.Count <> 1 Then
            ErrMessage = cstSuiviWarn & "CU cible"
            Call EnErreur(lobjidSuivi, ErrMessage)
            lngErrCount = lngErrCount + 1
            GoTo Cleanup1
        End If
        Set recCUCible = lstTmp.ItemByIndex(0)
    End If

    Set lstTmp = br.GetRecordList(2)
    If lstTmp.Count <> 1 Then
        ErrMessage = cstSuiviWarn & "CF cible"
        Call EnErreur(lobjidSuivi, ErrMessage)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    End If
    Set recCFCible = lstTmp.ItemByIndex(0)

 '''   Set lstTmp = br.GetRecordList(12)
	lstBdsContrat.ItemType = "long"
	strSQLStatement = "select count(1) from table_contr_schedule s join table_contr_itm i on (s.objid = i.contr_itm2contr_schedule) " & _
						"where s.schedule2contract = " & recContratCible.GetField(gcstCOMVarObjid)

	toDB.Select strSQLStatement,lstBdsContrat
    nbrBDS = lstBdsContrat.ITEMBYINDEX(0)

    If recSuivi.GetField("x_av_acces_cible") > 0 Then
        Set lstTmp = br.GetRecordList(9)
        If lstTmp.Count <> 1 Then
            ErrMessage = cstSuiviWarn & "Acces cible"
            Call EnErreur(lobjidSuivi, ErrMessage)
            lngErrCount = lngErrCount + 1
            GoTo Cleanup1
        End If
        Set recAccesCible = lstTmp.ItemByIndex(0)
    End If

	'-------------------------------------------
	' Vérification catégorie BDS source
	'-------------------------------------------
	Dim strCategSource	As String
	strCategSource = constCATEGORIEMOBILE
	Set lstTmp = br.GetRecordList(10)
	If lstTmp.Count > 0 Then
		Set recBDSSource = lstTmp.ItemByIndex(0)
		strCategSource = recBDSSource.GetField("x_av_categorie")
	End If
		
	If strCategSource = constCATEGORIEMOBILE Then
        Set recCUCible = recCFCible
	End If

    ' Trace COR C17720855
    TRUELOG WriteLog(SUBCHMTCF,"70090010","[SUIVI : " + cstr(recSuivi.GetField(gcstCOMVarObjid)) + "]", recSuivi.GetField(gcstCOMVarAVTYPE) & " Après initialisation données.")

    '-----------------------------------
    ' Controles sur les statuts des BDS
    '------------------------------------
    If Not CheckBDSStatus(recSuivi.GetField("x_av_focus_id")) Then
        ErrMessage = "certaines BDS ne sont pas à un statut stable !"
        Call EnErreur(lobjidSuivi, ErrMessage)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    End If
	
	' # 30-05-2017 - KKAN : COR C18284878 - Début >
    If checkBDS2ParcDuo(recSuivi.GetField("x_av_focus_id")) Then
		'debug.print "checkBDS2ParcDuo | x_av_focus_id : " & recSuivi.GetField("x_av_focus_id")
        ErrMessage = CtiNonPermisPDuoA
        Call EnErreur(lobjidSuivi, ErrMessage)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    End If
	' # 30-05-2017 - KKAN : COR C18284878 - Fin >

    '--------------------------------------------------------------------
    ' Controles sur le site de facturation et d'installation du lot cible
    '--------------------------------------------------------------------
    lstParameters.Clear
    lstParameters.ItemType = gstrCOMVarVARIANT
    lstParameters.AppendItem recCFCible.GetField(gcstCOMVarObjid), recCUCible.GetField(gcstCOMVarObjid), recContrat.GetField(gcstCOMVarObjid)
    toDB.ExecuteProc "SA.VERIF_CF", lstParameters, typResponse
    If typResponse.response <> gcstCOMVarVide Then
        Call EnErreur(lobjidSuivi, typResponse.response)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    End If

    Set lstTmp = br.GetRecordList(1)
    'IAD Move5 //// Création d'un lot cible s'il n'existe pas
    If lstTmp.Count = 0 Then
        StrTrplLotSrc = recLotSource.getfield("x_av_family") & "|" & recLotSource.getfield("x_av_line") & "|" & recLotSource.getfield("x_av_offer")

		objidLotCible = CreateNewSchedule(lobjidSuivi,recCFCible.GetField(gcstCOMVarObjid), recCUCible.GetField(gcstCOMVarObjid), _
										recSuivi.GetField("x_av_id_contract_cible"), StrTrplLotSrc, False)
		
        br2.Clear
        br2.SimpleQuery  0, gcstCOMVarContrSchedule
        br2.AppendFilter 0, gcstCOMVarObjid, cbEqual, objidLotCible
        br2.RetrieveRecords
        Set lstTmp = br2.GetRecordList(0)
        Set recLotCible = lstTmp.ItemByIndex(0)
    ElseIf lstTmp.Count > 1 Then
        ErrMessage = cstSuiviWarn & "Lot cible"
        Call EnErreur(lobjidSuivi, ErrMessage)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    Else
        Set recLotCible = lstTmp.ItemByIndex(0)
        objidLotCible = recLotCible.GetField(gcstCOMVarObjid)
    End If

    dim rec_site_cible as new record
    set lstTmp = br.GetRecordList(2)
    set rec_site_cible = lstTmp.ItemByIndex(0)

    Set lstTmp5 = br.GetRecordList(1)
    'Plusieurs demandes portent sur des lignes qui partent sur un même lot ! Se rappeler que le lot cible si il n'est pas renseigné dans la demande
    'cela ne veut pas dire qu'il n'a pas été créé !!!!
    if lstTmp5.Count > 0 Then
		set rec_lot_cible = lstTmp5.ItemByIndex(0)

		lstLineMax.ItemType = "long"
		strSQLStatement = "select NVL(max(p_line_no), 0)+1 from table_contr_itm where contr_itm2contr_schedule = " & rec_lot_cible.GetField(gcstCOMVarObjid)

		toDB.Select strSQLStatement,lstLineMax
		maxPLineNo = lstLineMax.ITEMBYINDEX(0)
    Else
		lstLineMax.ItemType = "long"
		strSQLStatement = "select NVL(max(p_line_no), 0)+1 from table_contr_itm where contr_itm2contr_schedule = " & objidLotCible

		toDB.Select strSQLStatement,lstLineMax
		maxPLineNo = lstLineMax.ITEMBYINDEX(0)
    End If

    Set lstTmp = br.GetRecordList(8)
    If lstTmp.Count <> 0 Then
        Set recTmp   = lstTmp.ItemByIndex(0)
        xRefAttrMSIM = recTmp.GetField("x_av_code_2")
    Else
        TRUELOG WriteLog(SUBMAINCHMTCF,"15090109",Warn, "Le paramétrage de la Xref de l'attribut Numéro complice n'as pas été trouvé")
    End If

    '-------------------------------------------------------------------
    'Contrôle sur la date de début de facturation des BDS à transférer :
    '-------------------------------------------------------------------
    Set LstTmp = New List
    lstTmp.ItemType = gcstCOMVarSTRING


    '-------------------------------------------
    ' Copie de la BDS1 et ses BDS2 non résiliées
    '-------------------------------------------
    lstBDS.ItemType = gcstCOMVarLONG

    br.Clear
    br.SimpleQuery 0, gcstCOMVarContrItm
    br.AppendFilter 0, gcstCOMVarObjid, cbEqual, recSuivi.GetField("x_av_focus_id")
    br.TraverseFromParent 1, "parent2contr_itm", 0
    br.AppendFilter 1, "x_av_statut_act", cbnotequal, "Résilié"
    br.RetrieveRecords

    Set lstTmp = br.GetRecordList(0)
    If lstTmp.Count <> 1 Then
        ErrMessage = cstSuiviWarn & "BDS Source"
        Call EnErreur(lobjidSuivi, ErrMessage)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    End If
    Set recBDSSource = lstTmp.ItemByIndex(0)

    ' Cas de lot vide créé depuis IHM contrat
    ' Valider le lot pour qu'il soit remonté à la BF (notif PropagLotBFO)
	If Not recLotCible.GetField("x_av_version") = recContratCible.GetField("x_av_current_version") Then
		recLotCible.SetField "x_av_version", recContratCible.GetField("x_av_current_version")
	End If
    recLotCible.SetField "x_av_last_validated", recLotCible.GetField("x_av_version")
    recLotCible.SetField "x_av_valid_flag", 1
    bs.UpdateRecord recLotCible

    If recSuivi.GetField("x_av_type") = cstChangementTitulaire And nbrBDS = 0 And recContratCible.GetField("x_av_current_version") = "1" And recContratCible.GetField("x_av_last_validated") = "0" Then
        recContratCible.SetField "x_av_last_validated", "1"
        recContratCible.SetField "x_av_flag_modif_legacy", 0
        bs.UpdateRecord recContratCible
    End If

    lstBDS.AppendItem recSuivi.GetField("x_av_focus_id")

    Set lstTmp = br.GetRecordList(1)
    For i = 0 To lstTmp.Count - 1
        Set recOldLI = lstTmp.ItemByIndex(i)
        lstBDS.AppendItem recOldLI.GetField(gcstCOMVarObjid)
    Next i

    
    If ( Format(DateAdd(gcstCOMVarD, 1, recSuivi.GetField("x_av_date_effet")), "yymmdd") > Format(DateAdd(gcstCOMVarD, 1, App.CurrentDate ), "yymmdd") ) Then
        strDateEffet = Format(DateAdd(gcstCOMVarD, 1, recSuivi.GetField("x_av_date_effet")), "dd/mm/yyyy")
        strDateResil = Format(recSuivi.GetField("x_av_date_effet"), "dd/mm/yyyy")
    ELSE
        strDateEffet = Format(DateAdd(gcstCOMVarD, 1, App.CurrentDate), "dd/mm/yyyy")
        strDateResil = Format(recSuivi.GetField("x_av_date_effet"), "dd/mm/yyyy")
    End If

    nextLineNo = 1

    Dim premiereBds As Integer
    premiereBds = 0

    'IAD Move5.1 : Traiter selon la Catégorie
    ' 1 - Cas Fixe Unitaire : Mise à jour du lien entre les BDS et le CF, pas de résiliation/recréation dans ce cas.
    If (recBDSSource.GetField("x_av_categorie") = strFixe) AND (recSuivi.GetField("x_av_acces_cible") = 0 AND recSuivi.GetField("x_av_type") <> cstChangementTitulaire) Then
        For i = 0 To lstBDS.Count - 1
            Set recOldLI = New Record

            br.Clear
            br.SimpleQuery 0, gcstCOMVarContrItm
            br.AppendFilter 0, gcstCOMVarObjid, cbEqual, lstBDS.ItemByIndex(i)
            br.TraverseFromParent 1, "contr_itm2mod_level", 0
            br.TraverseFromParent 2, "part_info2part_num", 1
            br.RetrieveRecords

            Set lstTmp = br.GetRecordList(2)
            Set recPartnum = lstTmp.ItemByIndex(0)

            Set lstTmp = br.GetRecordList(0)
            Set recOldLI  = lstTmp.ItemByIndex(0)

            ' Mise à jour CF
            If recPartnum.GetField("x_av_gen_si")          = "1"   Or _
               recPartnum.GetField("x_av_part_prov_level") = "CF"  OR _
               recPartnum.GetField("x_av_install_type")    = "F2"  Or _
               recPartnum.GetField("x_av_install_type")    = "IF2" Then

                bs.RelateRecords recOldLI, recCFCible, gcstCOMVarAVBILLTO2SITE
            End If
            'Suppression du flag « Changement de CU/CF demandé » au niveau de la BDS1
            recOldLI.SetField "x_av_chgmt_cu_cf", 0

            bs.UpdateRecord recOldLI
            bs.Save
            '-------------------------------------
            ' Synchronisation avec Arbor (C7821966 uniquement les BDS facturables, pas les BDS porteuses de SI)
            '-------------------------------------
            If recPartnum.GetField("x_av_install_type") = "F"   Or _
               recPartnum.GetField("x_av_install_type") = "IF"  Then

                'Appel de résiliation Arbor pour la BDS créée
                recOldLI.SetField "x_av_nb_transf", recOldLI.GetField("x_av_nb_transf") + 1
                bs.UpdateRecord recOldLI
                bs.Save

				doInsertArb = False
				
				If recOldLI.getfield("x_av_arb_status") = "CRE_ARB" Or recOldLI.getfield("x_av_arb_status") = "MOD_ARB" Then
					doInsertArb = True
				ElseIf recOldLI.getfield("x_av_arb_status") = "MOD_ERR" Or _
					recOldLI.getfield("x_av_arb_status") = "CRE_ERR" Or _
					recOldLI.getfield("x_av_arb_status") = "MOD_C2A" Or _
					recOldLI.getfield("x_av_arb_status") = "RES_ERR" Or _
					recOldLI.getfield("x_av_arb_status") = "RES_C2A" Then

					'Dim toDB			As New SQLDB
					'Dim lstHisto As New list
					'Dim strSQLStatement	As String
					lstHisto.ItemType = "long"

					strSQLStatement = "select count(1) from table_x_av_hist_view " & _
					"where x_av_objid_itm =" & recOldLI.getfield("objid") & _
					" and x_av_last_status IN ('CRE_ARB', 'MOD_ARB')"

					toDB.Select strSQLStatement,lstHisto
					If lstHisto.ITEMBYINDEX(0) > 0 Then
						doInsertArb = True
					End If
				End if
				
				
				If doInsertArb Then
					'COR C15923648 - Début >
					'debug.print "Etape 6"
					Call InsererEvenementArbor ( bs, Cstr(recOldLI.GetField(gcstCOMVarObjid)), 1, 3, App.CurrentDate, strDateEffet, gcstCOMVarVide , "CLA", 0, recCFSource.GetField(gcstCOMVarObjid), 0)
					'COR C15923648 - Fin >

					recOldLI.SetField "x_av_status_c2a", "Résilié - Transmis"
					
				Else
					'debug.print "Etape 7"
					recOldLI.setfield "x_av_status_c2a", "Résilié - Traité"
					recOldLI.setfield "x_av_arb_status", "RES_ARB"
				End if
				
				'debug.print "Etape 8"
                'Appel de création Arbor pour la BDS créée
'COR C15923648 - Début >
                Call InsererEvenementArbor ( bs, Cstr(recOldLI.GetField(gcstCOMVarObjid)), 1, 1, App.CurrentDate, strDateEffet, gcstCOMVarVide , "CLA", 0, 0, 0)
'COR C15923648 - Fin >

                recOldLI.SetField "x_av_status_c2a", "Facturé - Transmis"
                bs.UpdateRecord recOldLI
                bs.Save
            End If

            'KAR Evol 845
            If i = 0 And recCFCible.GetField("x_av_bill_cycle") <> recCFSource.GetField("x_av_bill_cycle") then
                Call GenerateNotifChgtSruct(lobjidSuivi, recOldLI.GetField(gcstCOMVarObjid), recOldLI.GetField("create_date"), recOldLI.GetField("last_mod_dt"))
            End If
            'Fin KAR
        Next i
    Else
		'IAD Move5.1 : Traiter selon la Catégorie
        ' 2 - Cas Acces + Mobile + Fixe rattaché a un accès
		
		'Récupération des motifs de la table_x_av_code : utile dans le traitement des BDS
		Dim lstMotifTitulaie    As New List
        Dim lstMotifPayeur      As New List
        Dim recMotif            As Record
		Dim lstMotif        	As New List
        Dim recMotifCible		As Record

		br2.Clear
        br2.SimpleQuery 0, "x_av_code"
        br2.AppendFilter 0, "x_av_type", cbEqual, "MOTIF_PRICE"
        br2.AppendFilter 0, "x_av_code", cbEqual, "Changement Titulaire"
        br2.SimpleQuery 1, "x_av_code"
        br2.AppendFilter 1, "x_av_type", cbEqual, "MOTIF_PRICE"
        br2.AppendFilter 1, "x_av_code", cbEqual, "Changement Payeur"
        br2.RetrieveRecords
        Set lstMotifTitulaie = br2.GetRecordList(0)
        Set lstMotifPayeur   = br2.GetRecordList(1)
		if lstMotifPayeur.count = 0 or lstMotifPayeur.count = 0 then
			TRUELOG WriteLog(SUBCHMTCF,"70090130","Le paramétrage : MOTIF_PRICE de la BDS source n'existe pas dans la table x_av_code", "")
        End If
		
        br2.clear
        br2.SimpleQuery 0, "x_av_code"
        br2.AppendFilter 0, "X_AV_TYPE", cbEqual, "MOTIF_PRICE"
        br2.AppendFilter 0, "X_AV_CODE", cbEqual, "XREF_MOTIF_ARRIVE"
        br2.RetrieveRecords

        Set lstMotif = br2.GetRecordList(0)
        if lstMotif.count = 0 then
            TRUELOG WriteLog(SUBCHMTCF,"70090130","Le paramétrage : MOTIF_PRICE de la BDS cible n'existe pas dans la table x_av_code 4", "")
        end if
		' Fin récupération des motifs

		blnAC = False
		ObjidBdsACCible = 0
		ObjidBdsACSource = 0
		strIdCoffre = ""
        For i = 0 To lstBDS.Count - 1
            isBds1 = False
            Set recNewLI = New Record
            Set recOldLI = New Record

            br.Clear
            br.SimpleQuery 0, gcstCOMVarContrItm
            br.AppendFilter 0, gcstCOMVarObjid, cbEqual, lstBDS.ItemByIndex(i)
            br.TraverseFromParent 1, "contr_itm2mod_level", 0
            br.TraverseFromParent 2, "part_info2part_num", 1
            br.TraverseFromParent 3, "child2contr_itm", 0
            br.RetrieveRecords

            Set lstTmp = br.GetRecordList(1)
            Set recPartnum = lstTmp.ItemByIndex(0)
            modLevelObjid  = recPartnum.GetField(gcstCOMVarObjid)

            Set lstTmp = br.GetRecordList(2)
            Set recPartnum = lstTmp.ItemByIndex(0)

            Set lstTmp = br.GetRecordList(0)
            Set recOldLI  = lstTmp.ItemByIndex(0)
            Set lstTmp = br.GetRelatedRecordList(recOldLI, "child2contr_itm")
            existBDS1 = lstTmp.count
            
            'ITEM 1117 : Gestion des BdS Version Commerciale
			blnBdsAc = False
            If recPartnum.GetField("x_av_cross_ref") = "VERSION_COMMERCIALE" Then
				'Il s'agit d'une BdS Version Commerciale
				ObjidBdsACSource = lstBDS.ItemByIndex(i)
				blnBdsAc = True
				blnAC = True
				
				If recSuivi.GetField("x_av_type") = cstChangementTitulaire Then
					strNomAc = ""
					strVersionAc = ""
					Set ordListAC = New List
					ordListAC.ItemType = gcstCOMVarSTRING
				
					SqlStatement = "SELECT cc.x_av_ggd_code " & _
									"FROM table_x_av_mtm_cc2contract m, table_x_av_contr_cadre cc " & _
									"WHERE m.x_av_mtm_cc2contract  = " & cstr(recContratCible.GetField(gcstCOMVarObjid)) & _
									"  AND m.x_av_mtm_contract2cc  = cc.objid " & _
									"  AND m.x_av_date_debut_ratt <= trunc(SYSDATE) " & _ 
									"  AND trunc(SYSDATE) < NVL(m.x_av_date_fin_ratt, SYSDATE+1) " & _
									"  AND ROWNUM               =  1 "
					toDB.Select SqlStatement, ordListAC
				
					If (ordListAC.Count > 0 ) then
						strNomAc = ordListAC.ItemByIndex(0)
					
						Set ordListAC2 = New List
						ordListAC2.ItemType = gcstCOMVarLONG
				
						SqlStatement = "SELECT MAX(r.x_ref_version_ggd) " & _
										"FROM table_x_ref_vc r " & _
										"WHERE r.x_ref_code_ggd = '" & strNomAc & "'"
						toDB.Select SqlStatement, ordListAC2
				
						If (ordListAC2.Count > 0 ) then
							strVersionAc = cstr(ordListAC2.ItemByIndex(0))
						End If
					End If
				End If
			End If

			Set recNewLI = recOldLI.Copy(cbChangeToNew)
            'ITEM 1117 : Fin de gestion des BdS Version Commerciale

			'IAD Move5.1 : Traiter selon la Catégorie
			' Cas de ligne Fixe, la ligne reste sur le même accès après déplacement sur le lot cible.
			If (recBDSSource.GetField("x_av_categorie") = strFixe) AND (recSuivi.GetField("x_av_acces_cible") <> 0 ) AND (i=0) Then
				bs.RelateRecords recNewLI, recAccesCible, "x_av_itm2acces"
			End If
			'Fin IAD

			' BDS facturables
			If recPartnum.GetField("x_av_install_type") = "F"   Or _
				recPartnum.GetField("x_av_install_type") = "IF"  Then

				If (recOldLI.GetField("x_av_arb_status") <> "CRE_ARB" Or _
				recOldLI.GetField("x_av_arb_status") <> "MOD_ARB") And _
				recPartnum.GetField("x_av_type") <> "NRC" Then
					recNewLI.SetField "x_av_statut_act", "Créé"
					recNewLI.SetField "x_av_status_c2a", "Prêt à Facturer"
					recNewLI.SetField "x_av_arb_status", "Initialisation"
				ElseIf recPartnum.GetField("x_av_cross_ref") = "CFE_TERM" And _ ' COR C20123366
				recPartnum.GetField("x_av_type") = "NRC" Then
					recNewLI.SetField "x_av_statut_act", "Créé"
					recNewLI.SetField "x_av_etat_act",   "Réalisé"
					recNewLI.SetField "x_av_code_etat",  "Traité"
				Else
					recNewLI.SetField "x_av_statut_act", "Résilié"
					recNewLI.SetField "x_av_status_c2a", "Résilié - Traité"
					recNewLI.SetField "x_av_arb_status", "RES_ARB"
				End If

				recNewLI.SetField gcstCOMVarCHGSTARTDT, strDateEffet
' MAT JIRA 2615 >
			ElseIf recPartnum.GetField("x_av_install_type") = "I" And recPartnum.GetField("x_av_gen_si") = 1 Then
				recNewLI.SetField gcstCOMVarCHGSTARTDT, strDateEffet
' MAT JIRA 2615 <
			End If

			recNewLI.SetField gcstCOMVarCHGENDDT, "01/01/1753" ' MAT VSR 59

			' C7821966 - BDS génératrice de SI : le statut du si doit être vidé.
			If recPartnum.GetField("x_av_gen_si") = "1" Then
				recNewLI.SetField "x_av_statut_si", ""
			End If

			'Suppression du flag « Changement de CU/CF demandé » au niveau de la BDS1
			recOldLI.SetField "x_av_chgmt_cu_cf", 0

			recNewLI.SetField "create_date", App.Currentdate
			recNewLI.SetField "x_av_id_import", ""
			recNewLI.SetField "x_av_num_mvt",   ""
			recNewLI.SetField "x_av_chgmt_cu_cf", 0
			


			' Résilier les BDS facturables (C7821966 uniquement les BDS facturables, pas les BDS porteuses de SI)
			If recPartnum.GetField("x_av_install_type") = "F" And _
			(recOldLI.GetField("x_av_arb_status") <> "CRE_ARB" Or _
			recOldLI.GetField("x_av_arb_status") <> "MOD_ARB") And _
			recPartnum.GetField("x_av_type") <> "NRC" Then
				recOldLI.SetField "x_av_statut_act", "Résilié"
				recOldLI.SetField "x_av_status_c2a", "Prêt à Résilier"
				recOldLI.SetField "x_av_arb_status", "CRE_ARB"
				recOldLI.SetField gcstCOMVarCHGENDDT, strDateEffet
			ElseIf recPartnum.GetField("x_av_install_type") = "IF" And _
			(recOldLI.GetField("x_av_arb_status") <> "CRE_ARB" Or _
			recOldLI.GetField("x_av_arb_status") <> "MOD_ARB") And _
			recPartnum.GetField("x_av_type") <> "NRC" Then
				recOldLI.SetField "x_av_statut_act", "Résilié"
				recOldLI.SetField "x_av_status_c2a", "Prêt à Résilier"
				recOldLI.SetField "x_av_arb_status", "CRE_ARB"
				recOldLI.SetField "x_av_etat_act",  "Réalisé"
				recOldLI.SetField "x_av_code_etat",  "Traité"
				recOldLI.SetField gcstCOMVarCHGENDDT, strDateEffet
				recOldLI.SetField "end_date", recSuivi.getField("x_av_date_effet")
			ElseIf recPartnum.GetField("x_av_install_type") = "I" And recPartnum.GetField("x_av_gen_si") = 1 Then
				recOldLI.SetField gcstCOMVarCHGENDDT, strDateEffet
				recOldLI.SetField "x_av_statut_act", "Résilié"
				recOldLI.SetField "x_av_etat_act",  "Réalisé"
				recOldLI.SetField "x_av_code_etat",  "Traité"
				recOldLI.SetField "end_date", recSuivi.getField("x_av_date_effet")
			ElseIf recPartnum.GetField("x_av_install_type") = "I" Then
				recOldLI.SetField "x_av_statut_act", "Résilié"
				recOldLI.SetField "x_av_etat_act",  "Réalisé"
				recOldLI.SetField "x_av_code_etat",  "Traité"
				recOldLI.SetField "end_date", recSuivi.getField("x_av_date_effet")
			ElseIf recPartnum.GetField("x_av_cross_ref") = "CFE_TERM" And _ ' COR C20123366
			recPartnum.GetField("x_av_type") = "NRC" Then
				recOldLI.SetField "x_av_statut_act", "Résilié"
				recOldLI.SetField "x_av_etat_act",  "Réalisé"
				recOldLI.SetField "x_av_code_etat",  "Traité"
				'recOldLI.SetField gcstCOMVarCHGENDDT, strDateEffet
				recOldLI.SetField "end_date", recSuivi.getField("x_av_date_effet")
			End If
			
			'Supprimer l'identifiant de la demande réseau (car il a été recopié sur la BDS du lot cible)
			recOldLI.SetField "x_av_oss_id_dem", ""

			' Numérotation des BDS
			recNewLI.SetField "p_line_no", maxPLineNo
			If recNewLI.GetField("line_no") = 0 Then 'BDS1
				recNewLI.SetField "line_no_txt", Cstr(maxPLineNo)
			Else
				recNewLI.SetField "line_no_txt", Cstr(maxPLineNo) & "." & nextLineNo
				recNewLI.SetField "line_no", nextLineNo
				nextLineNo = nextLineNo + 1
			End If

			isBds1 = (recNewLI.GetField("line_no") = 0)

			if recSuivi.GetField("x_av_type") = "Changement Titulaire" Then
				recNewLI.SetField "x_av_version", recContratCible.GetField("x_av_current_version")
				if lstMotifTitulaie.count <> 0 then
					Set recMotif = lstMotifTitulaie.ItemByIndex(0)
					If isBds1 Then
						recOldLI.SetField "x_av_motif_resil", recMotif.GetField("x_av_libelle")
					End If
				end if
			Else
				recNewLI.SetField "x_av_version", recContrat.GetField("x_av_current_version")
				if lstMotifPayeur.count <> 0 then
					Set recMotif = lstMotifPayeur.ItemByIndex(0)
					If isBds1 Then
						recOldLI.SetField "x_av_motif_resil", recMotif.GetField("x_av_libelle")
					End If
				end if
			End If

			If isBds1 Then
				recNewLI.SetField "x_av_id_ids", createNewIDS()
			Else			
				recNewLI.SetField "x_av_id_ids", getId_IDS_BDS1(CStr(BDS1Objid))
			End If

			' Mise à jour CU/CF
			If recPartnum.GetField("x_av_gen_si")           = "1"   Or _
				recPartnum.GetField("x_av_part_prov_level") = "CF"  OR _
				recPartnum.GetField("x_av_install_type")    = "F2"  Or _
				recPartnum.GetField("x_av_install_type")    = "IF2" Or _
				(blnBdsAc) Then
				' COR C19571218 - CU incorrect post FUSAC : Affectation erronée du CF comme CU >
				'bs.RelateRecords recNewLI, recCFCible, gcstCOMVarAVUSEDBY2SITE
				bs.RelateRecords recNewLI, recCUCible, gcstCOMVarAVUSEDBY2SITE
				' COR C19571218 - CU incorrect post FUSAC : Affectation erronée du CF comme CU <
				bs.RelateRecords recNewLI, recCFCible, gcstCOMVarAVBILLTO2SITE
			End If
			
			' Lien BDS lot cible
			bs.RelateRecords recNewLI, recLotCible, "contr_itm2contr_schedule"

			' Mise à jour des autres relations
			bs.RelateRecordsToID recNewLI, "mod_level", modLevelObjid, "contr_itm2mod_level"
			If recNewLI.GetField("line_no") > 0 Then
				bs.RelateRecordsToID recNewLI, gcstCOMVarContrItm, BDS1Objid, "child2contr_itm"
			End If

			' Lien entre BDS Source et Cible

            'If existBDS1 = 0  Then ' (RA 6134 mise en commentaire du test)
               ' Lien entre BDS Source et Cible
               bs.RelateRecords recNewLI, recOldLI, "x_av_new2previous"
            'End If
			bs.InsertRecord recNewLI

            bs.UpdateRecord recOldLI
            bs.Save
			
			'-------------------------------------
			' Création Site_Part
			'-------------------------------------
			lstParameters.Clear
			lstParameters.ItemType = gstrCOMVarVARIANT
			lstParameters.AppendItem recNewLI.GetField(gcstCOMVarObjid)
			toDB.ExecuteProc "SA.PROC_X_AV_ADD_SITEPART", lstParameters, typResponse
			If typResponse.v_num <> 0 Then
				Call EnErreur(lobjidSuivi, typResponse.response)
				lngErrCount = lngErrCount + 1
				GoTo Cleanup1
			End If

			'-------------------
			'Copie des Attributs
			'-------------------
			br.Clear
			br.SimpleQuery  0, "N_AttributeValue"
			br.AppendFilter 0, "N_FocusLowid", cbEqual, recOldLI.GetField(gcstCOMVarObjid)
			br.AppendFilter 0, "N_FocusType", cbEqual, 142
			br.TraverseFromParent 1, "x_av_value2N_Properties", 0
			br.RetrieveRecords

			Set lstAttribut = br.GetRecordList(0)
			Set lstTmp      = br.GetRecordList(1)

			For j = 0 To lstAttribut.Count - 1
				Set recNewAttribute = New Record
				Set recNewAttribute = lstAttribut.ItemByIndex(j)
				Set recTmp          = lstTmp.ItemByIndex(j)
				recNewAttribute.ChangeToNew
				'DEBUT MCO 8011 NRED
				If recSuivi.GetField("x_av_type") = "Changement Titulaire" then
					If recTmp.GetField("x_av_cross_ref") = "LIEN_BDS_UTILISATEUR" then
						'debug.print "Création d un nouveau role utilsateur de la ligne pour le nouveau site"
						Dim lstTmp2         As New List
						Dim recContact      As New Record
						Dim recOrg          As New Record
						Dim recAddr         As New Record

						br2.clear
						br2.SimpleQuery  0, gcstCOMVarSite
						br2.AppendFilter 0, gcstCOMVarObjid, cbEqual, rec_site_cible.GetField(gcstCOMVarObjid)
						br2.traversefromParent 1, "primary2bus_org", 0
						br2.traversefromParent 2, "cust_billaddr2address", 0
						br2.SimpleQuery  3, "contact"
						br2.AppendFilter 3, gcstCOMVarObjid, cbEqual, recNewAttribute.GetField("N_TargetLowid")
						br2.RetrieveRecords
						Set lstTmp2     = br2.GetRecordList(1)
						Set recOrg      = lstTmp2.ItemByIndex(0)
						Set lstTmp2     = br2.GetRecordList(2)
						Set recAddr     = lstTmp2.ItemByIndex(0)
						Set lstTmp2     = br2.GetRecordList(3)
						Set recContact  = lstTmp2.ItemByIndex(0)

						' Vérifier si le contact a déjà le role UFE sur le site cible :
						br2.clear
						br2.SimpleQuery  0, "rol_contct"
						br2.AppendFilter 0, "loc_objid" , cbEqual, rec_site_cible.GetField(gcstCOMVarObjid)
						br2.AppendFilter 0, "con_objid" , cbEqual, recContact.GetField(gcstCOMVarObjid)
						br2.AppendFilter 0, "role_name" , cbEqual, "Utilisateur de la ligne"
						br2.RetrieveRecords
						Set lstTmp2      = br2.GetRecordList(0)

						' Dans le cas de ligne principale/secondaire, ne dupliquer l'UFE qu'une seule fois
						' (1 seul UFE pour ligne principale et ses lignes secondaires)

						If lstTmp2.Count = 0 Then
							' Ligne standard
							Dim bulkSaveRole    As New BulkSave
							Dim recNewRole      As new Record
							recNewRole.RecordType = "contact_role"
							recNewRole.SetField "role_name", "Utilisateur de la ligne"
							recNewRole.SetField "primary_site", 2
							recNewRole.SetField "x_av_nb_copie_fact", 1
							recNewRole.SetField "update_stamp", App.CurrentDate
							recNewRole.SetField "is_active", 0
							recNewRole.SetField "rsdncy_type", 0
							recNewRole.SetField "is_primary_for_org", 0
							recNewRole.SetField "x_av_o_appel_tronque", 0
							bulkSaveRole.InsertRecord recNewRole
							bulkSaveRole.RelateRecords recNewRole, recContact    , "contact_role2contact"
							bulkSaveRole.RelateRecords recNewRole, recOrg        , "contact_role2bus_org"
							bulkSaveRole.RelateRecords recNewRole, recAddr       , "contact_role2address"
							bulkSaveRole.RelateRecords recNewRole, rec_site_cible, "contact_role2site"
							bulkSaveRole.Save
							'debug.print "Role : Utilisateur de la ligne créé avec succès"
						End If
					End If
					If isBds1 And recTmp.GetField("x_av_cross_ref") = "ID_COFFRE" Then
						strIdCoffre = recNewAttribute.GetField("N_StringValue")
					End If
					If blnBdsAc And recTmp.GetField("x_av_cross_ref") = "VERSION_COMMERCIALE" Then
						strOldNomAc = recNewAttribute.GetField("N_StringValue")
						recNewAttribute.SetField "N_StringValue", strNomAc
					End If
					If blnBdsAc And recTmp.GetField("x_av_cross_ref") = "VC_VERSION" Then
						recNewAttribute.SetField "N_StringValue", strVersionAc
					End If
					If blnBdsAc And recTmp.GetField("x_av_cross_ref") = "ID_COFFRE" Then
						recNewAttribute.SetField "N_StringValue", strIdCoffre
					End If
				End If

				If lstMotif.count <> 0 Then
					For s = 0 to lstMotif.count -1
						Set recMotifCible = lstMotif.ItemByIndex(s)
						If recTmp.GetField("x_av_cross_ref") = recMotifCible.GetField("x_av_libelle") Then
							If isBds1 Then
								If recSuivi.GetField("x_av_type") = "Changement Titulaire" Then
									If lstMotifTitulaie.count <> 0 Then
										Set recMotif = lstMotifTitulaie.ItemByIndex(0)
										recNewAttribute.SetField "N_StringValue", recMotif.GetField("x_av_libelle")
									End If
								Else
									If lstMotifPayeur.count <> 0 Then
										Set recMotif = lstMotifPayeur.ItemByIndex(0)
										recNewAttribute.SetField "N_StringValue", recMotif.GetField("x_av_libelle")
									End If
								End If
							End If
						End If
					Next s
				End If
				'879 NRED END

				If Len (xRefAttrMSIM) > 0 And recTmp.GetField("x_av_cross_ref") = xRefAttrMSIM Then
					br2.clear
					br2.SimpleQuery  0, gcstCOMVarContrItm
					br2.AppendFilter 0, gcstCOMVarObjid, cbEqual, recNewAttribute.GetField("N_TargetLowid")
					br2.traversefromParent 1, "x_av_previous2new", 0
					br2.RetrieveRecords
					Set lstTmp2      = br2.GetRecordList(1)
					If lstTmp2.Count <> 0 Then
						Set recTmp2  = lstTmp2.ItemByIndex(0)
						recNewAttribute.SetField "N_TargetLowid", recTmp2.GetField(gcstCOMVarObjid)
					End If
				End If

				recNewAttribute.SetField "N_FocusLowid", recNewLI.GetField(gcstCOMVarObjid)
				bs.RelateRecordsToID recNewAttribute, "N_Properties", recTmp.GetField(gcstCOMVarObjid), "x_av_value2N_Properties"
				bs.InsertRecord recNewAttribute
			Next j
			If j > 0 Then bs.Save

			' Création d'un événement de Calcul engagement si BdS Version commerciale maintenue
			If blnBdsAc And recSuivi.GetField("x_av_type") = "Changement Titulaire" And (strOldNomAc <> strNomAc) Then
				strSQLStatement = "INSERT INTO table_x_av_ac_events " & _
								"(objid, x_av_type_evt, date_create, date_effet, ac_objid, " & _
								" nom_ac, version_ac, bds1_objid, x_av_version, x_av_id_eds, " & _
								" x_av_id_ids, x_av_used_by2site, x_av_bill_to2site, contract_id, status, " & _
								" type_ggd, date_effet_ggd) VALUES " & _
								"(SEQ_X_AV_AC_EVENTS.nextval, 'Calcul engagement', SYSDATE, TO_DATE('" & strDateEffet & "', 'DD/MM/YYYY'), " & recNewLI.GetField(gcstCOMVarObjid) & ", " & _
								" '" & strNomAc & "', '" & strVersionAc & "', " & BDS1Objid & ", " & recContratCible.GetField("x_av_current_version") & ", '" & recNewLI.GetField("x_av_id_eds") & "', " & _
								" '" & recNewLI.GetField("x_av_id_ids") & "', " & recCUCible.GetField(gcstCOMVarObjid) & ", " & recCFCible.GetField(gcstCOMVarObjid) & ", '" & recContratCible.GetField("id") & "', 'A traiter', " & _
								" 2, TO_DATE('" & strDateEffet & "', 'DD/MM/YYYY'))"
				toDB.Execute strSQLStatement

				strSQLStatement = "commit"
				toDB.Execute strSQLStatement
			End If

			If blnBdsAc And recSuivi.GetField("x_av_type") = "Changement Titulaire" Then
			' Création d'un événement de Calcul PRI Mobile
				strSQLStatement = "INSERT INTO table_x_av_inf356_pri_mob_evt " & _
								"(objid, bds1_objid, x_av_id_eds, x_av_msisdn, date_create, date_effect, x_av_adg, x_av_status) " & _
								" SELECT SEQ_X_AV_INF356_PRI_MOB_EVT.nextval, " & BDS1Objid & ", x_av_id_eds, x_av_ndi, SYSDATE, TO_DATE('" & strDateEffet & "', 'DD/MM/YYYY'), 'CTI', 'A traiter' " & _
								" FROM table_contr_itm " & _
								" WHERE objid = " & BDS1Objid & _
								" AND NOT EXISTS (SELECT 1 FROM table_x_av_inf356_pri_mob_evt WHERE bds1_objid = " & BDS1Objid & " AND TRUNC(date_effect) = TRUNC(TO_DATE('" & strDateEffet & "', 'DD/MM/YYYY')))"
				toDB.Execute strSQLStatement

				strSQLStatement = "commit"
				toDB.Execute strSQLStatement
			End If

			'-------------------
			'Copie des Ajustements
			'-------------------
			br.Clear
			br.SimpleQuery  0, gcstCOMVarContrItm
			br.AppendFilter 0, gcstCOMVarObjid, cbEqual, recOldLI.GetField(gcstCOMVarObjid)
			br.TraverseFromParent 1, "contr_itm2contr_pr", 0
			br.RetrieveRecords

			Set lstAjustements = br.GetRecordList(1)

			If lstAjustements.Count > 0 Then
				For j = 0 To lstAjustements.Count - 1
					Set recNewAjustement = New Record
					Set recNewAjustement = lstAjustements.ItemByIndex(j)
					recNewAjustement.ChangeToNew

					bs.RelateRecordsToID recNewAjustement, gcstCOMVarContrItm, recNewLI.GetField(gcstCOMVarObjid), "contr_pr2contr_itm"
					bs.InsertRecord recNewAjustement
					bs.Save
				Next j
			End If

			Dim brContratN		As New BulkRetrieve
			Dim lstContratN		As New List
			Dim recContratN		As Record
			Dim ObjidBdsCible   As long
			Dim brSite			As New BulkRetrieve
			Dim lstSite			As New List
			Dim recSite			As Record
			Dim lstSite2		As New List
			Dim recSite2		As Record
			Set recContratN	= New Record
			Set recSite		= New Record
			Set recSite2	= New Record

			brContratN.clear
			brContratN.SimpleQuery 0, gcstCOMVarContrSchedule
			brContratN.AppendFilter 0, gcstCOMVarObjid, cbEqual, recLotCible.GetField(gcstCOMVarObjid)
			brContratN.traversefromParent 1, "schedule2contract", 0
			brContratN.RetrieveRecords
			Set lstContratN = brContratN.GetRecordList(1)
			Set recContratN = lstContratN.ItemByIndex(0)

			brSite.clear
			brSite.SimpleQuery 0, gcstCOMVarSite
			brSite.AppendFilter 0, gcstCOMVarSITEID, cbEqual, recSuivi.GetField("x_av_cf_cible")
			brSite.SimpleQuery 1, gcstCOMVarSite
			If Len(recSuivi.GetField("x_av_cu_cible")) > 0 Then
				brSite.AppendFilter 1, gcstCOMVarSITEID, cbEqual, recSuivi.GetField("x_av_cu_cible")
			Else
				brSite.AppendFilter 1, gcstCOMVarSITEID, cbEqual, recSuivi.GetField("x_av_cf_cible")
			End If
			brSite.RetrieveRecords

			Set lstSite = brSite.GetRecordList(0)
			Set recSite = lstSite.ItemByIndex(0)
			Set lstSite2 = brSite.GetRecordList(1)
			Set recSite2 = lstSite2.ItemByIndex(0)

			If premiereBds <> 1 then
				premiereBds = 1
				If PropagRCS(recContratN.GetField(gcstCOMVarObjid)) then
					if recSite.GetField("x_av_rcs_contrat") = "" or recSite2.GetField("x_av_rcs_contrat") = "" then
						debug.print "RCS neuf cegetel généré avec succès pour le nouveau site"
					end if
				end if
			End If

			'---------------------------------------------------
			' Génération d'un élément d'historique pour les BDS1
			'---------------------------------------------------
			If recNewLI.GetField("line_no") = 0 Then
				dim description_histo as string
				if recSuivi.GetField("x_av_type") = "Changement Titulaire" then
					description_histo = "Contrat Source : " & recSuivi.GetField("x_av_id_contract") & " , Lot Source : " & recLotSource.GetField(gcstCOMVarSCHEDULEID) & _
										" , Contrat Cible : " & recSuivi.GetField("x_av_id_contract_cible") & " , Lot Cible : " & recLotCible.GetField(gcstCOMVarSCHEDULEID)
				else
					description_histo = "Lot Source : " & recLotSource.GetField(gcstCOMVarSCHEDULEID) & " , Lot Cible : " & recLotCible.GetField(gcstCOMVarSCHEDULEID)
				end if

				AjouterHistorique recOldLI, description_histo, _
								recCFSource.GetField(gcstCOMVarObjid), recCFCible.GetField(gcstCOMVarObjid), _
								recSuivi.GetField(gcstCOMVarAVTYPE), recPartnum.GetField("description"), _
								recSuivi.GetField("x_av_dem_login"), recContrat.GetField("x_av_current_version")

				If recSuivi.GetField("x_av_type") = "Changement Titulaire" Then
					AjouterHistorique recNewLI, description_histo, _
									recCFSource.GetField(gcstCOMVarObjid), recCFCible.GetField(gcstCOMVarObjid), _
									recSuivi.GetField(gcstCOMVarAVTYPE), recPartnum.GetField("description"), _
									recSuivi.GetField("x_av_dem_login"), recContratCible.GetField("x_av_current_version")
				Else
					AjouterHistorique recNewLI, description_histo, _
									recCFSource.GetField(gcstCOMVarObjid), recCFCible.GetField(gcstCOMVarObjid), _
									recSuivi.GetField(gcstCOMVarAVTYPE), recPartnum.GetField("description"), _
									recSuivi.GetField("x_av_dem_login"), recContrat.GetField("x_av_current_version")
				End If
			
				BDS1Objid         = recNewLI.GetField(gcstCOMVarObjid)
			End If
			
			bs.UpdateRecord recNewLI
			bs.Save

            '-------------------------------------
            ' Synchronisation avec Arbor (C7821966 uniquement les BDS facturables, pas les BDS porteuses de SI)
            '-------------------------------------
            If recPartnum.GetField("x_av_install_type") = "F"   Or _
               recPartnum.GetField("x_av_install_type") = "IF"  Then
				
				'Ne pas renvoyer les NRC déjà envoyés à ARBOR
				IF (recOldLI.GetField("x_av_arb_status") <> "CRE_ARB" Or _
				   recOldLI.GetField("x_av_arb_status") <> "MOD_ARB") And _
				   recPartnum.GetField("x_av_type") <> "NRC" Then
				
					Call InsererEvenementArbor ( bs, Cstr(recNewLI.GetField(gcstCOMVarObjid)), 1, 1, App.CurrentDate, strDateEffet, gcstCOMVarVide , "CLA", 0, 0, 0)

					recNewLI.SetField "x_av_status_c2a", "Facturé - Transmis"

					'Appel de résiliation Arbor pour la BDS créée
					recOldLI.SetField "x_av_nb_transf", recOldLI.GetField("x_av_nb_transf") + 1
					bs.UpdateRecord recOldLI
					
					bs.Save
					
					doInsertArb = False
					
					If recOldLI.getfield("x_av_arb_status") = "CRE_ARB" Or recOldLI.getfield("x_av_arb_status") = "MOD_ARB" Then
						doInsertArb = True
					ElseIf recOldLI.getfield("x_av_arb_status") = "MOD_ERR" Or _
						recOldLI.getfield("x_av_arb_status") = "CRE_ERR" Or _
						recOldLI.getfield("x_av_arb_status") = "MOD_C2A" Or _
						recOldLI.getfield("x_av_arb_status") = "RES_ERR" Or _
						recOldLI.getfield("x_av_arb_status") = "RES_C2A" Then
						
						lstHisto.ItemType = "long"

						strSQLStatement = "select count(1) from table_x_av_hist_view " & _
						"where x_av_objid_itm =" & recOldLI.getfield("objid") & _
						" and x_av_last_status IN ('CRE_ARB', 'MOD_ARB')"

						toDB.Select strSQLStatement,lstHisto
						If lstHisto.ITEMBYINDEX(0) > 0 Then
							doInsertArb = True
						End If
					End If
					
					If doInsertArb Then
						'COR C15923648 - Début >
						Call InsererEvenementArbor ( bs, Cstr(recOldLI.GetField(gcstCOMVarObjid)), 1, 3, App.CurrentDate, strDateEffet, gcstCOMVarVide , "CLA", 0, recCFSource.GetField(gcstCOMVarObjid), 0)
						'COR C15923648 - Fin >
						'debug.print "Etape 10"
						recOldLI.SetField "x_av_status_c2a", "Résilié - Transmis"
					
					Else
						'debug.print "Etape 11"
						recOldLI.setfield "x_av_status_c2a", "Résilié - Traité"
						recOldLI.setfield "x_av_arb_status", "RES_ARB"
					End if
					
					bs.UpdateRecord recOldLI
					bs.Save
				End If
            End If

			If i=0 Then
				ObjidBdsCible = recNewLI.GetField(gcstCOMVarObjid)
			End If
			If blnBdsAc Then
				ObjidBdsACCible = recNewLI.GetField(gcstCOMVarObjid)
			End If
        Next i

		If Not blnAc  And recSuivi.GetField("x_av_type") = cstChangementTitulaire Then
			'Recherche si une BdS Version commerciale est active sur le lot en cours
			Set ordListAC = New List
			ordListAC.ItemType = gcstCOMVarLONG
			
			SqlStatement = "SELECT ci.objid " & _
							"FROM table_contr_itm ci, table_mod_level ml, table_part_num pn " & _
							"WHERE ml.objid  = ci.contr_itm2mod_level " & _
							"  AND pn.objid  = ml.part_info2part_num " & _
							"  AND ci.contr_itm2contr_schedule =  " & cstr(recLotCible.GetField(gcstCOMVarObjid)) & " " & _
							"  AND ci.x_av_statut_act   <> 'Résilié' " & _
							"  AND pn.x_av_cross_ref    =  'VERSION_COMMERCIALE' " & _
							"  AND pn.active            =  'Active' " & _
							"  AND ROWNUM               =  1 "
			
			toDB.Select SqlStatement, ordListAC

			If (ordListAC.Count > 0 ) then
				'Une BdS Version Commerciale active a été trouvée sur le lot cible
				br.Clear
				br.SimpleQuery 0,gcstCOMVarContrItm
				br.AppendFilter 0,gcstCOMVarObjid,cbEqual,ordListAC.ItemByIndex(0)
				br.RetrieveRecords
				Set lstBdsAC = br.GetRecordList(0)
				Set recAc = lstBdsAC.ItemByIndex(0)
				'Duplication de la BdS Version Commerciale active pour créer la nouvelle BdS
			
				Set recNewLI = New Record
				Set recNewLI = recAc.Copy(cbChangeToNew)

				recNewLI.SetField gcstCOMVarCHGENDDT, "01/01/1753" ' MAT VSR 59
				recNewLI.SetField "create_date", App.Currentdate
				recNewLI.SetField "x_av_id_import", ""
				recNewLI.SetField "x_av_num_mvt",   ""
				recNewLI.SetField "x_av_chgmt_cu_cf", 0
				recNewLI.SetField "p_line_no", maxPLineNo
				recNewLI.SetField "line_no_txt", Cstr(maxPLineNo) & "." & nextLineNo
				recNewLI.SetField "line_no", nextLineNo
				nextLineNo = nextLineNo + 1
				recNewLI.SetField "x_av_version", recContratCible.GetField("x_av_current_version")
				recNewLI.SetField "x_av_id_ids", getId_IDS_BDS1(CStr(BDS1Objid))
				
				' Lien BDS lot cible
				br.Clear
				br.SimpleQuery 0, gcstCOMVarContrItm
				br.AppendFilter 0, gcstCOMVarObjid, cbEqual, recAc.GetField(gcstCOMVarObjid)
				br.TraverseFromParent 1, "contr_itm2mod_level", 0
				br.RetrieveRecords
			
				Set lstTmp = br.GetRecordList(1)
				Set recPartnum = lstTmp.ItemByIndex(0)
			
				modLevelObjid  = recPartnum.GetField(gcstCOMVarObjid)
				bs.RelateRecordsToID	recNewLI, "mod_level", modLevelObjid, "contr_itm2mod_level"
				bs.RelateRecords		recNewLI, recLotCible, "contr_itm2contr_schedule"
				bs.RelateRecordsToID	recNewLI, gcstCOMVarContrItm, BDS1Objid, "child2contr_itm"
				bs.RelateRecords		recNewLI, recCUCible, gcstCOMVarAVUSEDBY2SITE
				bs.RelateRecords		recNewLI, recCFCible, gcstCOMVarAVBILLTO2SITE
			
				bs.InsertRecord recNewLI
				bs.Save
				
				ObjidBdsACCible = recNewLI.GetField(gcstCOMVarObjid)
			
				strNomAc = ""
				strVersionAc = ""
				Set ordListAC = New List
				ordListAC.ItemType = gcstCOMVarSTRING
				
				SqlStatement = "SELECT cc.x_av_ggd_code " & _
								"FROM table_x_av_mtm_cc2contract m, table_x_av_contr_cadre cc " & _
								"WHERE m.x_av_mtm_cc2contract  = " & cstr(recContratCible.GetField(gcstCOMVarObjid)) & _
				 				"  AND m.x_av_mtm_contract2cc  = cc.objid " & _
				 				"  AND m.x_av_date_debut_ratt <= trunc(SYSDATE) " & _ 
								"  AND trunc(SYSDATE) < NVL(m.x_av_date_fin_ratt, SYSDATE+1) " & _
								"  AND ROWNUM               =  1 "
				toDB.Select SqlStatement, ordListAC
				
				If (ordListAC.Count > 0 ) then
					strNomAc = ordListAC.ItemByIndex(0)
					
					Set ordListAC2 = New List
					ordListAC2.ItemType = gcstCOMVarLONG
				
					SqlStatement = "SELECT MAX(r.x_ref_version_ggd) " & _
									"FROM table_x_ref_vc r " & _
									"WHERE r.x_ref_code_ggd = '" & strNomAc & "'"
					toDB.Select SqlStatement, ordListAC2
				
					If (ordListAC2.Count > 0 ) then
						strVersionAc = cstr(ordListAC2.ItemByIndex(0))
					End If
				End If
				'-------------------
				'Copie des Attributs
				'-------------------
				br.Clear
				br.SimpleQuery  0, "N_AttributeValue"
				br.AppendFilter 0, "N_FocusLowid", cbEqual, recAc.GetField(gcstCOMVarObjid)
				br.AppendFilter 0, "N_FocusType", cbEqual, 142
				br.TraverseFromParent 1, "x_av_value2N_Properties", 0
				br.RetrieveRecords
			
				Set lstAttribut = br.GetRecordList(0)
				Set lstTmp      = br.GetRecordList(1)
			
				For j = 0 To lstAttribut.Count - 1
					Set recNewAttribute = New Record
					Set recNewAttribute = lstAttribut.ItemByIndex(j)
					Set recTmp          = lstTmp.ItemByIndex(j)
					recNewAttribute.ChangeToNew
			
					recNewAttribute.SetField "N_FocusLowid", recNewLI.GetField(gcstCOMVarObjid)
					If recTmp.GetField("x_av_cross_ref") = "VERSION_COMMERCIALE" Then
						recNewAttribute.SetField "N_StringValue", strNomAc
					End If
					If recTmp.GetField("x_av_cross_ref") = "VC_VERSION" Then
						recNewAttribute.SetField "N_StringValue", strVersionAc
					End If
					If recTmp.GetField("x_av_cross_ref") = "ID_COFFRE" Then
						recNewAttribute.SetField "N_StringValue", strIdCoffre
					End If
					bs.RelateRecordsToID recNewAttribute, "N_Properties", recTmp.GetField(gcstCOMVarObjid), "x_av_value2N_Properties"
					bs.InsertRecord recNewAttribute
				Next j
				bs.Save
				
				strSQLStatement = "INSERT INTO table_x_av_ac_events " & _
								"(objid, x_av_type_evt, date_create, date_effet, ac_objid, " & _
								" nom_ac, version_ac, bds1_objid, x_av_version, x_av_id_eds, " & _
								" x_av_id_ids, x_av_used_by2site, x_av_bill_to2site, contract_id, status, " & _
								" type_ggd, date_effet_ggd) VALUES " & _
								"(SEQ_X_AV_AC_EVENTS.nextval, 'Calcul engagement', SYSDATE, TO_DATE('" & strDateEffet & "', 'DD/MM/YYYY'), " & recNewLI.GetField(gcstCOMVarObjid) & ", " & _
								" '" & strNomAc & "', '" & strVersionAc & "', " & BDS1Objid & ", " & recContratCible.GetField("x_av_current_version") & ", '" & recNewLI.GetField("x_av_id_eds") & "', " & _
								" '" & recNewLI.GetField("x_av_id_ids") & "', " & recCUCible.GetField(gcstCOMVarObjid) & ", " & recCFCible.GetField(gcstCOMVarObjid) & ", '" & recContratCible.GetField("id") & "', 'A traiter', " & _
								" 2, TO_DATE('" & strDateEffet & "', 'DD/MM/YYYY'))"
				toDB.Execute strSQLStatement

				strSQLStatement = "commit"
				toDB.Execute strSQLStatement

			'ITEM 1130 : Calcul PRI Mobile
			' Création d'un événement de Calcul PRI Mobile si VC créée
				strSQLStatement = "INSERT INTO table_x_av_inf356_pri_mob_evt " & _
								"(objid, bds1_objid, x_av_id_eds, x_av_msisdn, date_create, date_effect, x_av_adg, x_av_status) " & _
								" SELECT SEQ_X_AV_INF356_PRI_MOB_EVT.nextval, " & BDS1Objid & ", x_av_id_eds, x_av_ndi, SYSDATE, TO_DATE('" & strDateEffet & "', 'DD/MM/YYYY'), 'CTI', 'A traiter' " & _
								" FROM table_contr_itm " & _
								" WHERE objid = " & BDS1Objid & _
								" AND NOT EXISTS (SELECT 1 FROM table_x_av_inf356_pri_mob_evt WHERE bds1_objid = " & BDS1Objid & " AND TRUNC(date_effect) = TRUNC(TO_DATE('" & strDateEffet & "', 'DD/MM/YYYY')))"
				toDB.Execute strSQLStatement

				strSQLStatement = "commit"
				toDB.Execute strSQLStatement
			'ITEM 1130 : Fin Calcul PRI Mobile
			End If
		End If
		
		If ObjidBdsACSource <> 0 Then
			'Mise à jour de la date d'effet de l'événement AC concernant la création de la BdS Version commerciale sur le contrat cible
			strSQLStatement =	"UPDATE table_x_av_ac_events evt " & _
								"SET evt.date_effet = TO_DATE('" & strDateEffet & "', 'DD/MM/YYYY') " & _
								"WHERE evt.ac_objid = " & cstr(ObjidBdsACSource) & _
								"  AND evt.x_av_type_evt = 'Résiliation AC'" & _
								"  AND evt.status <> 'Erreur'"
			toDB.Execute strSQLStatement

			strSQLStatement = "commit"
			toDB.Execute strSQLStatement
		End If

		If ObjidBdsACCible <> 0 Then
			'Mise à jour de la date d'effet de l'événement AC concernant la création de la BdS Version commerciale sur le contrat cible
			strSQLStatement =	"UPDATE table_x_av_ac_events evt " & _
								"SET evt.date_effet = TO_DATE('" & strDateEffet & "', 'DD/MM/YYYY') " & _
								"WHERE evt.ac_objid = " & cstr(ObjidBdsACCible) & _
								"  AND evt.x_av_type_evt = 'Création AC'" & _
								"  AND evt.status <> 'Erreur'"
			toDB.Execute strSQLStatement

			strSQLStatement = "commit"
			toDB.Execute strSQLStatement
		End If
		
        recLotCible.SetField "LAST_P_LINE_NO", maxPLineNo
        bs.UpdateRecord recLotCible
        bs.Save

        If recCFCible.GetField("x_av_bill_cycle") <> recCFSource.GetField("x_av_bill_cycle") then
            Call GenerateNotifChgtSruct(lobjidSuivi, ObjidBdsCible, App.CurrentDate, App.CurrentDate)
        End If

        ' Notif PropagVPNLigne pour tout changement de TI/CF
        ' Si le lot auquel est rattachée la ligne est mis à jour, il faut vérifier si le champ Contract2VPN
        ' du contrat associé a été modifié (VPN du contrat cible est différent du VPN du contrat source).
        If Not GenerateNotifVPNContrat(lobjidSuivi, BDS1Objid, recSuivi.GetField("x_av_id_contract"), recSuivi.GetField("x_av_id_contract_cible")) Then
            ErrMessage = "Erreur dans l'insertion de la procedure MAJ_NUM_VPN"
            Call EnErreur(lobjidSuivi, ErrMessage)
            lngErrCount = lngErrCount + 1
            GoTo Cleanup1
        End If

        TRUELOG WriteLog(SUBCHMTCF,"70090010","[SUIVI : " + cstr(recSuivi.GetField(gcstCOMVarObjid)) + "]", recSuivi.GetField(gcstCOMVarAVTYPE) & " traité avec succès.")

        'MCO , UPDATE de x_av_id_eds à null pour tout le groupe
        br.Clear
        br.SimpleQuery 0, gcstCOMVarContrItm
        br.AppendFilter 0, gcstCOMVarObjid, cbEqual, recSuivi.GetField("x_av_focus_id")
        br.TraverseFromParent 1, "parent2contr_itm", 0
        br.RetrieveRecords

        Set lstTmp = br.GetRecordList(0)
        Set recBDS = lstTmp.ItemByIndex(0)
        'recBDS.SetField "x_av_id_eds", ""
        recBDS.SetField "x_av_flag_transfert" , 1
        bs.UpdateRecord recBDS

        Set lstTmp = br.GetRecordList(1)
        If lstTmp.Count > 0 Then
            For j = 0 To lstTmp.Count - 1
                Set recBDS = lstTmp.ItemByIndex(j)
                'recBDS.SetField "x_av_id_eds", ""
				recBDS.SetField "x_av_flag_transfert" , 1
                bs.UpdateRecord recBDS
            Next j
        End If
    End If

    '----------------------------------------
    ' Mise à jour la table_x_av_suivi_chmt_cf
    '----------------------------------------
    recSuivi.SetField gcstCOMVarSTATUSAV, cstSuiviOK
    bs.UpdateRecord recSuivi
    bs.Save

    intSucces = intSucces + 1
    bolSuivi  = True

Cleanup1:
    Set br                = Nothing
    Set br2               = Nothing
    Set brContratN        = Nothing
    Set brSite            = Nothing
    Set bs                = Nothing
    Set bulkSaveRole      = Nothing
    Set toDB              = Nothing
    Set lstParameters     = Nothing
    Set lstSuivi          = Nothing
    Set lstBDS            = Nothing
    Set lstAttribut       = Nothing
    Set lstAjustements    = Nothing
    Set lstTmp            = Nothing
    Set lstMotifTitulaie  = Nothing
    Set lstMotifPayeur    = Nothing
    Set lstMotif          = Nothing
    Set lstTmp2           = Nothing
    Set lstContratN       = Nothing
    Set lstSite           = Nothing
    Set lstSite2          = Nothing
    Set recTmp            = Nothing
    Set recTmp2           = Nothing
    Set recSuivi          = Nothing
    Set recContrat        = Nothing
    Set recContratCible   = Nothing
    Set recLotCible       = Nothing
    Set recCFCible        = Nothing
    Set recCUCible        = Nothing
    Set recLotSource      = Nothing
    Set recCFSource       = Nothing
    Set recCUSource       = Nothing
    Set recBDSSource      = Nothing
    Set recOldLI          = Nothing
    Set recNewLI          = Nothing
    Set recPartnum        = Nothing
    Set recNewAttribute   = Nothing
    Set recNewAjustement  = Nothing
    Set recBDS            = Nothing
    Set recAccesCible     = Nothing
    Set rec_site_cible    = Nothing
    Set recMotif          = Nothing
    Set recMotifCible     = Nothing
    Set recContact        = Nothing
    Set recOrg            = Nothing
    Set recAddr           = Nothing
    Set recNewRole        = Nothing
    Set recContratN       = Nothing
    Set recSite           = Nothing
    Set recSite2          = Nothing
	Set ordListAC 		  = Nothing
	Set lstBdsAC 		  = Nothing
	Set lstHisto 		  = Nothing
	Set lstBdsContrat	  = Nothing
    Set rec_lot_cible 	  = Nothing
	Set lstLineMax 		  = Nothing
    strSQLStatement       = ebnullstring

    Exit Sub
Error_Handling:
    TRUELOG WriteLog(SUBCHMTCFPRICE,"40090003","[SUIVI : " + cstr(recSuivi.GetField(gcstCOMVarObjid)) + "] " + Warn , " Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description)
    lngWarnCount = lngWarnCount + 1
    Resume Next
End Sub

Function CheckBDSStatus (ObjidBDS1 As Long) As Boolean
    Dim strSqlStatement As string
    Dim toDB            As New SQLDB
    Dim lstBDS          As new list
    Dim br              As New BulkRetrieve
    Dim lstTmp          As New List
    Dim strCoffreDefaut As String
    Dim strActe1        As String
    Dim strStatutAct1   As String
    Dim strStatutFact1  As String
    Dim strActe2        As String
    Dim strStatutAct2   As String
    Dim strStatutFact2  As String
    Dim strActe2Csim    As String
    Dim strcodEtat2Csim As String

    br.Clear
    br.SimpleQuery 0, "x_av_code"
    br.AppendFilter 0, "x_av_type", Cbequal, "LISTE_ID_COFFRE_DEFAUT"
    br.SimpleQuery 1, "x_av_code"
    br.AppendFilter 1, "x_av_type", Cbequal, "LISTE_STATUT_BDS1_ACTE"
    br.AppendFilter 1, "x_av_code_2", Cbequal, "CTI_CPA"
    br.SimpleQuery 2, "x_av_code"
    br.AppendFilter 2, "x_av_type", Cbequal, "LISTE_STATUT_BDS1_CF_STAT_ACTE"
    br.SimpleQuery 3, "x_av_code"
    br.AppendFilter 3, "x_av_type", Cbequal, "LISTE_STATUT_BDS1_STAT_MAT"
    br.SimpleQuery 4, "x_av_code"
    br.AppendFilter 4, "x_av_type", Cbequal, "LISTE_STATUT_BDS2_ACTE"
    br.SimpleQuery 5, "x_av_code"
    br.AppendFilter 5, "x_av_type", Cbequal, "LISTE_STATUT_BDS2_CF_STAT_ACTE"
    br.SimpleQuery 6, "x_av_code"
    br.AppendFilter 6, "x_av_type", Cbequal, "LISTE_STATUT_BDS2_STAT_MAT"
    br.RetrieveRecords
    br.SimpleQuery 7, "x_av_code"
    br.AppendFilter 7, "x_av_type", Cbequal, "LISTE_STATUT_BDS2_ACTE_CSIM"
    br.RetrieveRecords
    br.SimpleQuery 8, "x_av_code"
    br.AppendFilter 8, "x_av_type", Cbequal, "LISTE_STATUT_BDS2_CODE_ETAT_CSIM"
    br.RetrieveRecords
    'Set lstTmp = br.GetRecordlist (0)
    'strCoffreDefaut = ListCodeToString (lstTmp, "'")
    Set lstTmp = br.GetRecordlist (1)
    strActe1 = ListCodeToString (lstTmp, "'")
    Set lstTmp = br.GetRecordlist (2)
    strStatutAct1 = ListCodeToString (lstTmp, "'")
    Set lstTmp = br.GetRecordlist (3)
    strStatutFact1 = ListCodeToString (lstTmp, "'")
    Set lstTmp = br.GetRecordlist (4)
    strActe2 = ListCodeToString (lstTmp, "'")
    Set lstTmp = br.GetRecordlist (5)
    strStatutAct2 = ListCodeToString (lstTmp, "'")
    Set lstTmp = br.GetRecordlist (6)
    strStatutFact2 = ListCodeToString (lstTmp, "'")
    Set lstTmp = br.GetRecordlist (7)
    strActe2Csim = ListCodeToString (lstTmp, "'")
    Set lstTmp = br.GetRecordlist (8)
    strcodEtat2Csim = ListCodeToString (lstTmp, "'")

    CheckBDSStatus = False
    lstBDS.itemtype = gcstCOMVarLONG
    
    strSqlStatement = " SELECT ci.objid" & _
                      " FROM table_contr_itm ci," & _
                      "      table_mod_level ml," & _
                      "      table_part_num pn" & _
                      " WHERE ci.objid = " & ObjidBDS1 & _
                      " AND ci.contr_itm2mod_level = ml.objid" & _
                      " AND ml.part_info2part_num = pn.objid" & _
                      " AND ci.child2contr_itm IS NULL" & _
                      " AND NVL(ci.x_av_o_scs, 0) = 0" & _
                      " AND pn.x_av_part_prov_level = 'SI'" & _
                      " AND ci.x_av_statut_act IN ( " & strActe1 & " )" & _
                      " AND ci.x_av_etat_act   IN ( " & strStatutAct1 & " )" & _
                      " AND ci.x_av_statut_mat IN ( " & strStatutFact1 & " )" & _
                      " AND NOT EXISTS (" & _
                                        "     SELECT itm2.objid FROM table_contr_itm itm2," & _
                                        "               table_mod_level ml," & _
                                        "               table_part_num pn" & _
                                        "     WHERE itm2.child2contr_itm = ci.objid " & _
                                        "       AND itm2.contr_itm2mod_level = ml.objid " & _
                                        "       AND ml.part_info2part_num = pn.objid " & _
                                        "AND ( " & _
                                        "itm2.x_av_statut_act NOT IN (" & strActe2 & ")" & _
                                        "OR itm2.x_av_etat_act NOT      IN ( " & strStatutAct2 & ")" & _
                                        "OR itm2.x_av_statut_mat NOT    IN ( " & strStatutFact2 & ") " & _
                                        ")" & _
                                        "AND( " & _
                                        "pn.x_av_cross_ref         <> 'NCSIICC'" & _
                                        "OR( " & _
                                        "itm2.x_av_statut_act <> 'A Créer' " & _
                                        "or itm2.x_av_code_etat <>'OK_SAP' " & _
                                        ")"& _
                                        ") )"                 

    toDB.Select strSqlStatement, lstBDS
    If lstBDS.Count > 0 Then
        CheckBDSStatus = True
    End If

    Set toDB    = Nothing
    Set lstBDS  = Nothing
    Set br      = Nothing
    Set lstTmp  = Nothing
    strSQLStatement = ebnullstring

End Function

