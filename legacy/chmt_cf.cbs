'***********************************************************************************************************/
'Author      : Kassem KANSOU
'Date        : 30/05/2017
'Description : Fonction permettant de vérifier s'il existe sur une ligne donnée une BDS2 Parc Duo « Active ».
'Info	     : C18284878 - Correctif - CTI Option Parc Duo
'***********************************************************************************************************/
Function checkBDS2ParcDuo (p_Objid As Long) As Boolean
    Dim strSqlStatement As string
    Dim toDB            As New SQLDB
    Dim lstBDS          As new list

    checkBDS2ParcDuo = False
    lstBDS.itemtype = gcstCOMVarLONG       

	strSqlStatement = " select distinct ci1.objid" & _
                      " FROM table_part_num pn1," & _
                      "      table_mod_level ml1," & _
                      "      table_contr_itm ci1," & _
                      "      table_part_num pn2," & _
                      "      table_mod_level ml2," & _
                      "      table_contr_itm ci2," & _
                      "      table_contr_schedule cs," & _
                      "      table_contract c," & _
                      "      table_bus_org bo," & _
                      "      table_site cu," & _	
                      "      table_site cf," & _
                      "      table_n_attributevalue attr," & _
                      "      table_n_properties prop1" & _
                      " where pn1.objid = ml1.part_info2part_num" & _
					  " and ci1.contr_itm2mod_level = ml1.objid" & _
					  " and pn2.objid = ml2.part_info2part_num" & _
					  " and ci2.contr_itm2mod_level = ml2.objid" & _
					  " and ci1.objid = ci2.child2contr_itm" & _
					  " and cs.objid = ci1.contr_itm2contr_schedule" & _
					  " and c.objid = cs.schedule2contract" & _
					  " and c.sell_to2bus_org = bo.objid" & _
					  " and ci2.x_av_used_by2site = cu.objid(+)" & _
					  " and ci2.x_av_bill_to2site = cf.objid(+)" & _
					  " and ci1.objid=attr.n_focuslowid(+)" & _
					  " and attr.x_av_value2n_properties = prop1.objid(+)" & _
					  "	and pn2.x_av_install_type like ('%F')" & _
					  " and ci1.x_av_statut_act ='Créé'" & _
					  " and pn2.x_av_cross_ref in ('OPT_SPLIT_PARC_DUO','OPT_DUO_RC')" & _
					  " and ci2.x_av_arb_status in ('CRE_ARB','MOD_ARB')" & _
					  " and ci1.objid = " & p_Objid 
										
    toDB.Select strSqlStatement, lstBDS
    
	If lstBDS.Count > 0 Then
        checkBDS2ParcDuo = True
    End If

    Set toDB    = Nothing
    Set lstBDS  = Nothing
    
	strSQLStatement = ebnullstring

End Function
' # 30-05-2017 - KKAN : COR C18284878 - Fin >

'*********************************************************************/
'Description: Convertir une liste en string séparées par "Separateur"
'*********************************************************************/
Function ListCodeToString(LstTmp As List, Separateur As String) As String
    Dim recTmp As Record
    Dim StrChaine As String
    Dim i As Integer
    For i = 0 To lstTmp.Count - 1
        Set recTmp = lstTmp.itembyindex (i)
        If i = 0 Then
            StrChaine = Separateur & recTmp.getField("x_av_code") & Separateur
        Else
            StrChaine = StrChaine & ", " & Separateur & recTmp.getField("x_av_code") & Separateur
        End If
    Next i
    ListCodeToString = StrChaine
End Function

Sub AjouterHistorique(recItm As Record, strDescription As String, strLastStatus As String, strNewStatus As String, _
                      strActionType As String, strArticle As string, strUser As String, strVersion As String)


    Dim udtOutParametersObjid As  strResponseObjid
    Dim udtOutParameters As  strResponse
    Dim sqlproc As New SQLDB
    Dim lstparam As New list

    lstParam.itemType = gcstCOMVarVariant
    lstparam.AppendItem  ""
    lstparam.AppendItem  strVersion
    lstparam.AppendItem  strUser
    lstparam.AppendItem  strDescription
    lstparam.AppendItem  strLastStatus
    lstparam.AppendItem  strNewStatus
    lstparam.AppendItem  strActionType
    lstparam.AppendItem  strArticle
    
    sqlproc.executeProc "sa.Proc_Insert_Hist_Contr",lstparam, udtOutParametersObjid
    If(udtOutParametersObjid.lnum<>0)Then
        debug.print "Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description
        debug.print "Erreur " & udtOutParametersObjid.strmessage
        Exit Sub
    End If
    
    Set lstparam = New list
    lstParam.itemType = gcstCOMVarVariant
    lstparam.AppendItem  udtOutParametersObjid.objid
    lstparam.AppendItem  recItm.GetField(gcstCOMVarObjid)

    sqlproc.executeProc "sa.Proc_Insert_Mtm_Hist_Itm",lstparam, udtOutParameters
    If(udtOutParameters.lnum<>0)Then
        app.MsgBox udtOutParameters.strmessage
        Exit Sub
    End If
    
    set sqlproc = Nothing
    set lstparam = Nothing
    udtOutParameters.strmessage = ebnullstring
    udtOutParametersObjid.objid = ebnullstring
    udtOutParametersObjid.strmessage = ebnullstring
    

End Sub

'Début MCO 7619 NRD

Function PropagRCS(objContr as Long) As Boolean
On Error GoTo Error_Handling
   Dim lngReturn As Long
   Dim brContract As New BulkRetrieve
   Dim lstContract as List
   Dim recContract as Record

   brContract.simplequery 0, gcstCOMVarContract
   brContract.AppendFilter 0, gcstCOMVarObjid , cbEqual, objContr
   brContract.RetrieveRecords
   Set lstContract = brContract.GetRecordList(0)
   set recContract = lstContract.ItembyIndex(0)
   if recContract.getfield("x_av_rcs")<> "" and recContract.getfield("x_av_rcs")<> "Sélectionner"  then
        Dim SqlProc As New sqldb
        Dim lstParameters As New List
        Dim typResponse As strResponse

        lstParameters.ItemType = "Variant"
        lstParameters.AppendItem recContract.getfield(gcstCOMVarObjid)
        lstParameters.AppendItem ""
        SqlProc.ExecuteProc "sa.PROC_X_AV_PROPAG_RCS", lstParameters,typResponse
        If typResponse.lnum <> 0 Then
            PropagRCS = false
            Exit Function
        End If
   else
      app.MsgBox "Le contrat cible ne possède pas de code RCS : Le code RCS ne sera pas propagé au site cible suite à ce changement"
      PropagRCS=false
      Exit Function
   end if
   PropagRCS=True
   exit function
Error_Handling:
    ErrLogMsgBox cstForminfo, Err.number, Err.Source, Err.description, erl
    PropagRCS=false
    exit function
End Function
'FIN MCO 7619 NRD


Function FloEdi() as List
On Error Goto Error_Handling

        Dim RecFamilleEDI as Record
        Dim RecLigneEDI as Record
        Dim RecOffreEDI as Record
        Dim lst as new List
        Dim LstFLO as new list
        Dim br as new bulkretrieve

        set FloEdi = lst
        'Récupération du paramétrage EDI
        br.clear
        br.SimpleQuery 0, "x_av_code"
        br.AppendFilter 0, "x_av_type" ,cbEqual,"CONFIG_PDA_EDI"
        br.AppendFilter 0, "x_av_code" ,cbEqual,"FAMILLE_EDI"
        br.SimpleQuery 1, "x_av_code"
        br.AppendFilter 1, "x_av_type" ,cbEqual,"CONFIG_PDA_EDI"
        br.AppendFilter 1, "x_av_code" ,cbEqual,"LIGNE_EDI"
        br.SimpleQuery 2, "x_av_code"
        br.AppendFilter 2, "x_av_type" ,cbEqual,"CONFIG_PDA_EDI"
        br.AppendFilter 2, "x_av_code" ,cbEqual,"OFFRE_EDI"
        br.RetrieveRecords


        Set lst = br.GetRecordList(0)
        if lst.count = 1 then
            set RecFamilleEDI = lst.itembyindex(0)
        else
        exit Function
        end if

        Set lst = br.GetRecordList(1)
        if lst.count = 1 then
            set RecLigneEDI = lst.itembyindex(0)
        else
        exit Function
        end if

        Set lst = br.GetRecordList(2)
        if lst.count = 1 then
            set RecOffreEDI = lst.itembyindex(0)
        else
        exit Function
        end if

     LstFLO.AppendItem RecFamilleEDI.getfield("x_av_libelle")
     LstFLO.AppendItem RecLigneEDI.getfield("x_av_libelle")
     LstFLO.AppendItem RecOffreEDI.getfield("x_av_libelle")

     Set FloEdi = LstFLO

Exit Function
Error_Handling:
    debug.print "Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description
End Function
'Fin Evol 810 YZA

'*********************************************************************/
'Author: Ahmed El Hamdany
'Date  : 15/09/2011
'Description: Vérifier que le contrat cible est lié à un VPN mobile dans le cas où le contrat source l est
'*********************************************************************/
Function GenerateNotifVPNContrat(lobjidSuivi As Long, objid_bds1 As Long, strIdContratSource As String, strIdContratCible As String) As Boolean
On Error GoTo Error_Handling
    Dim br               As New BulkRetrieve
    Dim lstTmp           As New List
    Dim recTmp           As New Record
    Dim recTmp2          As New Record
    Dim objidOldVpn      As Long
    Dim objidNewVPN      As Long
    Dim NdiPositionStart As Long
    Dim ZABPQMCDU        As String
    Dim lstBds           As New List
    Dim recBds           As New Record
    Dim idEDS            As String
    Dim phone            As String
    Dim recEAI           As New record
    Dim bs               As New bulksave

    objidOldVpn = 0
    objidNewVPN = 0

    br.SimpleQuery  0, "contr_itm"
    br.AppendFilter 0, "objid", cbEqual, objid_bds1
    br.RetrieveRecords

    Set lstBds = br.getRecordList(0)
    If lstBds.Count > 0 Then

        Set recBds = lstBds.itembyindex(0)
        phone = recBds.getField("x_av_ndi")
        idEDS = recBds.getField("x_av_id_eds")

        br.clear
        br.SimpleQuery  0, "contract"
        br.AppendFilter 0, "id", cbEqual, strIdContratSource
        br.TraverseFromParent 1, "x_av_contract2vpn", 0
        br.RetrieveRecords

        Set lstTmp = br.getRecordList(1)
        If lstTmp.Count > 0 Then
            Set recTmp2 = lstTmp.itembyindex(0)
            objidOldVpn = recTmp2.getField("objid")
        End If

        br.clear
        br.SimpleQuery  0, "contract"
        br.AppendFilter 0, "id", cbEqual, strIdContratCible
        br.TraverseFromParent 1, "x_av_contract2vpn", 0
        br.RetrieveRecords

        lstTmp.clear
        Set lstTmp = br.getRecordList(1)
        If lstTmp.Count > 0 Then
            Set recTmp = lstTmp.itembyindex(0)
            objidNewVPN = recTmp.getField("objid")
        End If

        If objidOldVpn <> objidNewVpn Then

            recEAI.RecordType = "x_eai_commands"

            recEAI.SetField gcstCOMVarAVDATE, App.CurrentDate
            recEAI.SetField "x_av_name", "MAJ_NUM_VPN"
            recEAI.SetField "x_av_statut", "P"
            recEAI.SetField "x_av_param1", recTmp.getfield("x_av_id_vpn")
            recEAI.SetField "x_av_param2", idEDS

            if len(phone) = 9 Then
                recEAI.SetField "x_av_param3", phone
                recEAI.SetField "x_av_param4", phone & ";" & phone
            Else
                NdiPositionStart = len(phone) - 9
                ZABPQMCDU = MID$(phone, NdiPositionStart+1)
                recEAI.SetField "x_av_param3", ZABPQMCDU
                recEAI.SetField "x_av_param4", ZABPQMCDU & ";" & ZABPQMCDU
            End If
            recEAI.SetField "x_av_param5", "CERTIFIE"
            recEAI.SetField "x_av_param6", ""

            bs.insertRecord recEAI
            bs.save
        End If
    End If

    GenerateNotifVPNContrat = True

    Set br         = Nothing
    Set lstTmp     = Nothing
    Set recTmp     = Nothing
    Set recTmp2    = Nothing
    Set lstBds     = Nothing
    Set recBds     = Nothing
    Set recEAI     = Nothing
    Set bs         = Nothing
Exit Function
Error_Handling:
   TRUELOG "Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
   lngErrCount = lngErrCount + 1
End Function

'*********************************************************************/
'Author: KAR
'Description: Evol 845
'*********************************************************************/
Sub GenerateNotifChgtSruct(lobjidSuivi As Long, objid_bds1 As Long, strCreate_dt As String, strMod_dt As String)
On Error GoTo Error_Handling

    Dim toDB            As New SQLDB
    Dim strSQLStatement As String
    Dim lstTmp          As New List
    Dim lstParameters   As New List
    Dim typResponse     As ResString

    'Identification de la liste des BDS pour lesquels l'événement doit être envoyé à l'EAI

    strSQLStatement = " select 1"&_
                      " from"&_
                      " table_contr_itm itm "&_
                      " where itm.objid = " & objid_bds1 &_
                      " and itm.child2contr_itm is null "&_
                      " and exists( select 1 from "&_
                      " table_contr_itm itm2, "&_
                      " table_part_num pnum, "&_
                      " table_mod_level mlvl, "&_
                      " table_x_av_code tac "&_
                      " where itm2.child2contr_itm = itm.objid "&_
                      " and itm2.x_av_statut_act='Créé' "&_
                      " and itm2.contr_itm2mod_level = mlvl.objid "&_
                      "  AND mlvl.part_info2part_num = pnum.objid "&_
                      "  and tac.x_av_type = 'LISTE_PROPAG_JJ_EAI' "&_
                      "  and pnum.x_av_cross_ref = tac.x_av_code )"

    lstTmp.ItemType = gcstCOMVarLONG
    toDB.Select strSQLStatement, lstTmp

    If lstTmp.Count  > 0 then
       'Poster la notification "PropagChgtStructMobilePrice" vers l'EAI
       lstParameters.ItemType = gstrCOMVarVARIANT
       lstParameters.clear
       lstParameters.AppendItem objid_bds1
       lstParameters.AppendItem 0
       lstParameters.AppendItem "PropagChgtStructMobilePrice"
       lstParameters.AppendItem strCreate_dt
       lstParameters.AppendItem strMod_dt

       '****Insertion (notification) de PropagChgtStructMobilePrice dans la table_x_eai_events****
       toDB.executeProc "sa.PROC_X_AV_EAI_INSERT_EVT", lstParameters, typResponse

       If typResponse.v_num <> 0 Then
           Call EnErreur(lobjidSuivi, typResponse.response)
           lngErrCount = lngErrCount + 1
       End If
    End If

    Set toDB            = Nothing
    Set lstTmp          = Nothing
    Set lstParameters   = Nothing
    strSQLStatement     = ebnullstring

Exit Sub
Error_Handling:
   TRUELOG "Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
   lngErrCount = lngErrCount + 1
End Sub

Sub ChmtAdminMove(lobjidSuivi As Long)
On Error GoTo Error_Handling
    Dim br              As New BulkRetrieve
    Dim br2             As New BulkRetrieve
    Dim toDB            As New SQLDB
    Dim strSQLStatement As String
    Dim typResponse     As ResString
    Dim lstParameters   As New List
    Dim lstSuivi        As New List
    Dim lstBDS          As New List
    Dim lstAttribut     As New List
    Dim lstAjustements  As New List
    Dim lstTmp          As New List
    Dim recTmp          As Record
    Dim recTmp2         As Record
    Dim recSuivi        As Record
    Dim recContrat      As Record
    Dim recContratCible As Record
    Dim recLotCible     As Record
    Dim recCFCible      As Record
    Dim recCUCible      As Record
    Dim recLotSource    As Record
    Dim recCFSource     As Record
    Dim recCUSource     As Record
    Dim recBDSSource    As Record
    Dim recOldLI        As Record
    Dim recNewLI        As Record
    Dim recPartnum      As Record
    Dim recNewAttribute As Record
    Dim recNewAjustement As Record
    Dim recBDS          As Record
    Dim ErrMessage      As String
    Dim strDateEffet    As String
    Dim i               As Integer
    Dim l               As Integer
    Dim row             As Integer
    Dim j               As Integer
    Dim k               As Integer
    Dim maxPLineNo      As Integer
    Dim BDS1Objid       As Long
    Dim objidAccesCible As Long
    Dim objidLotCible   As Long
    Dim modLevelObjid   As Long
    Dim nextLineNo      As Integer
    Dim xRefAttrMSIM    As String
    Dim strNewOssIdDem  As String
    Dim recAcces1       As Record
    Dim brContratN      As New BulkRetrieve
    Dim lstContratN     As New List
    Dim recContratN     As New Record
    Dim brSite          As New BulkRetrieve
    Dim lstSite         As New List
    Dim recSite         As New Record
    Dim lstSite2        As New List
    Dim recSite2        As New Record
    Dim sqlStmt         As String
    Dim sDB             As New SQLDB
    Dim listBDS3        As New List
    Dim isBd1           As boolean
    Dim typeP           As Boolean
    Dim typeT           As Boolean
    Dim bs              As New BulkSave
    Dim rec_site_cible  As New Record
    Dim premiereBds     As Integer
    Dim recAccesCible   As Record
    Dim description_histo As String
	Dim ObjidBdsACCible	As Long
    Dim blnBdsAc        As Boolean
    Dim existBDS1       As Long

    debug.print "Traitement de la ligne de suivi : " & lobjidSuivi

    br.SimpleQuery 0, SUIVICHMTCF
    br.AppendFilter 0, gcstCOMVarObjid, cbEqual, lobjidSuivi
    br.RetrieveRecords

    Set lstSuivi = br.GetRecordList(0)
    Set recSuivi = lstSuivi.ItemByIndex(0)

    br.Clear
    br.SimpleQuery  0, gcstCOMVarContract
    br.AppendFilter 0, gcstCOMVarID, cbEqual, recSuivi.GetField ("x_av_id_contract")
    br.SimpleQuery  1, gcstCOMVarContrSchedule
    br.AppendFilter 1, gcstCOMVarObjid, cbEqual, recSuivi.GetField ("x_av_id_contr_schedule_cible")
    br.TraverseFromParent 2, "bill_to2site", 1
    br.TraverseFromParent 3, "ship_to2site", 1
    br.SimpleQuery  4, gcstCOMVarContrSchedule
    br.AppendFilter 4, gcstCOMVarObjid, cbEqual, recSuivi.GetField ("x_av_id_contr_schedule")
    br.TraverseFromParent 5, "bill_to2site", 4
    br.TraverseFromParent 6, "ship_to2site", 4
    br.TraverseFromParent 7, "schedule2contr_itm", 1
    br.AppendSort 7, "p_line_no", cbDescending
    br.RetrieveRecords

    Set lstTmp     = br.GetRecordList(0)
    Set recContrat = lstTmp.ItemByIndex(0)

    Set lstTmp = br.GetRecordList(4)
    If lstTmp.Count <> 1 Then
        ErrMessage = cstSuiviWarn & "Lot Source"
        Call EnErreur(lobjidSuivi, ErrMessage)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    End If
    Set recLotSource = lstTmp.ItemByIndex(0)

    Set lstTmp = br.GetRecordList(1)
    If lstTmp.Count <> 1 Then
        ErrMessage = cstSuiviWarn & "Lot cible"
        Call EnErreur(lobjidSuivi, ErrMessage)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    Else
    Set recLotCible = lstTmp.ItemByIndex(0)
    objidLotCible= recLotCible.GetField(gcstCOMVarObjid)
    End If

    Set lstTmp = br.GetRecordList(2)
    If lstTmp.Count <> 1 Then
        ErrMessage = cstSuiviWarn & "CF cible"
        Call EnErreur(lobjidSuivi, ErrMessage)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    End If
    Set recCFCible = lstTmp.ItemByIndex(0)

    set lstTmp = br.GetRecordList(3)
    set rec_site_cible = lstTmp.ItemByIndex(0)

    Set lstTmp = br.GetRecordList(3)
    If lstTmp.Count <> 1 Then
        ErrMessage = cstSuiviWarn & "CU cible"
        Call EnErreur(lobjidSuivi, ErrMessage)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    End If
    Set recCUCible = lstTmp.ItemByIndex(0)

    Set lstTmp = br.GetRecordList(5)
    If lstTmp.Count <> 1 Then
        ErrMessage = cstSuiviWarn & "CF Source"
        Call EnErreur(lobjidSuivi, ErrMessage)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    End If
    Set recCFSource = lstTmp.ItemByIndex(0)
    Set lstTmp = br.GetRecordList(6)

    If lstTmp.Count <> 1 Then
        ErrMessage = cstSuiviWarn & "CU Source"
        Call EnErreur(lobjidSuivi, ErrMessage)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    End If
    Set recCUSource = lstTmp.ItemByIndex(0)
    Set lstTmp = br.GetRecordList(7)
    If lstTmp.Count <> 0 Then
        Set recTmp = lstTmp.ItemByIndex(0)
        maxPLineNo = Cdbl(recTmp.GetField("p_line_no")) + 1
    Else
        maxPLineNo = 1
    End If

    '--------------------------------------------------------------------
    ' Controles sur le site de facturation et d'installation du lot cible
    '--------------------------------------------------------------------
    lstParameters.Clear
    lstParameters.ItemType = gstrCOMVarVARIANT
    lstParameters.AppendItem recCFCible.GetField(gcstCOMVarObjid), recCUCible.GetField(gcstCOMVarObjid), recContrat.GetField(gcstCOMVarObjid)
    toDB.ExecuteProc "SA.VERIF_CF", lstParameters, typResponse
    If typResponse.response <> gcstCOMVarVide Then
        Call EnErreur(lobjidSuivi, typResponse.response)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    End If
    '-------------------------------------------
    ' Copie de la BDS1 et ses BDS2 non résiliées
    '-------------------------------------------
    lstBDS.ItemType = gcstCOMVarLONG

    br.Clear
    br.SimpleQuery 0, gcstCOMVarContrItm
    br.AppendFilter 0, gcstCOMVarObjid, cbEqual, recSuivi.GetField("x_av_focus_id")
    br.TraverseFromParent 1, "parent2contr_itm", 0
    br.AppendFilter 1, "x_av_statut_act", cbnotequal, "Résilié"
    br.RetrieveRecords
    Set lstTmp = br.GetRecordList(0)
    If lstTmp.Count <> 1 Then
        ErrMessage = cstSuiviWarn & "BDS Source"
        Call EnErreur(lobjidSuivi, ErrMessage)
        lngErrCount = lngErrCount + 1
        GoTo Cleanup1
    End If
    Set recBDSSource = lstTmp.ItemByIndex(0)
    
    
    If ( Format(DateAdd(gcstCOMVarD, 1, recSuivi.GetField("x_av_date_effet")), "yymmdd") > Format(DateAdd(gcstCOMVarD, 1, App.CurrentDate ), "yymmdd") ) Then
        strDateEffet = Format(DateAdd(gcstCOMVarD, 1, recSuivi.GetField("x_av_date_effet")), "dd/mm/yyyy")
    ELSE
        strDateEffet = Format(DateAdd(gcstCOMVarD, 1, App.CurrentDate), "dd/mm/yyyy")
    End If
    
    nextLineNo = 1
    premiereBds = 0
    typeP = false
    typeT = false

	ObjidBdsACCible	= 0
	
    If (recSuivi.GetField("x_av_action") <> "Déménagement" And recSuivi.GetField("x_av_action") <> "Upgrade" And recSuivi.GetField("x_av_action") <> "Changement de site") Or recBDSSource.GetField("x_av_categorie") <> strAcces  Then

        '*********************Traitement transfert partiel***************
        typeP = True
        lstBDS.AppendItem recSuivi.GetField("x_av_focus_id")

        Set lstTmp = br.GetRecordList(1)
        For i = 0 To lstTmp.Count - 1
            Set recOldLI = lstTmp.ItemByIndex(i)
            lstBDS.AppendItem recOldLI.GetField(gcstCOMVarObjid)
        Next i

        For i = 0 To lstBDS.Count - 1
			blnBdsAc = False

            Set recNewLI = New Record
            Set recOldLI = New Record
            isBd1 = False
            br.Clear
            br.SimpleQuery 0, gcstCOMVarContrItm
            br.AppendFilter 0, gcstCOMVarObjid, cbEqual, lstBDS.ItemByIndex(i)
            br.TraverseFromParent 1, "contr_itm2mod_level", 0
            br.TraverseFromParent 2, "part_info2part_num", 1
            br.TraverseFromParent 3, "child2contr_itm", 0
            br.RetrieveRecords

            Set lstTmp = br.GetRecordList(1)

            Set recPartnum = lstTmp.ItemByIndex(0)

            modLevelObjid  = recPartnum.GetField(gcstCOMVarObjid)

            Set lstTmp = br.GetRecordList(2)

            Set recPartnum = lstTmp.ItemByIndex(0)

            Set lstTmp = br.GetRecordList(0)
            Set recOldLI  = lstTmp.ItemByIndex(0)
            Set lstTmp = br.GetRelatedRecordList(recOldLI, "child2contr_itm")
            existBDS1 = lstTmp.count
            Set recNewLI = recOldLI.Copy(cbChangeToNew)
            '****************************************

            ' BDS facturables
            If recPartnum.GetField("x_av_install_type") = "F"   Or _
               recPartnum.GetField("x_av_install_type") = "IF"  Then

                recNewLI.SetField "x_av_statut_act", "Créé"
                recNewLI.SetField "x_av_status_c2a", "Prêt à Facturer"
                recNewLI.SetField "x_av_arb_status", "Initialisation"

                recNewLI.SetField gcstCOMVarCHGSTARTDT, strDateEffet
' MAT JIRA 2615 >
			ElseIf recPartnum.GetField("x_av_install_type") = "I" And recPartnum.GetField("x_av_gen_si") = 1 Then
				recNewLI.SetField gcstCOMVarCHGSTARTDT, strDateEffet
' MAT JIRA 2615 <
            End If

			recNewLI.SetField gcstCOMVarCHGENDDT, "01/01/1753" ' MAT VSR 59

            ' C7821966 - BDS génératrice de SI : le statut du si doit être vidé.
            If recPartnum.GetField("x_av_gen_si") = "1" Then
                recNewLI.SetField "x_av_statut_si", ""
            End If

            If recPartnum.GetField("x_av_cross_ref") = "VERSION_COMMERCIALE" Then
				'Il s'agit d'une BdS Version Commerciale
				blnBdsAc = True
			End IF
			
            recNewLI.SetField "create_date", App.Currentdate
            recNewLI.SetField "x_av_id_import", ""
            recNewLI.SetField "x_av_num_mvt",   ""

            'Suppression du flag « Changement de CU/CF demandé » au niveau de la BDS1
            recOldLI.SetField "x_av_chgmt_cu_cf", 0
            recNewLI.SetField "x_av_chgmt_cu_cf", 0

            ' Résilier les BDS facturables (C7821966 uniquement les BDS facturables, pas les BDS porteuses de SI)
            If recPartnum.GetField("x_av_install_type") = "F"  Then
                recOldLI.SetField "x_av_statut_act", "Résilié"
                recOldLI.SetField "x_av_status_c2a", "Prêt à Résilier"
                recOldLI.SetField "x_av_arb_status", "CRE_ARB"

' MAT JIRA 2505 : Date effet résiliation = Date effet + 1 >
'                recOldLI.SetField gcstCOMVarCHGENDDT, recSuivi.getField("x_av_date_effet")
                recOldLI.SetField gcstCOMVarCHGENDDT, strDateEffet
' MAT JIRA 2505 : Date effet résiliation = Date effet + 1 <
            ElseIf recPartnum.GetField("x_av_install_type") = "IF" Then
                recOldLI.SetField "x_av_statut_act", "Résilié"
                recOldLI.SetField "x_av_status_c2a", "Prêt à Résilier"
                recOldLI.SetField "x_av_arb_status", "CRE_ARB"
                recOldLI.SetField "x_av_etat_act",  "Réalisé"
                recOldLI.SetField "x_av_code_etat",  "Traité"
' MAT JIRA 2505 : Date effet résiliation = Date effet + 1 >
'                recOldLI.SetField gcstCOMVarCHGENDDT, recSuivi.getField("x_av_date_effet")
                recOldLI.SetField gcstCOMVarCHGENDDT, strDateEffet
' MAT JIRA 2505 : Date effet résiliation = Date effet + 1 <
                recOldLI.SetField "end_date", recSuivi.getField("x_av_date_effet")
' MAT JIRA 2598 >
			ElseIf recPartnum.GetField("x_av_install_type") = "I" And recPartnum.GetField("x_av_gen_si") = 1 Then
				recOldLI.SetField gcstCOMVarCHGENDDT, strDateEffet
				recOldLI.SetField "x_av_statut_act", "Résilié"
				recOldLI.SetField "x_av_etat_act",  "Réalisé"
				recOldLI.SetField "x_av_code_etat",  "Traité"
				recOldLI.SetField "end_date", recSuivi.getField("x_av_date_effet")
' MAT JIRA 2598 <
            ElseIf recPartnum.GetField("x_av_install_type") = "I" Then
                recOldLI.SetField "x_av_statut_act", "Résilié"
                recOldLI.SetField "x_av_etat_act",  "Réalisé"
                recOldLI.SetField "x_av_code_etat",  "Traité"

                recOldLI.SetField "end_date", recSuivi.getField("x_av_date_effet")
            End If

            'Supprimer l'identifiant de la demande réseau (car il a été recopié sur la BDS du lot cible)
            recOldLI.SetField "x_av_oss_id_dem", ""
            ' Numérotation des BDS
            recNewLI.SetField "p_line_no", maxPLineNo
            If recNewLI.GetField("line_no") = 0 Then 'BDS1
                recNewLI.SetField "line_no_txt", Cstr(maxPLineNo)
            Else
                recNewLI.SetField "line_no_txt", Cstr(maxPLineNo) & "." & nextLineNo
                recNewLI.SetField "line_no", nextLineNo
                nextLineNo = nextLineNo + 1
            End If

            '879 NRED

            Dim lstMotifTransfert2  As New List
            Dim lstMotifTransfert3  As New List
            Dim recMotif2           As Record

            isBd1 = (recOldLI.GetField("line_no") = 0)

            br.clear
            br.SimpleQuery 0, "x_av_code"
            br.AppendFilter 0, "x_av_type", cbEqual, "MOTIF_PRICE"
            br.AppendFilter 0, "x_av_code", cbEqual, recSuivi.GetField("x_av_action")
            br.RetrieveRecords
            Set lstMotifTransfert3 = br.GetRecordList(0)

            if lstMotifTransfert3.count = 0 then
                If isBd1 Then
                    TRUELOG WriteLog(SUBCHMTCF,"70090130","Le paramétrage : MOTIF_PRICE de la BDS source n'existe pas dans la table x_av_code 1", "")
                End IF
            End If
            ' Mise à jour Version de la BDS

            recNewLI.SetField "x_av_version", recContrat.GetField("x_av_current_version")
            If lstMotifTransfert3.count <> 0 Then
                Set recMotif2 = lstMotifTransfert3.ItemByIndex(0)
                If isBd1 Then
                    recOldLI.SetField "x_av_motif_resil", recMotif2.GetField("x_av_libelle")
                End If
            End If

            '879 NRED END
' MAT JIRA 2484 >
			If isBd1 Then
				recNewLI.SetField "x_av_id_ids", createNewIDS()
			Else			
				recNewLI.SetField "x_av_id_ids", getId_IDS_BDS1(CStr(BDS1Objid))
			End If
' MAT JIRA 2484 <

            ' Mise à jour CU/CF
            If recPartnum.GetField("x_av_gen_si")          = "1"   Or _
               recPartnum.GetField("x_av_part_prov_level") = "CF"  OR _
               recPartnum.GetField("x_av_install_type")    = "F"  Or _
               recPartnum.GetField("x_av_install_type")    = "IF" Then

                bs.RelateRecords recNewLI, recCUCible, gcstCOMVarAVUSEDBY2SITE
                bs.RelateRecords recNewLI, recCFCible, gcstCOMVarAVBILLTO2SITE
            End If

            ' Lien BDS lot cible
            bs.RelateRecords recNewLI, recLotCible, "contr_itm2contr_schedule"

            ' Mise à jour des autres relations
            bs.RelateRecordsToID recNewLI, "mod_level", modLevelObjid, "contr_itm2mod_level"
            If recNewLI.GetField("line_no") > 0 Then
                bs.RelateRecordsToID recNewLI, gcstCOMVarContrItm, BDS1Objid, "child2contr_itm"
            End If

            'Lien entre BDS1 et l'accès cible
            If isBd1 Then
                br.clear
                br.SimpleQuery 0, gcstCOMVarContrItm
                br.AppendFilter 0, gcstCOMVarObjid, cbEqual, recSuivi.GetField("x_av_acces_cible")
                br.RetrieveRecords
                Set lstTmp = br.GetRecordlist (0)
                Set recAcces1 = lstTmp.ItemByIndex(0)
                bs.RelateRecords recNewLI, recAcces1, "x_av_itm2acces"
            End If

            ' Lien entre BDS Source et Cible
            'If existBDS1 = 0  Then ' (RA 6134 mise en commentaire du test)
              ' Lien entre BDS Source et Cible
              bs.RelateRecords recNewLI, recOldLI, "x_av_new2previous"
            'End If

            bs.UpdateRecord recOldLI
            bs.InsertRecord recNewLI
            bs.Save

            '********************************

            '-------------------------------------
            ' Création Site_Part
            '-------------------------------------
            lstParameters.Clear
            lstParameters.ItemType = gstrCOMVarVARIANT
            lstParameters.AppendItem recNewLI.GetField(gcstCOMVarObjid)
            toDB.ExecuteProc "SA.PROC_X_AV_ADD_SITEPART", lstParameters, typResponse
            If typResponse.v_num <> 0 Then
                Call EnErreur(lobjidSuivi, typResponse.response)
                lngErrCount = lngErrCount + 1
                GoTo Cleanup1
            End If

            '-------------------
            'Copie des Attributs
            '-------------------
            br.Clear
            br.SimpleQuery  0, "N_AttributeValue"
            br.AppendFilter 0, "N_FocusLowid", cbEqual, recOldLI.GetField(gcstCOMVarObjid)
            br.AppendFilter 0, "N_FocusType", cbEqual, 142
            br.TraverseFromParent 1, "x_av_value2N_Properties", 0
            br.RetrieveRecords

            Set lstAttribut = br.GetRecordList(0)
            Set lstTmp      = br.GetRecordList(1)

            Dim lstMotif2             As New List
            Dim recMotifCible2        As Record

            br2.clear
            br2.SimpleQuery 0, "x_av_code"
            br2.AppendFilter 0, "x_av_type", cbEqual, "MOTIF_PRICE"
            br2.AppendFilter 0, "x_av_code", cbEqual, "XREF_MOTIF_ARRIVE"
            br2.RetrieveRecords

            Set lstMotif2 = br2.GetRecordList(0)
            If lstMotif2.count = 0 Then
                TRUELOG WriteLog(SUBCHMTCF,"70090130","Le paramétrage : MOTIF_PRICE de la BDS cible n'existe pas dans la table x_av_code 2", "")
            End If
            'MOU : ce bout de code est incompréhensible !!!!!

            'récuperer le paramétrage suivant le type de l'action
            Dim xcode_action As String
            if recSuivi.GetField("x_av_action") = "Déménagement" Then
                xcode_action = "DMGT"
            ElseIf  recSuivi.GetField("x_av_action") = "Upgrade" Then
                xcode_action = "UPGR"
            Else
                xcode_action = "TRADM"
            End If

            Dim lstMotif3             As New List
            Dim recMotifCible3        As Record

            br2.clear
            br2.SimpleQuery 0, "x_av_code"
            br2.AppendFilter 0, "x_av_type", cbEqual, "MOTIF_ARRIVEE"
            br2.AppendFilter 0, "x_av_code", cbEqual, xcode_action
            br2.RetrieveRecords

            Set lstMotif3 = br2.GetRecordList(0)
            if lstMotif3.count = 0 then
                TRUELOG WriteLog(SUBCHMTCF,"70090130","Le paramétrage : MOTIF_ARRIVEE de la BDS cible n'existe pas dans la table x_av_code ", "")
            end if
            Set recMotifCible3 = lstMotif3.ItemByIndex(0)


            For j = 0 To lstAttribut.Count - 1
                Set recNewAttribute = New Record
                Set recNewAttribute = lstAttribut.ItemByIndex(j)
                Set recTmp          = lstTmp.ItemByIndex(j)
                recNewAttribute.ChangeToNew
                if lstMotif2.count <> 0 then
                For k = 0 To lstMotif2.Count - 1
                    Set recMotifCible2 = lstMotif2.ItemByIndex(k)
                    if recTmp.GetField("x_av_cross_ref") = recMotifCible2.GetField("x_av_libelle") then
                        If isBd1 Then
                            recNewAttribute.SetField "N_StringValue", recMotifCible3.GetField("x_av_libelle")
                        End If
                    end if
                Next k
                end if
                recNewAttribute.SetField "N_FocusLowid", recNewLI.GetField(gcstCOMVarObjid)
                bs.RelateRecordsToID recNewAttribute, "N_Properties", recTmp.GetField(gcstCOMVarObjid), "x_av_value2N_Properties"
                bs.InsertRecord recNewAttribute
            Next j
             If j > 0 Then bs.Save
            '-------------------
            'Copie des Ajustements
            '-------------------
            br.Clear
            br.SimpleQuery  0, gcstCOMVarContrItm
            br.AppendFilter 0, gcstCOMVarObjid, cbEqual, recOldLI.GetField(gcstCOMVarObjid)
            br.TraverseFromParent 1, "contr_itm2contr_pr", 0

            br.RetrieveRecords

            Set lstAjustements = br.GetRecordList(1)

            If lstAjustements.Count > 0 Then
                For j = 0 To lstAjustements.Count - 1
                    Set recNewAjustement = New Record
                    Set recNewAjustement = lstAjustements.ItemByIndex(j)
                    recNewAjustement.ChangeToNew

                    bs.RelateRecordsToID recNewAjustement, gcstCOMVarContrItm, recNewLI.GetField(gcstCOMVarObjid), "contr_pr2contr_itm"
                    bs.InsertRecord recNewAjustement
                    bs.Save
                Next j
            End If
            '*****************************

        'MKA -[CRMENTREP-902] Mise à jour du champ LAST_P_LINE_NO du lot cible
        recLotCible.SetField "LAST_P_LINE_NO", maxPLineNo
        bs.UpdateRecord recLotCible

            brContratN.clear
            brContratN.SimpleQuery 0, gcstCOMVarContrSchedule
            brContratN.AppendFilter 0, gcstCOMVarObjid, cbEqual, recLotCible.GetField(gcstCOMVarObjid)
            brContratN.traversefromParent 1, "schedule2contract", 0
            brContratN.RetrieveRecords
            Set lstContratN = brContratN.GetRecordList(1)
            Set recContratN = lstContratN.ItemByIndex(0)

            brSite.clear
            brSite.SimpleQuery 0, gcstCOMVarSite
            brSite.AppendFilter 0, gcstCOMVarSITEID, cbEqual, recSuivi.GetField("x_av_cf_cible")
            brSite.SimpleQuery 1, gcstCOMVarSite
            If Len(recSuivi.GetField("x_av_cu_cible")) > 0 Then
                brSite.AppendFilter 1, gcstCOMVarSITEID, cbEqual, recSuivi.GetField("x_av_cu_cible")
            Else
                brSite.AppendFilter 1, gcstCOMVarSITEID, cbEqual, recSuivi.GetField("x_av_cf_cible")
            End If
            brSite.RetrieveRecords

            Set lstSite = brSite.GetRecordList(0)
            Set recSite = lstSite.ItemByIndex(0)
            Set lstSite2 = brSite.GetRecordList(1)
            Set recSite2 = lstSite2.ItemByIndex(0)

' COR C17720855 : Ne plus exécuter la fonction PropagRCS pour chaque BdS traitée !
'            If PropagRCS(recContratN.GetField(gcstCOMVarObjid)) and premiereBds <> 1 then
            If premiereBds <> 1 then
                premiereBds = 1
				If PropagRCS(recContratN.GetField(gcstCOMVarObjid)) then
					if recSite.GetField("x_av_rcs_contrat") = "" or recSite2.GetField("x_av_rcs_contrat") = "" then
						debug.print "RCS neuf cegetel généré avec succès pour le nouveau site"
'                    premiereBds = 1
					end if
				End If
            End If
' Fin COR C17720855

            '---------------------------------------------------
            ' Génération d'un élément d'historique pour les BDS1
            '---------------------------------------------------
            If isbd1 Then
                If recSuivi.GetField("x_av_type") = "Changement Titulaire" Then
                    description_histo = "Contrat Source : " & recSuivi.GetField("x_av_id_contract") & " , Lot Source : " & recLotSource.GetField(gcstCOMVarSCHEDULEID) & _
                                        " , Contrat Cible : " & recSuivi.GetField("x_av_id_contract_cible") & " , Lot Cible : " & recLotCible.GetField(gcstCOMVarSCHEDULEID)
                Else
                    description_histo = "Lot Source : " & recLotSource.GetField(gcstCOMVarSCHEDULEID) & " , Lot Cible : " & recLotCible.GetField(gcstCOMVarSCHEDULEID)
                End If
                AjouterHistorique recOldLI, description_histo, _
                                  recCFSource.GetField(gcstCOMVarObjid), recCFCible.GetField(gcstCOMVarObjid), _
                                  recSuivi.GetField(gcstCOMVarAVTYPE), recPartnum.GetField("description"), _
                                  recSuivi.GetField("x_av_dem_login"), recContrat.GetField("x_av_current_version")

                AjouterHistorique recNewLI, description_histo, _
                                  recCFSource.GetField(gcstCOMVarObjid), recCFCible.GetField(gcstCOMVarObjid), _
                                  recSuivi.GetField(gcstCOMVarAVTYPE), recPartnum.GetField("description"), _
                                  recSuivi.GetField("x_av_dem_login"), recContrat.GetField("x_av_current_version")

                BDS1Objid         = recNewLI.GetField(gcstCOMVarObjid)
            End If

            '-------------------------------------
            ' Synchronisation avec Arbor (C7821966 uniquement les BDS facturables, pas les BDS porteuses de SI)
            '-------------------------------------
            If recPartnum.GetField("x_av_install_type") = "F"   Or _
               recPartnum.GetField("x_av_install_type") = "IF"  Then
'debug.print "Etape 12"
                'Appel de création Arbor pour la BDS créée
'COR C15923648 - Début >
                Call InsererEvenementArbor ( bs, Cstr(recNewLI.GetField(gcstCOMVarObjid)), 1, 1, App.CurrentDate, strDateEffet, gcstCOMVarVide , "CLA", 0, 0, 0)
'COR C15923648 - Fin >

                recNewLI.SetField "x_av_status_c2a", "Facturé - Transmis"

                'Appel de résiliation Arbor pour la BDS créée
                recOldLI.SetField "x_av_nb_transf", recOldLI.GetField("x_av_nb_transf") + 1
                bs.UpdateRecord recOldLI
                bs.UpdateRecord recNewLI
                bs.Save

				Dim doInsertArb As boolean
				doInsertArb = False
				
				If recOldLI.getfield("x_av_arb_status") = "CRE_ARB" Or recOldLI.getfield("x_av_arb_status") = "MOD_ARB" Then
					doInsertArb = True
				ElseIf recOldLI.getfield("x_av_arb_status") = "MOD_ERR" Or _
					recOldLI.getfield("x_av_arb_status") = "CRE_ERR" Or _
					recOldLI.getfield("x_av_arb_status") = "MOD_C2A" Or _
					recOldLI.getfield("x_av_arb_status") = "RES_ERR" Or _
					recOldLI.getfield("x_av_arb_status") = "RES_C2A" Then

					'Dim toDB			As New SQLDB
					Dim lstHisto As New list
					'Dim strSQLStatement	As String
					lstHisto.ItemType = "long"

					strSQLStatement = "select count(1) from table_x_av_hist_view " & _
					"where x_av_objid_itm =" & recOldLI.getfield("objid") & _
					" and x_av_last_status IN ('CRE_ARB', 'MOD_ARB')"

					toDB.Select strSQLStatement,lstHisto
					If lstHisto.ITEMBYINDEX(0) > 0 Then
						doInsertArb = True
					End If
				End if
				
				If doInsertArb Then
					'debug.print "Etape 13"
					'COR C15923648 - Début >
					Call InsererEvenementArbor ( bs, Cstr(recOldLI.GetField(gcstCOMVarObjid)), 1, 3, App.CurrentDate, strDateEffet, gcstCOMVarVide , "CLA", 0, recCFSource.GetField(gcstCOMVarObjid), 0)
					'COR C15923648 - Fin >

					recOldLI.SetField "x_av_status_c2a", "Résilié - Transmis"
				
				Else
					'debug.print "Etape 14"
					recOldLI.setfield "x_av_status_c2a", "Résilié - Traité"
					recOldLI.setfield "x_av_arb_status", "RES_ARB"
				End if
				
                bs.UpdateRecord recOldLI
                bs.Save
            End If
            '***********************************
            'Mettre à null le champs x_av_id_eds pour la ligne et ses bds2. Evidemment, l'accès n'est pas concerné !
            'recOldLI.SetField "x_av_id_eds", gcstCOMVarVide
			recOldLI.SetField "x_av_flag_transfert", 1
            bs.UpdateRecord recOldLI
            bs.Save
			
			If blnBdsAc Then
				ObjidBdsACCible = recNewLI.GetField(gcstCOMVarObjid)
				
				'Mise à jour de la date d'effet de l'événement AC concernant la création de la BdS Version commerciale sur le contrat cible
				strSQLStatement =	"UPDATE table_x_av_ac_events evt " & _
									"SET evt.date_effet = TO_DATE('" & strDateEffet & "', 'DD/MM/YYYY') " & _
									"WHERE evt.ac_objid = " & cstr(ObjidBdsACCible) & _
									"  AND evt.x_av_type_evt = 'Création AC'" & _
									"  AND evt.status <> 'Erreur'"
				toDB.Execute strSQLStatement

				strSQLStatement = "commit"
				toDB.Execute strSQLStatement
			End If
        Next i
    End If

    'IAD le traitement de la demande concernant la résiliation de l'accès suite à un upgrade ou un déménagement
    If (recSuivi.GetField("X_AV_LIB_ETAT") = gcstCOMVarVide) AND ((recSuivi.GetField("x_av_action") = "Déménagement") OR (recSuivi.GetField("x_av_action") = "Upgrade")) Then
        br.Clear
        br.SimpleQuery 0, gcstCOMVarContrItm
        br.AppendFilter 0, gcstCOMVarObjid, cbEqual, recSuivi.GetField("x_av_focus_id")
        br.TraverseFromParent 1, "parent2contr_itm", 0
        br.AppendFilter 1, "x_av_statut_act", cbNotEqual, "Résilié"
        br.RetrieveRecords
        '********************************

        Set lstBDS = New List
        lstBDS.ItemType = gcstCOMVarLONG
        lstBDS.AppendItem recSuivi.GetField("x_av_focus_id")

        Set lstTmp = br.GetRecordList(1)
        For i = 0 To lstTmp.Count - 1
            Set recOldLI = lstTmp.ItemByIndex(i)
            lstBDS.AppendItem recOldLI.GetField(gcstCOMVarObjid)
        Next i

        strNewOssIdDem = App.GenerateId("EAI ID")

        '**************************
        For i = 0 To lstBDS.Count - 1

            br.Clear
            br.SimpleQuery 0, gcstCOMVarContrItm
            br.AppendFilter 0, gcstCOMVarObjid, cbEqual, lstBDS.ItemByIndex(i)
            br.TraverseFromParent 1, "contr_itm2mod_level", 0
            br.TraverseFromParent 2, "part_info2part_num", 1
            br.RetrieveRecords

            Set lstTmp = br.GetRecordList(1)

            Set recPartnum = lstTmp.ItemByIndex(0)

            modLevelObjid  = recPartnum.GetField(gcstCOMVarObjid)

            Set lstTmp = br.GetRecordList(2)

            Set recPartnum = lstTmp.ItemByIndex(0)

            Set lstTmp = br.GetRecordList(0)
            Set recOldLI  = lstTmp.ItemByIndex(0)

            isBd1 = (recOldLI.GetField("line_no") = 0)

            recOldLI.SetField "x_av_chgmt_cu_cf" , 0
            recOldLI.SetField "x_av_version"     , recContrat.GetField("x_av_current_version")

            If isBd1 Then
                recOldLI.SetField "x_av_statut_act"   , gcstCOMArticleActeAres
                recOldLI.SetField "x_av_etat_act"     , "En cours"
                recOldLI.SetField "x_av_code_etat"    , "Attente export"
                recOldLI.SetField "x_av_date_prev_fs" , recSuivi.getField("x_av_date_effet")
                recOldLI.SetField "x_av_oss_id_dem"   , strNewOssIdDem
            Else
                If  Len(recPartnum.GetField("x_av_activ_code")) > 0 And _
                   (recPartnum.GetField("x_av_install_type") = "I" Or _
                    recPartnum.GetField("x_av_install_type") = "IF") Then

                    recOldLI.SetField "x_av_statut_act"   , gcstCOMArticleActeAres
                    recOldLI.SetField "x_av_etat_act"     , "En cours"
                    recOldLI.SetField "x_av_code_etat"    , "Attente export"
                    recOldLI.SetField "x_av_date_prev_fs" , recSuivi.getField("x_av_date_effet")
                    recOldLI.SetField "x_av_oss_id_dem"   , strNewOssIdDem

                ElseIf  recPartnum.GetField("x_av_install_type") = "F" Then
                    recOldLI.SetField "x_av_statut_act"   , "Résilié"
                    recOldLI.SetField "x_av_etat_act"     , "N/A"
                    recOldLI.SetField "x_av_code_etat"    , "N/A"
                    recOldLI.SetField "x_av_date_prev_fs" , recSuivi.getField("x_av_date_effet")
                    recOldLI.SetField "end_date"          , recSuivi.getField("x_av_date_effet")

                Else
                    recOldLI.SetField "x_av_statut_act"   , "Résilié"
                    recOldLI.SetField "x_av_etat_act"     , "Réalisé"
                    recOldLI.SetField "x_av_code_etat"    , "Traité"
                    recOldLI.SetField "x_av_date_prev_fs" , recSuivi.getField("x_av_date_effet")
                    recOldLI.SetField "end_date"          , recSuivi.getField("x_av_date_effet")
                End If

                If  recPartnum.GetField("x_av_install_type") = "F" Or _
                    recPartnum.GetField("x_av_install_type") = "IF" Then

                    recOldLI.SetField "x_av_status_c2a"  , gcstCOMArticleActeAres
' MAT JIRA 2505 : Date effet résiliation = Date effet + 1 >
'                    recOldLI.SetField gcstCOMVarCHGENDDT , recSuivi.getField("x_av_date_effet")
                    recOldLI.SetField gcstCOMVarCHGENDDT , strDateEffet
' MAT JIRA 2505 : Date effet résiliation = Date effet + 1 <
                End If
            End If

            If isBd1 Then
                Set lstMotifTransfert3  = New List

                br.clear
                br.SimpleQuery  0, "x_av_code"
                br.AppendFilter 0, "x_av_type", cbEqual, "MOTIF_PRICE"
                br.AppendFilter 0, "x_av_code", cbEqual, recSuivi.GetField("x_av_action")
                br.RetrieveRecords
                Set lstMotifTransfert3 = br.GetRecordList(0)

                If lstMotifTransfert3.count = 0 Then
                    TRUELOG WriteLog(SUBCHMTCF,"70090130","Le paramétrage : MOTIF_PRICE de la BDS source n'existe pas dans la table x_av_code 3", "")
                End If

                If lstMotifTransfert3.count <> 0 Then
                    Set recMotif2 = lstMotifTransfert3.ItemByIndex(0)

                    recOldLI.SetField "x_av_motif_resil", recMotif2.GetField("x_av_libelle")
                End If
            End If

            ' Rattacher l'accès source au mouvement de code acte DMGT ou UPGR lié à l'accès cible
            If isBd1 Then
                br.clear
                br.SimpleQuery 0, gcstCOMVarContrItm
                br.AppendFilter 0, gcstCOMVarObjid, cbEqual, recSuivi.GetField("x_av_acces_cible")
                br.TraverseFromParent 1, "x_av_contr_itm2avenant", 0
                br.RetrieveRecords
                Set lstTmp = br.GetRecordList(1)
                Set recTmp = lstTmp.ItemByIndex(0)

                recOldLI.SetField "x_av_num_mvt" , recTmp.GetField("x_av_id")
                recOldLI.SetField "x_av_version" , recTmp.GetField("x_av_contract_version")
                bs.RelateRecords recOldLI, recTmp, "x_av_contr_itm2avenant"
            End If

            bs.UpdateRecord recOldLI
            bs.Save
        Next i
        'Fin résiliation
        'IAD Notification EAI pour Accès
        sqlStmt = " select 1"&_
                  " from"&_
                  " table_contr_itm itm "&_
                  " where itm.objid = " & recBDSSource.GetField(gcstCOMVarObjid) &_
                  " and itm.child2contr_itm is null "

        listBDS3.ItemType = gcstCOMVarLONG
        sDB.Select sqlStmt, listBDS3
        If listBDS3.Count  > 0 then

            lstParameters.ItemType = gstrCOMVarVARIANT
            lstParameters.clear
            lstParameters.AppendItem recBDSSource.GetField(gcstCOMVarObjid)
            lstParameters.AppendItem strNewOssIdDem
            lstParameters.AppendItem gcstCOMVarVide
            lstParameters.AppendItem "DeplAccesPBE"
            lstParameters.AppendItem recBDSSource.GetField("create_date")
            lstParameters.AppendItem recBDSSource.GetField("last_mod_dt")
            lstParameters.AppendItem recSuivi.GetField("x_av_date_effet")

            '****Insertion (notification) de PropagTransfertAdmin dans la table_x_eai_events****
            sDB.executeProc "sa.PROC_X_AV_EAI_INSERT_EVT_II", lstParameters, typResponse

            If typResponse.v_num <> 0 Then
                ErrMessage = "Erreur dans la procedure d'insertion EAI"
                Call EnErreur(lobjidSuivi, ErrMessage)
                lngErrCount = lngErrCount + 1
                GoTo Cleanup1
            End If
        End If
        '****************************

    ElseIf recSuivi.GetField("X_AV_LIB_ETAT") = gcstCOMVarVide Then
        'IAD Récupérer Master_id de l accès cible du transfert

        br.clear
        br.SimpleQuery 0, gcstCOMVarContrItm
        br.AppendFilter 0, gcstCOMVarObjid, cbEqual, recSuivi.GetField("x_av_acces_cible")
        br.RetrieveRecords
        Set lstTmp = br.GetRecordList(0)
        Set recAccesCible = lstTmp.ItemByIndex(0)

        'Poster la notification "PropagTransfertAdmin" vers l'EAI
        sqlStmt = " select 1"&_
                  " from"&_
                  " table_contr_itm itm "&_
                  " where itm.objid = " & recBDSSource.GetField(gcstCOMVarObjid) &_
                  " and itm.child2contr_itm is null "

        listBDS3.ItemType = gcstCOMVarLONG
        sDB.Select sqlStmt, listBDS3
        If listBDS3.Count  > 0 then

            lstParameters.ItemType = gstrCOMVarVARIANT
            lstParameters.clear
            lstParameters.AppendItem recBDSSource.GetField(gcstCOMVarObjid)
            lstParameters.AppendItem recAccesCible.GetField("x_av_id_eds")
            if recBDSSource.GetField("x_av_categorie") <> strAcces Then
               lstParameters.AppendItem "transfert partiel"
            Else
               lstParameters.AppendItem "transfert total"
            End IF
            lstParameters.AppendItem "PropagTransfertAdmin"
            lstParameters.AppendItem recBDSSource.GetField("create_date")
            lstParameters.AppendItem recBDSSource.GetField("last_mod_dt")
            lstParameters.AppendItem gcstCOMVarVide

            '****Insertion (notification) de PropagTransfertAdmin dans la table_x_eai_events****
            sDB.executeProc "sa.PROC_X_AV_EAI_INSERT_EVT_II", lstParameters, typResponse

            If typResponse.v_num <> 0 Then
                ErrMessage = "Erreur " & typResponse.v_num
                Call EnErreur(lobjidSuivi, ErrMessage)
                lngErrCount = lngErrCount + 1
                GoTo Cleanup1
            End If
        End If
    End If

    '*************

    recSuivi.SetField gcstCOMVarSTATUSAV, cstSuiviOK
    bs.UpdateRecord recSuivi
    bs.Save

    intSucces = intSucces + 1
    bolSuivi  = True

Cleanup1:
    Set br              = Nothing
    Set bs              = Nothing
    Set toDB            = Nothing
    Set lstParameters   = Nothing
    Set lstSuivi        = Nothing
    Set lstBDS          = Nothing
    Set lstAttribut     = Nothing
    Set lstTmp          = Nothing
    Set recTmp          = Nothing
    Set recSuivi        = Nothing
    Set recContrat      = Nothing
    Set recLotCible     = Nothing
    Set recCFCible      = Nothing
    Set recCUCible      = Nothing
    Set recLotSource    = Nothing
    Set recCFSource     = Nothing
    Set recCUSource     = Nothing
    Set recOldLI        = Nothing
    Set recNewLI        = Nothing
    Set recPartnum      = Nothing
    Set recNewAttribute = Nothing
    Set recNewAjustement = Nothing
    Set recBDS          = Nothing



    strSQLStatement = ebnullstring

Exit Sub
Error_Handling:
    TRUELOG WriteLog(SUBCHMTADMIN,"40090004", "[SUIVI : " + cstr(recSuivi.GetField(gcstCOMVarObjid)) + "] " + Warn , " Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description)
    lngWarnCount = lngWarnCount + 1
    Resume Next
End Sub


'**** MOVE5 V1 IAD : Recuperer les lignes de l'accŠs
Function GetBdsLigneToAcces(objidAcces As Long) As List
On Error GoTo Error_Handling

    Dim br                  As New BulkRetrieve
    Dim lstBDSLigne         As New List
    Dim lstTmp              As New List
    Dim recBds              As New Record
    Dim i                   As Integer
    Dim objidBDSLigne       As Long

    br.Clear
    br.SimpleQuery 0, gcstCOMVarContrItm
    br.AppendFilter 0, gcstCOMVarObjid, cbEqual, objidAcces
    br.TraverseFromParent 1, "x_av_acces2itm", 0
    br.RetrieveRecords

    Set lstTmp = br.GetRecordlist(1)
    lstBDSLigne.ItemType = "Long"
    If lstTmp.count > 0 Then
        For i = 0 To lstTmp.count - 1
            Set recBds = lstTmp.ItemByIndex(i)
            objidBDSLigne = recBds.GetField(gcstCOMVarObjid)
            lstBDSLigne.AppendItem objidBDSLigne
        Next i
    End If
    Set GetBdsLigneToAcces = lstBDSLigne
    Set br           = Nothing
    Exit Function
Error_Handling:
    ErrLogMsgBox cstCVSID, Err.number, Err.Source, Err.description, Erl
End Function
'**** MOVE5 V1 IAD : FIN


'IAD Move5.1 : Traiter selon la Catégorie
' Cas d'un accès : créer des demandes pour les lignes qui y sont rattachées
Sub ChmtCFAccesFull(lobjidSuivi As Long, ObjidAccesSource As Long)
On Error GoTo Error_Handling
    Dim br              As New BulkRetrieve
    Dim bs              As New BulkSave
    Dim toDB            As New SQLDB
    Dim lstLigne        As New List
    Dim lstTmp          As New List
    Dim lstTmp2         As New List
    Dim recTmp          As New Record
    Dim recNewSuivi     As New Record
    Dim recSuivi        As New Record
    Dim lstSuivi        As New List
    Dim strSqlStatement As String
    Dim i               As Integer
    Dim objidLigne      As long
    Dim objidLotCible   As Long
    Dim ObjidAccesCible As Long

    lstTmp2.ItemType = gcstCOMVarSTRING

    br.Clear
    br.SimpleQuery  0, gcstCOMVarContrItm
    br.AppendFilter 0, gcstCOMVarObjid, cbEqual, ObjidAccesSource
    br.TraverseFromParent 1, "x_av_acces2itm", 0
    br.TraverseFromParent 3, "x_av_previous2new", 0
    br.SimpleQuery  2, SUIVICHMTCF
    br.AppendFilter 2, gcstCOMVarObjid, cbEqual, lobjidSuivi
    br.RetrieveRecords

    Set lstTmp      = br.GetRecordlist(3)
    Set recTmp      = lstTmp.ItemByIndex(0)
    ObjidAccesCible = recTmp.GetField(gcstCOMVarObjid)

    Set lstLigne    = br.GetRecordlist(1)
    Set lstSuivi    = br.GetRecordList(2)
    Set recSuivi    = lstSuivi.ItemByIndex(0)

    If lstLigne.Count > 0 Then
        TRUELOG WriteLog(SUBMAINCHMTCF,"15090109",Info, " Des lignes associée à l'accès sont trouvées ")
        For i = 0 To lstLigne.Count - 1
            Set recTmp = lstLigne.ItemByIndex(i)
            objidLigne = recTmp.GetField(gcstCOMVarObjid)

            ' Verifier si la ligne est suspendue pour "Impayé"
            If recTmp.GetField("x_av_sous_categorie") = "DECT" And recTmp.GetField("x_av_statut_act") = "Suspendu"  Then

                strSqlStatement = " SELECT ci.objid" & _
                                  " FROM table_contr_itm ci," & _
                                  "      table_mod_level ml," & _
                                  "      table_part_num pn," & _
                                  "      table_n_properties np," & _
                                  "      table_n_attributevalue av," & _
                                  "      table_x_av_code avc" & _
                                  " WHERE ci.child2contr_itm  = " & recTmp.GetField(gcstCOMVarObjid) & _
                                  " AND ci.contr_itm2mod_level = ml.objid" & _
                                  " AND ml.part_info2part_num = pn.objid" & _
                                  " AND av.n_focuslowid = ci.objid" & _
                                  " AND np.objid= av.x_av_value2n_properties" & _
                                  " AND pn.x_av_cross_ref  = 'SUSPENSION_LIGNE'" & _
                                  " AND np.x_av_cross_ref  = 'MOTIF_SUSPENSION'" & _
                                  " AND avc.x_av_type      = 'MOTIF_SUSP_NON_ELIGIBLE_TRANSFERT' " & _
                                  " AND av.n_stringvalue   = avc.x_av_code "

                toDB.Select strSqlStatement, lstTmp2
                If lstTmp2.Count > 0  Then
                    TRUELOG WriteLog(SUBMAINCHMTCF,"15090109",Info, "La ligne [" & recTmp.GetField("x_av_id_eds") & "] suspendue est non éligible au transfert administratif")
            GoTo Next_Line
                End If
            End If

            ' Verifier si la ligne a un ADG Offre en cours (à échéance)
            strSqlStatement = " SELECT cmde.x_pr_id_commande" & _
                              " FROM  table_x_pr_ligne_commande ligne," & _
                              "       table_x_pr_commande cmde" & _
                              " WHERE ligne.x_pr_id_ligne = '" & recTmp.GetField("x_av_id_eds") & "'" & _
                              " AND   cmde.objid=ligne.x_pr_ligne2commande"&_
                              " AND   ligne.x_pr_status in ('TO','TEC','AO','AEC','TOK') " &_
                              " AND   cmde.x_pr_adg IN (select x_av_code from table_x_av_code " &_
                              " where x_av_type = 'ADG_NON_CUMULABLE_ADMIN') "&_
                              " AND   cmde.x_pr_date_effet > SYSDATE"
            toDB.Select strSqlStatement, lstTmp2
            If lstTmp2.Count > 0  Then
                TRUELOG WriteLog(SUBMAINCHMTCF,"15090109",Info, "Il existe un ADG PRICE en cours sur la ligne [" & recTmp.GetField("x_av_id_eds") & "] Il est impossible de réaliser cet acte de gestion")
        GoTo Next_Line
            End If

            ' Vérifier qu'il n'y a pas de demandes sur la Ligne (cas de retraitement d'une demande en erreur sur l'accès)
            br.Clear
            br.SimpleQuery 0, SUIVICHMTCF
            br.AppendFilter 0, "x_av_focus_id", cbEqual, objidLigne
            br.AppendFilter 0, gcstCOMVarSTATUSAV, cbNotEqual, cstSuiviOK
            br.AppendFilter 0, gcstCOMVarSTATUSAV, cbNotEqual, "Annulé"
            br.RetrieveRecords
            Set lstTmp = br.GetRecordList(0)
            If lstTmp.Count = 0 Then
                Set recNewSuivi = recSuivi.Copy(cbChangeToNew)
                recNewSuivi.SetField "x_av_focus_id", objidLigne
                recNewSuivi.SetField "x_av_acces_cible", ObjidAccesCible
                bs.InsertRecord recNewSuivi
                bs.Save

                TRUELOG WriteLog(SUBMAINCHMTCF,"15090109",Info, "Ajout et traitement demande pour la ligne  : " & recNewSuivi.GetField(gcstCOMVarObjid))
                Call ChmtCFPrice(recNewSuivi.GetField(gcstCOMVarObjid))
            End If
        Next_Line:
        Next i
    Else
        TRUELOG WriteLog(SUBMAINCHMTCF,"15090109",Info, "Aucune ligne associée à l'accès")
    End If

    'Fin IAD

    Set br              = Nothing
    Set bs              = Nothing
    Set toDB            = Nothing
    Set lstLigne        = Nothing
    Set lstTmp          = Nothing
    Set recTmp          = Nothing
    Set recNewSuivi     = Nothing
    Set recSuivi        = Nothing
    Set lstSuivi        = Nothing
    strSQLStatement     = ebNullString

    Exit Sub
Error_Handling:
    TRUELOG WriteLog(SUBCHMTCFPRICE, "40090005"," [SUIVI : " + cstr(lobjidSuivi) + "] " + Warn , " Erreur n° " & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description)
    lngWarnCount = lngWarnCount + 1
End Sub

Function InitParamXAvCode() As Boolean
On Error GoTo Error_Handling
    'IAD Récupération des catégories à partir du param
    Dim br             As New BulkRetrieve
    Dim lstTmp         As New list
    Dim lstTyp         As New List
    Dim recTmp         As New Record
    Dim Indx           As Long

    InitParamXAvCode = False
    lstTyp.ItemType  = gcstCOMVarSTRING
    lstTyp.AppendItem "CAT_BDS1_PBE", "CAT_BDS1_MOVE"

    br.Clear
    br.SimpleQuery 0, gcstCOMVarAVCODE
    br.AppendFilter 0, gcstCOMVarAVTYPE, CbIn, lstTyp
    br.RetrieveRecords

    Set lstTmp = br.GetRecordlist(0)

    Indx          = lstTmp.FindFirstIndex("CAT_BDS1_PBE", gcstCOMVarAVTYPE, "LIGNE_PBE", gcstCOMVarAVCODE)
    If Indx < 0 Then
        TRUELOG WriteLog(SUBMAINCHMTCF,"15090109",Fatal, "Paramétrage CAT_BDS1_PBE|LIGNE_PBE Manquant.")
        Goto CleanUp
    End If
    Set recTmp    = lstTmp.ItemByIndex(Indx)
    strFixe       = recTmp.GetField(gcstCOMVarAVCODE2)

    Indx          = lstTmp.FindFirstIndex("CAT_BDS1_PBE", gcstCOMVarAVTYPE, "ACCES", gcstCOMVarAVCODE)
    If Indx < 0 Then
        TRUELOG WriteLog(SUBMAINCHMTCF,"15090109",Fatal, "Paramétrage CAT_BDS1_PBE|ACCES Manquant.")
        Goto CleanUp
    End If
    Set recTmp    = lstTmp.ItemByIndex(Indx)
    strAcces      = recTmp.GetField(gcstCOMVarAVCODE2)

    Indx          = lstTmp.FindFirstIndex("CAT_BDS1_MOVE", gcstCOMVarAVTYPE, "LIGNE_MOBILE", gcstCOMVarAVCODE)
    If Indx < 0 Then
        TRUELOG WriteLog(SUBMAINCHMTCF,"15090109",Fatal, "Paramétrage CAT_BDS1_MOVE|LIGNE_MOBILE Manquant.")
        Goto CleanUp
    End If
    Set recTmp    = lstTmp.ItemByIndex(Indx)
    strMobile     = recTmp.GetField(gcstCOMVarAVCODE2)

    InitParamXAvCode = True
    'Fin IAD

CleanUp:
    Set br        = Nothing
    Set lstTmp    = Nothing
    Set lstTyp    = Nothing
    Set recTmp    = Nothing

Exit Function
Error_Handling:
   TRUELOG "Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & " Description: " & Err.description
   lngErrCount = lngErrCount + 1
End Function

'Move5.1 : Traiter selon la Catégorie
' Cas d'un accès : créer des demandes pour les lignes qui y sont rattachées
Sub ChmtAdminAccesFull(lobjidSuivi As Long)
On Error GoTo Error_Handling
    Dim br              As New BulkRetrieve
    Dim bs              As New BulkSave
    Dim toDB            As New SQLDB
    Dim lstLigne        As List
    Dim lstTmp          As List
    Dim lstTmp2         As New List
    Dim recTmp          As Record
    Dim recSuivi        As Record
    Dim recBDSSource    As Record
    Dim recLotCible     As Record
    Dim recNewSuivi     As Record
    Dim strSqlStatement As String
    Dim objidLigne      As Long
    Dim k               As Integer
    Dim objidLotCible   As Long

    lstTmp2.ItemType = gcstCOMVarSTRING

    br.Clear
    br.SimpleQuery  0, SUIVICHMTCF
    br.AppendFilter 0, gcstCOMVarObjid, cbEqual, lobjidSuivi
    br.RetrieveRecords
    Set lstTmp      = br.GetRecordList(0)
    Set recSuivi    = lstTmp.ItemByIndex(0)

    br.Clear
    br.SimpleQuery  0, gcstCOMVarContrItm
    br.AppendFilter 0, gcstCOMVarObjid, cbEqual, recSuivi.GetField("x_av_focus_id")
    br.TraverseFromParent 1, "x_av_acces2itm", 0
    br.SimpleQuery  2, gcstCOMVarContrSchedule
    br.AppendFilter 2, gcstCOMVarObjid, cbEqual, recSuivi.GetField ("x_av_id_contr_schedule_cible")
    br.RetrieveRecords

    Set lstTmp = br.GetRecordList(2)
    Set recLotCible = lstTmp.ItemByIndex(0)
    objidLotCible   = recLotCible.GetField(gcstCOMVarObjid)

    Set lstLigne    = br.GetRecordlist(1)
    Set lstTmp = br.GetRecordList(0)
    Set recBDSSource = lstTmp.ItemByIndex(0)

    recBDSSource.SetField "x_av_chgmt_cu_cf", 0
    bs.UpdateRecord recBDSSource
    bs.save

    For k  = 0 To lstLigne.Count - 1
        Set recTmp = lstLigne.ItemByIndex(k)
        objidLigne = recTmp.GetField(gcstCOMVarObjid)

        ' Verifier si la ligne est suspendue pour "Impayé"
        If recTmp.GetField("x_av_sous_categorie") = "DECT" And recTmp.GetField("x_av_statut_act") = "Suspendu"  Then

            strSqlStatement = " SELECT ci.objid" & _
                              " FROM table_contr_itm ci," & _
                              "      table_mod_level ml," & _
                              "      table_part_num pn," & _
                              "      table_n_properties np," & _
                              "      table_n_attributevalue av," & _
                              "      table_x_av_code avc" & _
                              " WHERE ci.child2contr_itm  = " & recTmp.GetField(gcstCOMVarObjid) & _
                              " AND ci.contr_itm2mod_level = ml.objid" & _
                              " AND ml.part_info2part_num = pn.objid" & _
                              " AND av.n_focuslowid = ci.objid" & _
                              " AND np.objid= av.x_av_value2n_properties" & _
                              " AND pn.x_av_cross_ref  = 'SUSPENSION_LIGNE'" & _
                              " AND np.x_av_cross_ref  = 'MOTIF_SUSPENSION'" & _
                              " AND avc.x_av_type      = 'MOTIF_SUSP_NON_ELIGIBLE_TRANSFERT' " & _
                              " AND av.n_stringvalue   = avc.x_av_code "

            toDB.Select strSqlStatement, lstTmp2
            If lstTmp2.Count > 0  Then
                TRUELOG WriteLog(SUBMAINCHMTCF,"15090109",Info, "La ligne [" & recTmp.GetField("x_av_id_eds") & "] suspendue est non éligible au transfert administratif")
        GoTo Next_Line
            End If
        End If

        ' Verifier si la ligne a un ADG Offre en cours (à échéance)
        strSqlStatement = " SELECT cmde.x_pr_id_commande" & _
                          " FROM  table_x_pr_ligne_commande ligne," & _
                          "       table_x_pr_commande cmde" & _
                          " WHERE ligne.x_pr_id_ligne = '" & recTmp.GetField("x_av_id_eds") & "'" & _
                          " AND   cmde.objid=ligne.x_pr_ligne2commande"&_
                          " AND   ligne.x_pr_status in ('TO','TEC','AO','AEC','TOK') " &_
                          " AND   cmde.x_pr_adg IN (select x_av_code from table_x_av_code " &_
                          " where x_av_type = 'ADG_NON_CUMULABLE_ADMIN') "&_
                          " AND   cmde.x_pr_date_effet > SYSDATE"
        toDB.Select strSqlStatement, lstTmp2
        If lstTmp2.Count > 0  Then
            TRUELOG WriteLog(SUBMAINCHMTCF,"15090109",Info, "Il existe un ADG PRICE en cours sur la ligne [" & recTmp.GetField("x_av_id_eds") & "] Il est impossible de réaliser cet acte de gestion")
        GoTo Next_Line
        End If

        ' Vérifier qu'il n'y a pas de demandes sur la Ligne  (cas de retraitement d'une demande en erreur sur l'accès)
        br.Clear
        br.SimpleQuery 0, SUIVICHMTCF
        br.AppendFilter 0, "x_av_focus_id", cbEqual, objidLigne
        br.AppendFilter 0, "x_av_id_contr_schedule_cible", cbEqual, objidLotCible
        br.AppendFilter 0, gcstCOMVarSTATUSAV, cbNotEqual, cstSuiviOK
        br.AppendFilter 0, gcstCOMVarSTATUSAV, cbNotEqual, "Annulé"
        br.RetrieveRecords
        Set lstTmp= br.GetRecordList(0)
        If lstTmp.Count = 0 Then
            Set recNewSuivi = recSuivi.Copy(cbChangeToNew)
            recNewSuivi.SetField "x_av_focus_id", objidLigne
            recNewSuivi.SetField "x_av_id_contr_schedule_cible", objidLotCible
            recNewSuivi.SetField "x_av_lib_etat", "BATCH"
            bs.InsertRecord recNewSuivi
            bs.Save

            TRUELOG WriteLog(SUBMAINCHMTCF,"15090109",Info, "Ajout et traitement demande pour ligne  : " & recNewSuivi.GetField(gcstCOMVarObjid))
            Call ChmtAdminMove(recNewSuivi.GetField(gcstCOMVarObjid))
        End If
    Next_Line:
    Next k

    Set br              = Nothing
    Set bs              = Nothing
    Set toDB            = Nothing
    Set lstLigne        = Nothing
    Set lstTmp          = Nothing
    Set lstTmp2         = Nothing
    Set recTmp          = Nothing
    Set recSuivi        = Nothing
    Set recBDSSource    = Nothing
    Set recLotCible     = Nothing
    Set recNewSuivi     = Nothing
    strSQLStatement     = ebNullString

    Exit Sub
Error_Handling:
    TRUELOG WriteLog(SUBCHMTCFPRICE, "40090006", "[SUIVI : " + cstr(lobjidSuivi) + "] " + Warn , " Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description)
    lngWarnCount = lngWarnCount + 1
End Sub

'Procédure pour création d'un nouveau IDS
Function createNewIDS() as String
On Error GoTo Error_Handling
	Dim strSqlStatement As String
	Dim toDB            As New SQLDB
	Dim newIdIDS		As String
	
	createNewIDS = ""
    strSqlStatement = "select FUNC_GET_ID_IDS from dual"
    toDB.Select strSqlStatement, newIdIDS
	
	createNewIDS = newIdIDS
	Exit Function
Error_Handling:
    debug.print "Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description
End Function


'Procédure pour récuperer l'objid de la bds1
Function get_objid_BDS1(objidBds as String) as String
On Error GoTo Error_Handling
	Dim strSqlStatement As String
	Dim toDB            As New SQLDB
	Dim objidBds1		As String
	
	get_objid_BDS1 = ""
    strSqlStatement = "select child2contr_itm from table_contr_itm where objid =" & objidBds
    toDB.Select strSqlStatement, objidBds1
	
	get_objid_BDS1 = objidBds1
	Exit Function
Error_Handling:
    debug.print "Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description
End Function

'Procédure pour récupérer l'id ids de la bds1
Function getId_IDS_BDS1(objidBds1 as String) as String
On Error GoTo Error_Handling
	Dim strSqlStatement As String
	Dim toDB            As New SQLDB
	Dim idIds_BDS1		As String
	
	getId_IDS_BDS1 = ""
    strSqlStatement = "select x_av_id_ids from table_contr_itm where objid =" & objidBds1
    toDB.Select strSqlStatement, idIds_BDS1
	
	getId_IDS_BDS1 = idIds_BDS1
	Exit Function
Error_Handling:
    debug.print "Erreur n°" & Err.number & ", Ligne="& erl & " Source=" & Err.Source & "Description: " & Err.description
End Function
